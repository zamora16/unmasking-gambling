---
import RelatedQuestions from '../components/RelatedQuestions.astro';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Figure from '../components/Figure.astro';
import Stat from '../components/Stat.astro';
import TechBox from '../components/TechBox.astro';
import OddsCalculator from '../islands/odds/OddsCalculator';
import { MarginTrend, LeagueMargins, CalibrationFig, FavouriteLongshot, Strategies, MlSkill, MlImportance, MlCalibration, MlBetting } from '../islands/odds/OddsCharts';
import { type Lang, fmt, href } from '../i18n';
import summary from '../data/odds/summary.json';
import flb from '../data/odds/favourite-longshot.json';
import strategies from '../data/odds/strategies.json';
import model from '../data/odds/elo-vs-market.json';
import methods from '../data/odds/methods.json';
import bySeason from '../data/odds/margins-by-season.json';
import ml from '../data/odds/ml.json';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const es = lang === 'es';
const f = fmt(lang);
const S = Object.fromEntries(strategies.map((s) => [s.key, s]));
const refFlb = flb.filter((d) => d.book === 'reference');
const shortest = refFlb[1];
const longest = refFlb[refFlb.length - 1];
const long10 = refFlb.find((d) => d.from === 10)!;
const first = bySeason[0];
const mid = bySeason.find((d) => d.season === 2019)!;
const shin = methods.find((m) => m.method === 'shin')!;
const base = methods.find((m) => m.method === 'baseRates')!;
const prop = methods.find((m) => m.method === 'proportional')!;
const seasonLabel = (s: number) => `${s}/${String(s + 1).slice(2)}`;
const years = `${summary.firstDate.slice(0, 4)}–${summary.lastDate.slice(0, 4)}`;
type Score = { model: string; logLoss: number; share?: number; shareLo?: number; shareHi?: number; vsMarket?: number; vsMarketLo?: number; vsMarketHi?: number };
const M = Object.fromEntries((ml.scores as Score[]).map((s) => [s.model, s])) as Record<string, Score>;
const bet = (model: string, thr: number, book = 'reference') => ml.betting.find((b) => b.model === model && b.threshold === thr && b.book === book)!;
const gbmBets = ml.betting.filter((b) => b.model === 'gbm' && b.book === 'reference');
const gbmWorst = Math.min(...gbmBets.map((b) => b.roi!));
const gbmBest = Math.max(...gbmBets.map((b) => b.roi!));
const mktBets = ml.betting.filter((b) => b.model === 'gbm_market' && b.book === 'reference');
const mktSignificant = mktBets.filter((b) => b.lo! > 0 || b.hi! < 0);
const nConfigs = ml.betting.length;
const tuneG = ml.tuning.gbm;
const tuneM = ml.tuning.gbm_market;
---

<Base
  lang={lang}
  page="odds"
  title={es ? '¿Dicen la verdad las cuotas?' : 'Do the odds tell the truth?'}
  description={es
    ? `Analizamos ${f.int(summary.matches)} partidos de fútbol con cuotas reales: cuánto cobra la casa, dónde se equivoca y por qué ninguna estrategia sencilla gana.`
    : `We analysed ${f.int(summary.matches)} football matches with real odds: how much the bookmaker charges, where it is wrong and why no simple strategy wins.`}
>
  <PageHead
    lang={lang}
    kicker={es ? 'Análisis con datos reales' : 'Real-data analysis'}
    title={es ? '¿Dicen la verdad las cuotas?' : 'Do the odds tell the truth?'}
    lede={es
      ? `Una cuota te dice cuánto te pagan si aciertas. Pero esconde también cuánto se queda la casa. Hemos revisado ${f.int(summary.matches)} partidos de fútbol reales, de ${years}, para ver si las cuotas son justas y si alguna forma de apostar sale a cuenta.`
      : `Odds tell you how much you get paid if you win. But they also hide how much the bookmaker keeps. We went through ${f.int(summary.matches)} real football matches, from ${years}, to see whether odds are fair and whether any way of betting pays off.`}
  />

  <div class="page">
    <div class="wide stats">
      <Stat value={f.int(summary.matches)} label={es ? 'partidos reales analizados, con sus cuotas y su resultado' : 'real matches analysed, with their odds and result'} />
      <Stat value={f.eur(summary.medianMargin * 100 / (1 + summary.medianMargin), 2)} label={es ? 'se queda la casa de cada 100 € apostados en un partido típico' : 'kept by the bookmaker from every €100 bet on a typical match'} />
      <Stat value={f.signedPct(longest.roi, 0)} label={es ? `pierde de media quien apuesta a las grandes sorpresas (cuotas de ${f.num(longest.from, 0)} a ${f.num(longest.to!, 0)})` : `average loss backing big upsets (odds of ${f.num(longest.from, 0)} to ${f.num(longest.to!, 0)})`} />
      <Stat value={`0 / ${strategies.length}`} label={es ? 'formas sencillas de apostar que ganaron dinero en diez años' : 'simple ways of betting that made money over ten years'} />
    </div>

    <nav class="measure toc" aria-label={es ? 'En esta página' : 'On this page'}>
      <ol>
        <li><a href="#price">{es ? 'La comisión' : 'The fee'}</a></li>
        <li><a href="#calibration">{es ? '¿Aciertan?' : 'Are they right?'}</a></li>
        <li><a href="#longshots">{es ? 'Las sorpresas' : 'Long shots'}</a></li>
        <li><a href="#strategies">{es ? 'Ocho estrategias' : 'Eight strategies'}</a></li>
        <li><a href="#model">{es ? 'Un modelo' : 'A model'}</a></li>
        <li><a href="#ml">Machine learning</a></li>
        <li><a href="#caveats">{es ? 'Límites' : 'Caveats'}</a></li>
      </ol>
    </nav>

    <article class="measure prose">
      <h2 id="price">{es ? 'La comisión escondida en la cuota' : 'The fee hidden in the odds'}</h2>
      {
        es ? (
          <>
            <p>
              Imagina que apuestas a cara o cruz con una moneda normal. Lo justo sería que, si aciertas, te devolvieran el doble: una cuota de 2,00. Una casa de apuestas no te daría 2,00, te daría algo como 1,90, tanto a cara como a cruz. Esa pequeña diferencia es su <strong>comisión</strong>: pase lo que pase, a la larga se queda con una parte de todo lo que se apuesta.
            </p>
            <p>
              En el fútbol pasa lo mismo con los tres resultados posibles (gana el local, empate o gana el visitante). La comisión no aparece por ningún lado, pero se puede calcular a partir de las cuotas. Escribe las de cualquier partido:
            </p>
          </>
        ) : (
          <>
            <p>
              Imagine betting on heads or tails with a normal coin. The fair deal would be to double your money if you win: odds of 2.00. A bookmaker would not offer 2.00, it would offer something like 1.90 on both heads and tails. That small difference is its <strong>fee</strong>: whatever happens, in the long run it keeps part of everything that is bet.
            </p>
            <p>
              Football works the same way with its three possible results (home win, draw, away win). The fee is not shown anywhere, but it can be worked out from the odds. Type in any match:
            </p>
          </>
        )
      }
    </article>

    <div class="measure figure">
      <OddsCalculator client:idle lang={lang} />
    </div>

    <article class="measure prose">
      <TechBox lang={lang} title={es ? 'Probabilidad implícita, margen y cómo quitarlo' : 'Implied probability, overround and how to remove it'}>
        {
          es ? (
            <>
              <p>Una cuota decimal <em>o</em> implica una probabilidad π = 1/o. En un mercado 1X2 las tres suman más de uno; el exceso es el <strong>margen</strong> u <em>overround</em>:</p>
              <span class="formula">margen = 1/o₁ + 1/oₓ + 1/o₂ − 1</span>
              <p>
                Para recuperar probabilidades que sumen uno hay varios métodos. El <strong>proporcional</strong> normaliza π<sub>i</sub>/Σπ. El de <strong>potencia</strong> busca k tal que Σπ<sub>i</sub><sup>k</sup> = 1. El de <strong>Shin (1993)</strong> supone que una fracción z del dinero viene de apostadores con información privilegiada y que la casa se protege acortando las cuotas altas; se resuelve numéricamente para z. Potencia y Shin recortan más las probabilidades pequeñas. En nuestros datos, la z mediana de Shin es {f.pct(summary.shinZMedian, 1)}.
              </p>
              <p>Lo que pierde de media quien apuesta es margen / (1 + margen) de lo apostado.</p>
            </>
          ) : (
            <>
              <p>Decimal odds <em>o</em> imply a probability π = 1/o. In a 1X2 market the three add up to more than one; the excess is the <strong>overround</strong> or margin:</p>
              <span class="formula">overround = 1/o₁ + 1/oₓ + 1/o₂ − 1</span>
              <p>
                There are several ways to recover probabilities that sum to one. <strong>Proportional</strong> normalises π<sub>i</sub>/Σπ. <strong>Power</strong> finds k such that Σπ<sub>i</sub><sup>k</sup> = 1. <strong>Shin (1993)</strong> assumes a fraction z of the money comes from insiders and that the bookmaker protects itself by shortening high odds; it is solved numerically for z. Power and Shin shrink small probabilities more. In our data the median Shin z is {f.pct(summary.shinZMedian, 1)}.
              </p>
              <p>The average loss for a bettor is overround / (1 + overround) of the stake.</p>
            </>
          )
        }
      </TechBox>
    </article>

    <Figure
      title={es ? 'La comisión de la casa se ha reducido a la mitad desde 2000… pero sigue ahí' : 'The bookmaker’s fee has halved since 2000… but it is still there'}
      sub={es
        ? 'Comisión típica en cada temporada, en porcentaje. Naranja: una casa grande. Azul: si pudieras elegir siempre la mejor cuota entre unas 17 casas.'
        : 'Typical fee each season, as a percentage. Orange: one big bookmaker. Blue: if you could always pick the best odds among about 17 bookmakers.'}
      subTech={es
        ? 'Overround mediano por temporada, mercado 1X2, todas las ligas. Casa de referencia (Bet365) frente a la cuota máxima publicada entre ~17 casas.'
        : 'Median overround per season, 1X2 market, all leagues. Reference bookmaker (Bet365) against the maximum published price across ~17 books.'}
      foot={es
        ? `Fuente: Football-Data.co.uk vía <a href="https://github.com/xgabora/Club-Football-Match-Data-2000-2025">xgabora/Club-Football-Match-Data</a>. Cálculo propio. La «mejor cuota» es el máximo publicado por cualquier casa: en la práctica no siempre se puede apostar a ese precio.`
        : `Source: Football-Data.co.uk via <a href="https://github.com/xgabora/Club-Football-Match-Data-2000-2025">xgabora/Club-Football-Match-Data</a>. Our calculation. The “best price” is the highest quote published by any bookmaker: in practice you cannot always bet at that price.`}
    >
      <MarginTrend client:idle lang={lang} />
    </Figure>

    <article class="measure prose">
      {
        es ? (
          <p>
            En el año 2000 la casa se quedaba con cerca del {f.pct(first.margin, 0)}. Con la llegada de las apuestas online y la competencia bajó hasta alrededor del {f.pct(mid.margin, 0)}, y ahí se ha quedado. Pero no cobra igual en todas partes: en las ligas más seguidas, como la Premier League o LaLiga, la comisión es más baja. En las divisiones inferiores y las ligas pequeñas, donde menos gente mira, cobra casi el doble.
          </p>
        ) : (
          <p>
            In 2000 the bookmaker kept about {f.pct(first.margin, 0)}. With online betting and competition it fell to around {f.pct(mid.margin, 0)}, and it has stayed there. But it does not charge the same everywhere: in the most-watched leagues, like the Premier League or LaLiga, the fee is lower. In lower divisions and small leagues, where fewer people are watching, it charges almost twice as much.
          </p>
        )
      }
    </article>

    <Figure
      wide={false}
      title={es ? 'Cuanto menos seguida es una liga, más cobra la casa' : 'The less followed a league is, the more the bookmaker charges'}
      sub={es ? 'Comisión típica por liga desde la temporada 2019/20.' : 'Typical fee by league since the 2019/20 season.'}
      subTech={es ? 'Overround mediano de la casa de referencia por liga, temporadas 2019/20 a 2026/27.' : 'Median overround of the reference bookmaker by league, seasons 2019/20 to 2026/27.'}
      foot={es ? 'Selección de 16 ligas. La tabla incluye todas.' : 'A selection of 16 leagues. The table includes all of them.'}
    >
      <LeagueMargins client:idle lang={lang} />
    </Figure>

    <article class="measure prose">
      <h2 id="calibration">{es ? '¿Aciertan las casas?' : 'Do bookmakers get it right?'}</h2>
      {
        es ? (
          <p>
            Que la casa cobre no quiere decir que se equivoque. Para comprobarlo tomamos todos los resultados a los que las cuotas daban, por ejemplo, un 30 % de posibilidades, y contamos cuántas veces ocurrieron de verdad. Si las cuotas fueran perfectas, habrían ocurrido justo un 30 % de las veces. En el gráfico, eso sería que los puntos caen sobre la línea diagonal.
          </p>
        ) : (
          <p>
            Charging a fee does not mean being wrong. To check, we took every result the odds gave, say, a 30% chance, and counted how often it actually happened. If the odds were perfect, it would have happened exactly 30% of the time. In the chart, that means the points fall on the diagonal line.
          </p>
        )
      }
    </article>

    <Figure
      wide={false}
      title={es ? 'Las cuotas aciertan mucho… salvo con las sorpresas y los grandes favoritos' : 'The odds are very accurate… except for upsets and heavy favourites'}
      sub={es
        ? 'Horizontal: lo que decían las cuotas. Vertical: lo que pasó de verdad. Cada punto agrupa miles de resultados.'
        : 'Horizontal: what the odds said. Vertical: what actually happened. Each point groups thousands of outcomes.'}
      subTech={es
        ? 'Diagrama de fiabilidad: probabilidad implícita (método proporcional) frente a frecuencia observada, 20 intervalos, temporadas 2012/13 a 2026/27. Barras: IC del 95 % de Wilson.'
        : 'Reliability diagram: implied probability (proportional method) against observed frequency, 20 bins, seasons 2012/13 to 2026/27. Bars: 95% Wilson CIs.'}
    >
      <CalibrationFig client:idle lang={lang} />
    </Figure>

    <article class="measure prose">
      {
        es ? (
          <p>
            En la zona central las cuotas aciertan de forma asombrosa. Pero fíjate en los extremos. A la izquierda, los puntos quedan por debajo de la línea: <strong>las sorpresas pasan menos de lo que dicen sus cuotas</strong>. A la derecha, por encima: <strong>los grandes favoritos ganan más de lo que se paga por ellos</strong>. Dicho de otra forma, la casa paga peor precisamente las apuestas más tentadoras, las que prometen mucho dinero por poco. Los economistas lo llaman <em>sesgo favorito–sorpresa</em>, y es de los resultados más repetidos en el estudio de las apuestas.
          </p>
        ) : (
          <p>
            In the middle, the odds are remarkably accurate. But look at the ends. On the left, the points sit below the line: <strong>upsets happen less often than their odds suggest</strong>. On the right, above it: <strong>heavy favourites win more often than they are priced</strong>. In other words, the bookmaker pays worst on exactly the most tempting bets, the ones that promise a lot of money for a little. Economists call it the <em>favourite–longshot bias</em>, and it is one of the most replicated findings in the study of betting.
          </p>
        )
      }
      <TechBox lang={lang} title={es ? 'Calibración e intervalos de confianza' : 'Calibration and confidence intervals'}>
        {
          es ? (
            <p>
              Se agrupan las probabilidades implícitas (sin margen, método proporcional) de los tres resultados de cada partido en 20 intervalos de ancho 5 %, y en cada uno se compara la probabilidad media predicha con la frecuencia observada. Los intervalos de confianza del 95 % usan el método de Wilson, más estable que la aproximación normal con proporciones extremas. Se descartan los intervalos con menos de 200 observaciones.
            </p>
          ) : (
            <p>
              The implied probabilities (margin removed, proportional method) of each match’s three outcomes are grouped into 20 bins 5% wide, and in each bin the mean predicted probability is compared with the observed frequency. The 95% confidence intervals use the Wilson method, which is more stable than the normal approximation for extreme proportions. Bins with fewer than 200 observations are dropped.
            </p>
          )
        }
      </TechBox>

      <h2 id="longshots">{es ? 'Soñar con la sorpresa sale caro' : 'Dreaming of the upset is expensive'}</h2>
      {
        es ? (
          <p>
            Llevado a dinero: si apostaras 1 € a todos los resultados muy probables (cuotas entre {f.num(shortest.from, 2)} y {f.num(shortest.to!, 2)}), perderías de media {f.eur(-shortest.roi, 2)} por euro. Si apostaras a todas las grandes sorpresas (cuotas entre {f.num(long10.from, 0)} y {f.num(long10.to!, 0)}), perderías {f.eur(-long10.roi, 2)} por euro: más de diez veces más.
          </p>
        ) : (
          <p>
            In money terms: bet €1 on every very likely result (odds between {f.num(shortest.from, 2)} and {f.num(shortest.to!, 2)}) and you would lose {f.eur(-shortest.roi, 2)} per euro on average. Bet on every big upset (odds between {f.num(long10.from, 0)} and {f.num(long10.to!, 0)}) and you would lose {f.eur(-long10.roi, 2)} per euro: more than ten times as much.
          </p>
        )
      }
    </article>

    <Figure
      wide={false}
      title={es ? 'Cuanto más alta la cuota, peor el trato' : 'The higher the odds, the worse the deal'}
      sub={es
        ? 'Lo que se gana o se pierde de media por cada euro apostado, según la cuota. Las rayitas negras marcan el margen de error.'
        : 'What you win or lose on average for every euro bet, by odds range. The small black lines show the margin of error.'}
      subTech={es
        ? 'ROI medio de apostar 1 unidad a cada resultado del tramo, temporadas 2012/13 a 2026/27. Intervalos del 95 % por bootstrap (1.000 réplicas).'
        : 'Mean ROI of a 1-unit bet on every outcome in the range, seasons 2012/13 to 2026/27. 95% bootstrap intervals (1,000 resamples).'}
      foot={es
        ? 'Incluso a la mejor cuota del mercado, las sorpresas pierden dinero. Las pequeñas ganancias con favoritos a la mejor cuota desaparecen en la práctica: esas cuotas duran poco y las casas limitan a quien gana.'
        : 'Even at the best price in the market, long shots lose money. The small gains on favourites at the best price vanish in practice: those prices do not last and bookmakers limit winning customers.'}
    >
      <FavouriteLongshot client:idle lang={lang} />
    </Figure>

    <article class="measure prose">
      <h2 id="strategies">{es ? 'Ocho formas de apostar, diez años de partidos' : 'Eight ways to bet, ten years of matches'}</h2>
      {
        es ? (
          <p>
            ¿Y si en vez de apostar con el corazón se sigue una regla fija? Probamos ocho con los {f.int(S.home.bets)} partidos de las últimas diez temporadas, 1 € por partido: apostar siempre al equipo local, al empate, al visitante, al favorito, a la sorpresa, al azar, al favorito buscando la mejor cuota del mercado y lo que recomendaría un modelo estadístico.
          </p>
        ) : (
          <p>
            What if instead of betting with your heart you follow a fixed rule? We tested eight on the {f.int(S.home.bets)} matches of the last ten seasons, €1 per match: always backing the home team, the draw, the away team, the favourite, the underdog, at random, the favourite at the best price in the market, and what a statistical model would recommend.
          </p>
        )
      }
    </article>

    <Figure
      title={es ? 'Ninguna regla sencilla gana: todas acaban pagando la comisión' : 'No simple rule wins: they all end up paying the fee'}
      sub={es
        ? 'Dinero ganado o perdido a medida que se apuesta, en porcentaje de todo lo apostado. En gris, las otras cuatro estrategias (local, empate, visitante y al azar).'
        : 'Money won or lost as the bets go by, as a share of everything staked. In grey, the other four strategies (home, draw, away and random).'}
      subTech={es
        ? 'P&L acumulado normalizado por el número total de apuestas de cada estrategia; el valor final es el ROI. Temporadas 2016/17 a 2026/27, stake unitario.'
        : 'Cumulative P&L normalised by each strategy’s total number of bets; the final value is the ROI. Seasons 2016/17 to 2026/27, unit stakes.'}
      foot={es
        ? `Resultados finales: favorito ${f.signedPct(S.favourite.roi, 1)}, sorpresa ${f.signedPct(S.underdog.roi, 1)}, al azar ${f.signedPct(S.random.roi, 1)}, favorito a la mejor cuota ${f.signedPct(S.favouriteBest.roi, 1)} (intervalo del 95 %: ${f.signedPct(S.favouriteBest.roiLo, 1)} a ${f.signedPct(S.favouriteBest.roiHi, 1)}).`
        : `Final results: favourite ${f.signedPct(S.favourite.roi, 1)}, underdog ${f.signedPct(S.underdog.roi, 1)}, random ${f.signedPct(S.random.roi, 1)}, favourite at the best price ${f.signedPct(S.favouriteBest.roi, 1)} (95% interval: ${f.signedPct(S.favouriteBest.roiLo, 1)} to ${f.signedPct(S.favouriteBest.roiHi, 1)}).`}
    >
      <Strategies client:idle lang={lang} />
    </Figure>

    <article class="measure prose">
      {
        es ? (
          <p>
            Todas pierden, y más o menos lo que cobra la casa en el tipo de apuesta que eligen. Apostar siempre a la sorpresa es lo peor ({f.signedPct(S.underdog.roi, 1)}), justo por lo que acabamos de ver. Apostar al azar pierde un {f.pct(-S.random.roi, 1)}, casi exactamente la comisión. Lo único que se acerca a cero es buscar siempre la mejor cuota entre 17 casas a la vez, algo que casi nadie hace, y ni siquiera así se gana.
          </p>
        ) : (
          <p>
            They all lose, roughly what the bookmaker charges on the kind of bet they pick. Always backing the underdog is the worst ({f.signedPct(S.underdog.roi, 1)}), for the reason we just saw. Betting at random loses {f.pct(-S.random.roi, 1)}, almost exactly the fee. The only thing that gets close to zero is always finding the best odds among 17 bookmakers at once, something almost nobody does, and even then you do not win.
          </p>
        )
      }

      <h2 id="model">{es ? '¿Y si elige un ordenador?' : 'What if a computer picks?'}</h2>
      {
        es ? (
          <p>
            Es la promesa de los «pronosticadores» y de los cursos de apuestas: encontrar los partidos en los que la casa se equivoca. Lo probamos. Creamos un modelo estadístico que estima quién va a ganar según la fuerza de cada equipo, lo entrenamos con partidos antiguos y lo pusimos a apostar en {f.int(model.nTest)} partidos posteriores que no había visto. Solo apostaba cuando creía haber encontrado una buena oportunidad. Resultado: acertó menos que las propias cuotas y perdió un {f.pct(-S.eloValue.roi, 1)} de lo apostado en {f.int(S.eloValue.bets)} apuestas. Cuando un modelo sencillo «ve una oportunidad», casi siempre es porque no sabe algo que la casa sí sabe: una lesión, una alineación, dinero de gente bien informada.
          </p>
        ) : (
          <p>
            It is the promise of tipsters and betting courses: find the matches where the bookmaker is wrong. We tried it. We built a statistical model that estimates who will win from each team’s strength, trained it on old matches and set it betting on {f.int(model.nTest)} later matches it had never seen. It only bet when it thought it had found a good opportunity. Result: it predicted worse than the odds themselves and lost {f.pct(-S.eloValue.roi, 1)} of its stakes over {f.int(S.eloValue.bets)} bets. When a simple model “sees an opportunity”, it is almost always because it does not know something the bookmaker does: an injury, a line-up, money from well-informed bettors.
          </p>
        )
      }
      <TechBox lang={lang} title={es ? 'El modelo: regresión logística ordinal sobre el Elo' : 'The model: ordinal logistic regression on Elo'}>
        {
          es ? (
            <>
              <p>
                Modelo logístico ordinal con la diferencia de rating Elo (local − visitante, en cientos de puntos) como única variable: P(y ≤ j) = σ(c<sub>j</sub> − β·ΔElo), con y ∈ {'{'}local, empate, visitante{'}'}. La ventaja de campo queda recogida en los puntos de corte. Se ajusta por máxima verosimilitud (Nelder–Mead) con las temporadas {model.trainSeasons[0]}–{model.trainSeasons[1]} y se evalúa fuera de muestra desde {model.testSeasons[0]}/{String(model.testSeasons[0] + 1).slice(2)}. Se apuesta cuando el valor esperado estimado, p̂·o − 1, supera el 5 %.
              </p>
              <ul>
                <li><em>Log-loss</em> fuera de muestra: mercado (Shin) {f.num(model.logLossMarket, 4)} frente a Elo {f.num(model.logLossElo, 4)}. Brier: {f.num(model.brierMarket, 4)} frente a {f.num(model.brierElo, 4)}.</li>
                <li>Métodos de quitar el margen, 2012–2026: frecuencias de base {f.num(base.logLoss, 4)}, proporcional {f.num(prop.logLoss, 4)}, Shin {f.num(shin.logLoss, 4)}. Shin y potencia ganan por poco porque corrigen el sesgo favorito–sorpresa.</li>
                <li>ROI de las «apuestas de valor»: {f.signedPct(S.eloValue.roi, 1)} (IC 95 % bootstrap: {f.signedPct(S.eloValue.roiLo, 1)} a {f.signedPct(S.eloValue.roiHi, 1)}).</li>
              </ul>
            </>
          ) : (
            <>
              <p>
                Ordinal logistic model with the Elo rating difference (home − away, in hundreds of points) as the only feature: P(y ≤ j) = σ(c<sub>j</sub> − β·ΔElo), with y ∈ {'{'}home, draw, away{'}'}. Home advantage is absorbed by the cut points. Fitted by maximum likelihood (Nelder–Mead) on the {model.trainSeasons[0]}–{model.trainSeasons[1]} seasons and evaluated out of sample from {model.testSeasons[0]}/{String(model.testSeasons[0] + 1).slice(2)}. It bets when the estimated expected value, p̂·o − 1, exceeds 5%.
              </p>
              <ul>
                <li>Out-of-sample log-loss: market (Shin) {f.num(model.logLossMarket, 4)} vs Elo {f.num(model.logLossElo, 4)}. Brier: {f.num(model.brierMarket, 4)} vs {f.num(model.brierElo, 4)}.</li>
                <li>Margin-removal methods, 2012–2026: base rates {f.num(base.logLoss, 4)}, proportional {f.num(prop.logLoss, 4)}, Shin {f.num(shin.logLoss, 4)}. Shin and power win narrowly because they correct for the favourite–longshot bias.</li>
                <li>ROI of the “value bets”: {f.signedPct(S.eloValue.roi, 1)} (95% bootstrap CI: {f.signedPct(S.eloValue.roiLo, 1)} to {f.signedPct(S.eloValue.roiHi, 1)}).</li>
              </ul>
            </>
          )
        }
      </TechBox>

      <h2 id="ml">{es ? '¿Y con machine learning?' : 'What about machine learning?'}</h2>
      {
        es ? (
          <p>
            Ese modelo solo sabía una cosa de cada equipo: su fuerza general. Así que lo intentamos en serio, con las técnicas de <em>machine learning</em> que se usan en la industria. Le dimos al ordenador {ml.nFeatures} datos de cada partido, todos conocidos antes de que empezara: la fuerza de los equipos, sus puntos y goles recientes, sus tiros, cómo juegan en casa y fuera, los días de descanso y la liga. Y lo examinamos como en la vida real: cada temporada, entrenado solo con las anteriores, sin ver nunca el futuro.
          </p>
        ) : (
          <p>
            That model knew only one thing about each team: its overall strength. So we tried properly, with the <em>machine learning</em> techniques used in industry. We gave the computer {ml.nFeatures} facts about each match, all known before kick-off: team strength, recent points and goals, shots, home and away form, days of rest and league. And we tested it as in real life: each season, trained only on the ones before, never seeing the future.
          </p>
        )
      }
    </article>

    <Figure
      wide={false}
      title={es ? 'El machine learning se acerca a las cuotas, pero no las alcanza' : 'Machine learning gets close to the odds, but does not reach them'}
      sub={es
        ? 'Qué parte de lo que «saben» las cuotas consigue saber cada modelo. 100 % sería predecir igual de bien que la casa. Las rayitas negras marcan el margen de error.'
        : 'How much of what the odds “know” each model manages to learn. 100% would mean predicting as well as the bookmaker. The small black lines show the margin of error.'}
      subTech={es
        ? `Fracción de la mejora en log-loss del mercado (Shin) sobre las frecuencias de base que recupera cada modelo: (LL_base − LL_modelo) / (LL_base − LL_mercado). Walk-forward, temporadas ${seasonLabel(ml.testSeasons[0])} a ${seasonLabel(ml.testSeasons[1])}, n = ${f.int(ml.nTest)}. IC 95 % por bootstrap pareado.`
        : `Share of the market’s (Shin) log-loss improvement over base rates recovered by each model: (LL_base − LL_model) / (LL_base − LL_market). Walk-forward, seasons ${seasonLabel(ml.testSeasons[0])} to ${seasonLabel(ml.testSeasons[1])}, n = ${f.int(ml.nTest)}. 95% paired bootstrap CIs.`}
    >
      <MlSkill client:idle lang={lang} />
    </Figure>

    <article class="measure prose">
      {
        es ? (
          <p>
            Con los datos de los equipos, el mejor modelo llega al {f.pct(M.logreg.share!, 0)}. Y hay una lección que cualquier científico de datos reconoce: el modelo complejo (<em>gradient boosting</em>) no mejora a una regresión logística, mucho más simple. Los datos no dan para más. El único que iguala a la casa es el que recibe las propias cuotas como dato: llega al {f.pct(M.gbm_market.share!, 1)}. Aprende a copiar a la casa, no a superarla.
          </p>
        ) : (
          <p>
            With team data, the best model reaches {f.pct(M.logreg.share!, 0)}. And there is a lesson any data scientist will recognise: the complex model (<em>gradient boosting</em>) does no better than a much simpler logistic regression. The data has nothing more to give. The only model that matches the bookmaker is the one given the odds themselves as input: it reaches {f.pct(M.gbm_market.share!, 1)}. It learns to copy the bookmaker, not to beat it.
          </p>
        )
      }
    </article>

    <Figure
      wide={false}
      title={es ? 'Casi todo lo que sabe el modelo es lo fuerte que es cada equipo' : 'Almost everything the model knows is how strong each team is'}
      sub={es
        ? 'Cuánto más se equivoca el modelo si le quitamos cada tipo de información.'
        : 'How much more the model gets wrong when each kind of information is taken away.'}
      subTech={es
        ? `Importancia por permutación agrupada: aumento relativo del log-loss al barajar juntas las variables de cada grupo (5 repeticiones, barras ±2 DE). Gradient boosting entrenado hasta ${seasonLabel(ml.importanceSeasons[0] - 1)} y evaluado en ${seasonLabel(ml.importanceSeasons[0])} a ${seasonLabel(ml.importanceSeasons[1])}.`
        : `Grouped permutation importance: relative rise in log-loss when each group’s features are shuffled together (5 repeats, bars ±2 SD). Gradient boosting trained up to ${seasonLabel(ml.importanceSeasons[0] - 1)} and evaluated on ${seasonLabel(ml.importanceSeasons[0])} to ${seasonLabel(ml.importanceSeasons[1])}.`}
    >
      <MlImportance client:idle lang={lang} />
    </Figure>

    <article class="measure prose">
      {
        es ? (
          <p>
            La fuerza de cada equipo lo explica casi todo. Los tiros recientes aportan algo. Y la racha de resultados, esa en la que tanta gente se fija para apostar, apenas añade nada: una vez que sabes lo bueno que es un equipo, saber que ha ganado sus tres últimos partidos no te dice casi nada más.
          </p>
        ) : (
          <p>
            Team strength explains almost everything. Recent shots add a little. And the run of results, the thing so many people look at before betting, adds almost nothing: once you know how good a team is, knowing it won its last three matches tells you hardly anything more.
          </p>
        )
      }
    </article>

    <Figure
      wide={false}
      class="only-tech"
      title={es ? 'Calibración fuera de muestra: gradient boosting frente al mercado' : 'Out-of-sample calibration: gradient boosting vs the market'}
      sub={es
        ? `Diagrama de fiabilidad de las predicciones walk-forward (${f.int(ml.nTest)} partidos × 3 resultados, 20 intervalos, IC 95 % de Wilson). El modelo sin cuotas está bien calibrado: pierde por falta de resolución, no por sesgo.`
        : `Reliability diagram of the walk-forward predictions (${f.int(ml.nTest)} matches × 3 outcomes, 20 bins, 95% Wilson CIs). The model without odds is well calibrated: it loses on resolution, not on bias.`}
    >
      <MlCalibration client:idle lang={lang} />
    </Figure>

    <article class="measure prose">
      {
        es ? (
          <p>
            Queda la pregunta que importa: ¿se gana dinero? Pusimos a los dos modelos de machine learning a apostar 1 € cada vez que creían ver una ventaja sobre la cuota de la casa.
          </p>
        ) : (
          <p>
            That leaves the question that matters: does it make money? We set both machine learning models to bet €1 whenever they thought they saw an edge over the bookmaker’s odds.
          </p>
        )
      }
    </article>

    <Figure
      wide={false}
      title={es ? 'Ningún modelo gana dinero de forma fiable' : 'No model makes money reliably'}
      sub={es
        ? 'Ganancia o pérdida media por euro, según la ventaja mínima que el modelo exigía para apostar. Las rayitas negras marcan el margen de error.'
        : 'Average win or loss per euro, by the minimum edge the model required before betting. The small black lines show the margin of error.'}
      subTech={es
        ? `ROI de apostar 1 unidad al resultado con mayor valor esperado p̂·o − 1 cuando supera el umbral. Cuotas de la casa de referencia, ${seasonLabel(ml.testSeasons[0])} a ${seasonLabel(ml.testSeasons[1])}. IC 95 % por bootstrap (1.000 réplicas).`
        : `ROI of betting 1 unit on the outcome with the highest expected value p̂·o − 1 when it exceeds the threshold. Reference-bookmaker odds, ${seasonLabel(ml.testSeasons[0])} to ${seasonLabel(ml.testSeasons[1])}. 95% bootstrap CIs (1,000 resamples).`}
      foot={es
        ? 'Los umbrales más altos (10 %, 15 %, 25 %) y las apuestas a la mejor cuota del mercado están en la tabla. Con tan pocas apuestas, su margen de error es enorme.'
        : 'Higher thresholds (10%, 15%, 25%) and bets at the best market price are in the table. With so few bets, their margin of error is huge.'}
    >
      <MlBetting client:idle lang={lang} />
    </Figure>

    <article class="measure prose">
      {
        es ? (
          <p>
            El modelo que solo mira a los equipos pierde entre un {f.pct(-gbmBest, 0)} y un {f.pct(-gbmWorst, 0)}: lo mismo o más que apostar al azar ({f.pct(-S.random.roi, 1)}). Y cuanto más seguro está de haber encontrado una ganga, más pierde, porque sus «gangas» son casi siempre sorpresas, justo donde la casa paga peor. El que también mira las cuotas queda en tablas: a veces sale un poco arriba, a veces un poco abajo, y el margen de error es tan ancho que no se distingue de cero. Si pruebas suficientes variantes, alguna saldrá en positivo por pura suerte. Es lo que venden muchos pronosticadores: la racha buena, elegida entre muchas.
          </p>
        ) : (
          <p>
            The model that only looks at the teams loses between {f.pct(-gbmBest, 0)} and {f.pct(-gbmWorst, 0)}: as much as or more than betting at random ({f.pct(-S.random.roi, 1)}). And the surer it is of having found a bargain, the more it loses, because its “bargains” are nearly always upsets, exactly where the bookmaker pays worst. The one that also sees the odds breaks even: sometimes a little up, sometimes a little down, and the margin of error is so wide it cannot be told apart from zero. Try enough variants and one will come out positive by pure luck. That is what many tipsters sell: the good run, picked from among many.
          </p>
        )
      }
      <TechBox lang={lang} title={es ? 'Diseño del experimento de machine learning' : 'Machine learning experiment design'}>
        {
          es ? (
            <ul>
              <li><strong>Variables.</strong> {ml.nFeatures} por partido, calculadas solo con partidos anteriores de cada equipo (ventanas móviles de 5, 10 y 20 partidos desplazadas una posición): Elo y su tendencia, puntos, goles a favor y en contra, tiros y tiros a puerta, forma en el mismo campo, tasa de empates, días de descanso, experiencia en la muestra y liga ({ml.leagues} categorías). Unos tests unitarios comprueban que cambiar el resultado de un partido no altera sus propias variables ni las de partidos anteriores.</li>
              <li><strong>Validación.</strong> Walk-forward con ventana expansiva: la temporada <em>s</em> se predice con un modelo entrenado en {ml.trainFrom}–<em>s</em>−1. Los hiperparámetros se eligen una sola vez en un hold-out temporal (entrenamiento {ml.trainFrom}–2012, validación 2013–2015) que no toca los años de test; rejilla de {tuneG.grid} combinaciones. Elegidos: {tuneG.max_iter} árboles, {tuneG.max_leaf_nodes} hojas, mínimo {tuneG.min_samples_leaf} por hoja (sin cuotas) y {tuneM.max_iter} árboles, {tuneM.max_leaf_nodes} hojas (con cuotas); tasa de aprendizaje 0,05 y L2 = 1.</li>
              <li><strong>Modelos.</strong> Logit ordinal sobre ΔElo; regresión logística multinomial (imputación por la mediana con indicadores de ausencia, estandarización, liga en one-hot); <em>HistGradientBoosting</em> de scikit-learn con valores ausentes y liga categórica nativos. El modelo «+ cuotas» añade las probabilidades de Shin y el margen.</li>
              <li><strong>Log-loss fuera de muestra</strong> (n = {f.int(ml.nTest)}): mercado {f.num(M.market.logLoss, 4)}; Elo {f.num(M.elo.logLoss, 4)}; logística {f.num(M.logreg.logLoss, 4)}; gradient boosting {f.num(M.gbm.logLoss, 4)}; gradient boosting + cuotas {f.num(M.gbm_market.logLoss, 4)} (diferencia con el mercado {f.num(M.gbm_market.vsMarket!, 4)}, IC 95 % {f.num(M.gbm_market.vsMarketLo!, 4)} a {f.num(M.gbm_market.vsMarketHi!, 4)}).</li>
              <li><strong>Apuestas.</strong> Se evaluaron {nConfigs} configuraciones. Con cuotas como variable, {mktSignificant.filter((b) => b.lo! > 0).length} de {mktBets.length} intervalos quedan enteros por encima de cero. A la mejor cuota publicada, con umbral del 5 %, el ROI es {f.signedPct(bet('gbm_market', 0.05, 'best').roi!, 1)} (IC {f.signedPct(bet('gbm_market', 0.05, 'best').lo!, 1)} a {f.signedPct(bet('gbm_market', 0.05, 'best').hi!, 1)}): no significativo, sin corregir por comparaciones múltiples, y a precios que en la práctica no siempre se consiguen.</li>
              <li><strong>Límites.</strong> El bootstrap trata los partidos como independientes e ignora la correlación dentro de una jornada, así que los intervalos son algo optimistas. El Elo solo está disponible para parte de los partidos. No hay alineaciones, lesiones ni cuotas de cierre de varias casas, que es la información que sí usa el mercado.</li>
            </ul>
          ) : (
            <ul>
              <li><strong>Features.</strong> {ml.nFeatures} per match, computed only from each team’s earlier matches (rolling windows of 5, 10 and 20 matches, shifted by one): Elo and its trend, points, goals for and against, shots and shots on target, same-venue form, draw rate, rest days, experience in the sample and league ({ml.leagues} categories). Unit tests check that changing a match’s result alters neither its own features nor those of earlier matches.</li>
              <li><strong>Validation.</strong> Walk-forward with an expanding window: season <em>s</em> is predicted by a model trained on {ml.trainFrom}–<em>s</em>−1. Hyperparameters are chosen once on a temporal hold-out (train {ml.trainFrom}–2012, validate 2013–2015) that never touches the test years; grid of {tuneG.grid} combinations. Chosen: {tuneG.max_iter} trees, {tuneG.max_leaf_nodes} leaves, at least {tuneG.min_samples_leaf} per leaf (without odds) and {tuneM.max_iter} trees, {tuneM.max_leaf_nodes} leaves (with odds); learning rate 0.05 and L2 = 1.</li>
              <li><strong>Models.</strong> Ordinal logit on ΔElo; multinomial logistic regression (median imputation with missing indicators, standardisation, one-hot league); scikit-learn <em>HistGradientBoosting</em> with native missing values and categorical league. The “+ odds” model adds the Shin probabilities and the margin.</li>
              <li><strong>Out-of-sample log-loss</strong> (n = {f.int(ml.nTest)}): market {f.num(M.market.logLoss, 4)}; Elo {f.num(M.elo.logLoss, 4)}; logistic {f.num(M.logreg.logLoss, 4)}; gradient boosting {f.num(M.gbm.logLoss, 4)}; gradient boosting + odds {f.num(M.gbm_market.logLoss, 4)} (difference from the market {f.num(M.gbm_market.vsMarket!, 4)}, 95% CI {f.num(M.gbm_market.vsMarketLo!, 4)} to {f.num(M.gbm_market.vsMarketHi!, 4)}).</li>
              <li><strong>Betting.</strong> {nConfigs} configurations were evaluated. With odds as a feature, {mktSignificant.filter((b) => b.lo! > 0).length} of {mktBets.length} intervals lie entirely above zero. At the best published price with a 5% threshold, ROI is {f.signedPct(bet('gbm_market', 0.05, 'best').roi!, 1)} (CI {f.signedPct(bet('gbm_market', 0.05, 'best').lo!, 1)} to {f.signedPct(bet('gbm_market', 0.05, 'best').hi!, 1)}): not significant, uncorrected for multiple comparisons, and at prices that are not always available in practice.</li>
              <li><strong>Limits.</strong> The bootstrap treats matches as independent and ignores correlation within a matchday, so the intervals are somewhat optimistic. Elo is only available for part of the matches. There are no line-ups, injuries or multi-book closing odds, which is exactly the information the market does use.</li>
            </ul>
          )
        }
      </TechBox>

      <h2 id="caveats">{es ? 'Lo que este análisis no cubre' : 'What this analysis does not cover'}</h2>
      {
        es ? (
          <>
            <p>
              Solo miramos la apuesta más básica: quién gana un partido, antes de que empiece. Las combinadas, las apuestas en directo o a goleadores suelen tener comisiones mucho más altas, así que estas cifras son la versión <em>más favorable</em> para quien apuesta.
            </p>
            <TechBox lang={lang} title={es ? 'Límites técnicos' : 'Technical caveats'}>
              <ul>
                <li>La casa de referencia es la que recoge Football-Data.co.uk; en las primeras temporadas puede proceder de otras casas.</li>
                <li>Las cuotas máximas son el mejor precio publicado, no un precio al que siempre se pueda apostar, y no consideran la limitación de cuentas ganadoras.</li>
                <li>El modelo Elo es deliberadamente sencillo. Los modelos de machine learning se acercan más al mercado, pero para ganar dinero tendrían que superarlo y además pagar el margen.</li>
                <li>El análisis es reproducible con <a href="https://github.com/zamora16/unmasking-gambling/tree/main/analysis/odds">analysis/odds/pipeline.py</a> y <a href="https://github.com/zamora16/unmasking-gambling/tree/main/analysis/odds">analysis/odds/ml.py</a>.</li>
              </ul>
            </TechBox>
          </>
        ) : (
          <>
            <p>
              We only look at the most basic bet: who wins a match, before kick-off. Accumulators, in-play bets or goalscorer markets usually carry much higher fees, so these figures are the <em>most favourable</em> version for the bettor.
            </p>
            <TechBox lang={lang} title="Technical caveats">
              <ul>
                <li>The reference bookmaker is the one recorded by Football-Data.co.uk; in the earliest seasons it may come from other bookmakers.</li>
                <li>Maximum odds are the best published price, not a price you can always get, and they ignore the limiting of winning accounts.</li>
                <li>The Elo model is deliberately simple. The machine learning models get closer to the market, but to make money they would have to beat it and pay the margin on top.</li>
                <li>The analysis is reproducible with <a href="https://github.com/zamora16/unmasking-gambling/tree/main/analysis/odds">analysis/odds/pipeline.py</a> and <a href="https://github.com/zamora16/unmasking-gambling/tree/main/analysis/odds">analysis/odds/ml.py</a>.</li>
              </ul>
            </TechBox>
          </>
        )
      }
      <p>
        {es ? 'Más detalles en ' : 'More details in '}<a href={href(lang, 'methods')}>{es ? 'Método' : 'Methods'}</a>.
      </p>
    </article>
  </div>
