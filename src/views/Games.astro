---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import TechBox from '../components/TechBox.astro';
import GamesCost, { GAME_ROWS } from '../islands/GamesCost';
import { type Lang, fmt, href } from '../i18n';
import summary from '../data/odds/summary.json';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const es = lang === 'es';
const f = fmt(lang);

const names: Record<string, [string, string]> = {
  euromillones: ['EuroMillones', 'EuroMillions'],
  primitiva: ['La Primitiva', 'La Primitiva (Spanish lotto)'],
  nacional: ['Lotería Nacional', 'Spanish National Lottery'],
  acca: ['Combinada de 3 partidos', '3-match accumulator'],
  rouletteUS: ['Ruleta americana', 'American roulette'],
  sports: ['Apuesta deportiva simple (1X2)', 'Single sports bet (1X2)'],
  slots: ['Tragaperras', 'Slot machines'],
  rouletteEU: ['Ruleta europea', 'European roulette'],
  craps: ['Dados (craps), línea de pase', 'Craps, pass line'],
  baccarat: ['Baccarat, a la banca', 'Baccarat, banker'],
  blackjack: ['Blackjack con estrategia perfecta', 'Blackjack, perfect basic strategy'],
};
const why: Record<string, [string, string]> = {
  euromillones: ['Solo el 50 % de la recaudación va a premios', 'Only 50% of sales goes to prizes'],
  primitiva: ['El 55 % de la recaudación va a premios', '55% of sales goes to prizes'],
  nacional: ['El 70 % de la emisión va a premios', '70% of the issue goes to prizes'],
  acca: ['El margen se multiplica en cada selección', 'The margin compounds with every leg'],
  rouletteUS: ['Dos ceros: 2 de cada 38 números', 'Two zeros: 2 of every 38 numbers'],
  sports: ['Margen mediano medido en nuestros datos', 'Median margin measured in our data'],
  slots: ['Depende del RTP de cada máquina; aquí, 96 %', 'Depends on each machine’s RTP; here 96%'],
  rouletteEU: ['Un cero: 1 de cada 37 números', 'One zero: 1 of every 37 numbers'],
  craps: ['7/495, cálculo exacto', '7/495, exact calculation'],
  baccarat: ['Tras la comisión del 5 % a la banca', 'After the 5% commission on banker wins'],
  blackjack: ['Solo con estrategia básica perfecta; varía con las reglas', 'Only with perfect basic strategy; varies with the rules'],
};
const maxEdge = Math.max(...GAME_ROWS.map((g) => g.edge));
---

<Base
  lang={lang}
  page="games"
  title={es ? 'Los juegos y su precio' : 'The games and their price'}
  description={es
    ? 'La ventaja de la casa de cada juego, de la lotería al blackjack, y cuánto cuesta jugar a tu ritmo.'
    : 'The house edge of every game, from lotteries to blackjack, and what it costs to play at your pace.'}
>
  <PageHead
    lang={lang}
    kicker={es ? 'Guía de juegos' : 'Game guide'}
    title={es ? 'Cada juego tiene un precio' : 'Every game has a price'}
    lede={es
      ? 'No hay juegos buenos y malos: hay juegos más caros y más baratos. El precio es la ventaja de la casa, y se paga con cada apuesta, se gane o se pierda.'
      : 'There are no good and bad games, only more and less expensive ones. The price is the house edge, and it is paid on every bet, win or lose.'}
  />

  <div class="page">
    <div class="measure figure">
      <GamesCost client:load lang={lang} />
    </div>

    <section class="wide edges" aria-labelledby="edges-title">
      <h2 id="edges-title">{es ? 'La ventaja de la casa, juego a juego' : 'The house edge, game by game'}</h2>
      <p class="sub">
        {es ? 'Lo que la casa se queda, de media, de cada 100 € apostados.' : 'What the house keeps, on average, from every €100 wagered.'}
      </p>
      <table class="edge-table">
        <thead>
          <tr>
            <th scope="col">{es ? 'Juego' : 'Game'}</th>
            <th scope="col" class="bar-col">{es ? 'De cada 100 € apostados, la casa se queda' : 'From every €100 wagered, the house keeps'}</th>
            <th scope="col">{es ? 'Por qué' : 'Why'}</th>
          </tr>
        </thead>
        <tbody>
          {
            GAME_ROWS.map((g) => (
              <tr>
                <th scope="row">{names[g.key][es ? 0 : 1]}</th>
                <td class="bar-col">
                  <div class="bar-cell">
                    <span class="bar" style={`--w:${(g.edge / maxEdge) * 100}%`} aria-hidden="true" />
                    <span class="num">{f.eur(g.edge * 100, g.edge < 0.1 ? 2 : 0)}</span>
                  </div>
                </td>
                <td class="why">{why[g.key][es ? 0 : 1]}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="figure-foot">
        {es ? 'Fuentes: cálculo exacto para ruleta y dados; ' : 'Sources: exact calculation for roulette and craps; '}
        <a href={href(lang, 'odds')}>{es ? 'nuestro análisis de cuotas' : 'our odds analysis'}</a>
        {es ? ` para las apuestas deportivas (margen mediano del ${f.pct(summary.medianMargin, 1)}); ` : ` for sports betting (median margin of ${f.pct(summary.medianMargin, 1)}); `}
        {es ? 'reglas de premios de ' : 'prize rules for '}
        <a href="https://www.labrujadeoro.es/blog/nuevas-normas-de-la-primitiva-distribucion-de-fondos-para-premios.htm">La Primitiva</a>, <a
          href="https://www.elpollitodeoro.com/blog/tabla-premios-euromillones.htm">EuroMillones</a
        >
        {es ? ' y ' : ' and '}<a href="https://www.labrujadeoro.es/loteria-nacional-premios.htm">Lotería Nacional</a>.
        {es ? ' Blackjack y baccarat: valores habituales, que dependen de las reglas de la mesa.' : ' Blackjack and baccarat: typical values that depend on table rules.'}
      </p>
      <TechBox lang={lang} title={es ? 'Cómo se calcula cada ventaja' : 'How each edge is calculated'}>
        {
          es ? (
            <ul>
              <li><strong>Ruleta europea:</strong> una apuesta a un número paga 35 a 1 con probabilidad 1/37: E = 35·(1/37) − 36/37 = −1/37 ≈ −2,70 %. Todas las apuestas de la mesa tienen la misma esperanza. Americana: −2/38 ≈ −5,26 %.</li>
              <li><strong>Dados, línea de pase:</strong> P(ganar) = 244/495, así que E = 244/495 − 251/495 = −7/495 ≈ −1,41 %.</li>
              <li><strong>Apuesta deportiva:</strong> con margen m, lo que devuelve cada euro es 1/(1+m); la ventaja es m/(1+m). Con el margen mediano de nuestros datos, {f.pct(summary.medianMargin / (1 + summary.medianMargin), 2)}.</li>
              <li><strong>Combinadas de k partidos:</strong> las cuotas se multiplican y el retorno también: 1 − (1/(1+m))<sup>k</sup>.</li>
              <li><strong>Loterías:</strong> ventaja = 1 − fracción de la recaudación destinada a premios.</li>
              <li><strong>Calculadora:</strong> pérdida esperada = ventaja × apuesta × apuestas por hora × horas. Es una media: el resultado real de una persona varía mucho alrededor de ella, como se ve en el <a href={href(lang, 'lab')}>Laboratorio</a>.</li>
            </ul>
          ) : (
            <ul>
              <li><strong>European roulette:</strong> a straight-up bet pays 35 to 1 with probability 1/37: E = 35·(1/37) − 36/37 = −1/37 ≈ −2.70%. Every bet on the table has the same expectation. American: −2/38 ≈ −5.26%.</li>
              <li><strong>Craps, pass line:</strong> P(win) = 244/495, so E = 244/495 − 251/495 = −7/495 ≈ −1.41%.</li>
              <li><strong>Sports bet:</strong> with overround m, each euro pays back 1/(1+m); the edge is m/(1+m). With the median margin in our data, {f.pct(summary.medianMargin / (1 + summary.medianMargin), 2)}.</li>
              <li><strong>k-leg accumulators:</strong> odds multiply and so do returns: 1 − (1/(1+m))<sup>k</sup>.</li>
              <li><strong>Lotteries:</strong> edge = 1 − share of sales paid out as prizes.</li>
              <li><strong>Calculator:</strong> expected loss = edge × stake × bets per hour × hours. It is an average: one person’s actual result varies widely around it, as the <a href={href(lang, 'lab')}>Lab</a> shows.</li>
            </ul>
          )
        }
      </TechBox>
    </section>

    <article class="measure prose">
      {
        es ? (
          <>
            <h2>Ruleta: el precio de un cero</h2>
            <p>
              La ruleta paga como si solo hubiera 36 números, pero tiene 37. Esa casilla verde es todo el negocio: en cada apuesta, sea al rojo, a una docena o a un número, la casa se queda de media con 1/37 del dinero. Da igual la estrategia: todas las apuestas de la ruleta europea tienen exactamente la misma ventaja. La americana añade un segundo cero y casi la duplica.
            </p>
            <h2>Tragaperras: poca ventaja, mucha velocidad</h2>
            <p>
              Una tragaperras con un RTP (<em>return to player</em>) del 96 % se queda con 4 céntimos de cada euro. Parece poco, pero una tirada dura unos segundos. A cientos de tiradas por hora, el dinero que pasa por la máquina multiplica varias veces lo que llevabas, y la ventaja se aplica sobre todo lo apostado, no sobre lo que traías. Además, la volatilidad decide la experiencia: las máquinas que concentran el retorno en premios gigantes y raros hacen que la mayoría pierda deprisa, con la promesa del bote de fondo. Lo puedes ver en el <a href={href(lang, 'lab')}>Laboratorio de ruina</a>.
            </p>
            <h2>Apuestas deportivas: el margen escondido</h2>
            <p>
              En las apuestas deportivas el precio no se ve, está dentro de la cuota. En un partido normal de 1X2 la casa se queda con alrededor del {f.pct(summary.medianMargin / (1 + summary.medianMargin), 1)} de lo apostado, y bastante más en ligas pequeñas o en apuestas a cuotas altas. Las <strong>combinadas</strong> son la trampa más cara: el margen se aplica a cada partido y se acumula. Tres selecciones cuestan un {f.pct(1 - (1 / (1 + summary.medianMargin)) ** 3, 0)} y cinco, un {f.pct(1 - (1 / (1 + summary.medianMargin)) ** 5, 0)}. Lo analizamos con 235.000 partidos en <a href={href(lang, 'odds')}>Las cuotas</a>.
            </p>
            <h2>Loterías: el juego más caro, el más aceptado</h2>
            <p>
              La lotería no parece juego de azar porque se juega poco y con calma. Pero es, con diferencia, lo más caro: en EuroMillones solo la mitad de lo recaudado vuelve en premios. Su atractivo es el bote enorme y muy improbable. Una apuesta simple de EuroMillones tiene una probabilidad entre 139.838.160 de acertar la máxima categoría.
            </p>
          </>
        ) : (
          <>
            <h2>Roulette: the price of a zero</h2>
            <p>
              Roulette pays as if there were only 36 numbers, but there are 37. That green pocket is the whole business: on every bet, whether on red, a dozen or a single number, the house keeps 1/37 of the money on average. Strategy makes no difference: every bet in European roulette carries exactly the same edge. American roulette adds a second zero and almost doubles it.
            </p>
            <h2>Slots: a small edge, a lot of speed</h2>
            <p>
              A slot with a 96% RTP (return to player) keeps 4 cents of every euro. That sounds small, but a spin lasts a few seconds. At hundreds of spins an hour, the money going through the machine is several times what you brought, and the edge applies to everything wagered, not to what you started with. Volatility shapes the experience too: machines that pack the return into rare, giant prizes make most players lose fast, with the jackpot dangled in the background. You can see it in the <a href={href(lang, 'lab')}>Ruin Lab</a>.
            </p>
            <h2>Sports betting: the hidden margin</h2>
            <p>
              In sports betting the price is invisible, built into the odds. On a normal 1X2 match the bookmaker keeps about {f.pct(summary.medianMargin / (1 + summary.medianMargin), 1)} of the stake, and quite a bit more in small leagues or on high odds. <strong>Accumulators</strong> are the most expensive trap: the margin applies to every leg and compounds. Three selections cost {f.pct(1 - (1 / (1 + summary.medianMargin)) ** 3, 0)}, five cost {f.pct(1 - (1 / (1 + summary.medianMargin)) ** 5, 0)}. We analysed it with 235,000 matches in <a href={href(lang, 'odds')}>The odds</a>.
            </p>
            <h2>Lotteries: the most expensive game, the most accepted</h2>
            <p>
              The lottery does not feel like gambling because people play rarely and calmly. But it is by far the most expensive: in EuroMillions only half of sales comes back as prizes. Its appeal is the huge and very unlikely jackpot. A single EuroMillions line has a 1 in 139,838,160 chance of hitting the top prize.
            </p>
          </>
        )
      }
    </article>
  </div>
</Base>

<style>
  .edges {
    margin-top: 4rem;
    font-family: var(--sans);
  }
  .edges h2 {
    font-size: clamp(1.7rem, 3vw, 2.2rem);
  }
  .sub {
    color: var(--ink-2);
    margin: 0.4rem 0 1.4rem;
  }
  .edge-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  .edge-table th,
  .edge-table td {
    text-align: left;
    padding: 0.7rem 0.8rem 0.7rem 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: middle;
  }
  .edge-table thead th {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink-3);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .edge-table tbody th {
    font-weight: 600;
    white-space: nowrap;
  }
  .bar-col {
    width: 42%;
  }
  .bar-cell {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .bar {
    display: inline-block;
    height: 14px;
    width: max(3px, calc(var(--w) * 0.8));
    background: var(--accent);
    border-radius: 0 4px 4px 0;
  }
  .num {
    font-size: 0.85rem;
  }
  .why {
    color: var(--ink-2);
    font-size: 0.85rem;
  }
  :global(.cost-grid) {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 0.8rem;
    margin: 1rem 0;
  }
  :global(.cost-grid label) {
    display: grid;
    gap: 0.3rem;
    font-size: 0.8rem;
    color: var(--ink-2);
  }
  :global(.cost-grid select),
  :global(.cost-grid input) {
    font: inherit;
    font-size: 0.9rem;
    padding: 0.5rem;
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
    background: var(--paper);
    color: var(--ink);
    min-width: 0;
  }
  :global(.cost-out) {
    display: grid;
    grid-template-columns: 1fr 1fr 1.3fr;
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: 8px;
    overflow: hidden;
  }
  :global(.cost-out > div) {
    background: var(--paper);
    padding: 0.8rem 1rem;
    display: grid;
    gap: 0.2rem;
    font-size: 0.8rem;
    color: var(--ink-2);
  }
  :global(.cost-out strong) {
    font-size: 1.4rem;
    color: var(--ink);
    font-weight: 600;
  }
  :global(.cost-out .big strong) {
    color: var(--accent-ink);
    font-size: 1.8rem;
  }
  @media (max-width: 700px) {
    :global(.cost-grid) {
      grid-template-columns: 1fr 1fr;
    }
    :global(.cost-grid label:first-child) {
      grid-column: 1 / -1;
    }
    :global(.cost-out) {
      grid-template-columns: 1fr;
    }
    .why {
      display: none;
    }
    .edge-table tbody th {
      white-space: normal;
    }
  }
</style>
