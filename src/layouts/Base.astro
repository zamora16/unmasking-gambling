---
import '../styles/global.css';
import '../styles/games.css';
import '../styles/camino.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { type Lang, type PageKey, href, asset } from '../i18n';

interface Props {
  lang: Lang;
  page: PageKey;
  title: string;
  description: string;
  noindex?: boolean;
}
const { lang, page, title, description, noindex = false } = Astro.props;
const other: Lang = lang === 'es' ? 'en' : 'es';
const fullTitle = page === 'home' ? title : `${title} · Unmasking Gambling`;
const canonical = new URL(href(lang, page), Astro.site).toString();
const ogPage = page === 'wayPrint' ? 'way' : page;
const ogImage = new URL(asset(`og/${lang}/${ogPage}.png`), Astro.site).toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={other} href={new URL(href(other, page), Astro.site).toString()} />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" hreflang="x-default" href={new URL(href('es', page), Astro.site).toString()} />
    <link rel="sitemap" href={asset('sitemap-index.xml')} />
    <meta name="theme-color" content="#0e1d16" />
    <script is:inline>
      try {
        const t = localStorage.getItem('ug-theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
        const m = localStorage.getItem('ug-mode');
        document.documentElement.dataset.mode = m === 'tech' ? 'tech' : 'simple';
      } catch (e) {
        document.documentElement.dataset.mode = 'simple';
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <Header lang={lang} page={page} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 1rem;
    top: -3rem;
    z-index: 100;
    background: var(--ink);
    color: var(--paper);
    padding: 0.5rem 0.9rem;
    font-family: var(--sans);
    font-size: 0.9rem;
    border-radius: var(--radius);
  }
  .skip:focus {
    top: 1rem;
  }
</style>
