---
import '../styles/global.css';
import '../styles/games.css';
import '../styles/camino.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { type Lang, type PageKey, href, asset, ui } from '../i18n';
import { pageMeta } from '../i18n/meta';
import { author } from '../data/author';
import { SOURCES, breadcrumbTrail, pageSchema, type Faq } from '../lib/seo';
import { lastModified } from '../utils/lastModified';

interface Props {
  lang: Lang;
  page: PageKey;
  title: string;
  description: string;
  noindex?: boolean;
  /** Questions and answers shown on the page, mirrored as FAQPage schema. */
  faq?: Faq[];
  /** A page outside the PageKey table (a question page). `page` is then its
   *  section, and these give its own paths, sources and share image. */
  doc?: { slugs: Record<Lang, string>; sources: string[]; og: string; name: string; published?: string };
}
const { lang, page, title, description, noindex = false, faq, doc } = Astro.props;
const other: Lang = lang === 'es' ? 'en' : 'es';
const fullTitle = page === 'home' ? title : `${title} · Unmasking Gambling`;
const pathFor = (l: Lang) => (doc ? asset(`${l === 'en' ? 'en/' : ''}${doc.slugs[l]}`) : href(l, page));
const canonical = new URL(pathFor(lang), Astro.site).toString();
const ogPage = page === 'wayPrint' ? 'way' : page;
const ogImage = new URL(asset(`og/${lang}/${doc ? doc.og : ogPage}.png`), Astro.site).toString();
const abs = (p: PageKey) => new URL(href(lang, p), Astro.site).toString();
const modified = lastModified(doc ? doc.sources : SOURCES[page]);
const nav = ui[lang].nav as Partial<Record<PageKey, string>>;
const crumbName = (p: PageKey) => (p === 'home' ? (lang === 'es' ? 'Inicio' : 'Home') : (nav[p] ?? pageMeta(lang, p)?.title ?? title));
const schema = pageSchema({
  lang,
  page,
  title,
  description,
  url: canonical,
  siteUrl: abs('home'),
  aboutUrl: abs('about'),
  image: ogImage,
  modified,
  crumbs: [...breadcrumbTrail(page, crumbName, abs), ...(doc ? [{ name: doc.name, url: canonical }] : [])],
  faq,
  published: doc?.published,
});
const showByline = page !== 'home' && page !== 'wayPrint';
const longDate = new Intl.DateTimeFormat(lang === 'es' ? 'es-ES' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(modified));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={other} href={new URL(pathFor(other), Astro.site).toString()} />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={page === 'home' ? 'website' : 'article'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" hreflang="x-default" href={new URL(pathFor('es'), Astro.site).toString()} />
    <link rel="sitemap" href={asset('sitemap-index.xml')} />
    <meta name="theme-color" content="#0e1d16" />
    <meta name="author" content={author.name} />
    {page !== 'home' && <meta property="article:modified_time" content={modified} />}
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline>
      try {
        const t = localStorage.getItem('ug-theme');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
        const m = localStorage.getItem('ug-mode');
        document.documentElement.dataset.mode = m === 'tech' ? 'tech' : 'simple';
      } catch (e) {
        document.documentElement.dataset.mode = 'simple';
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <Header lang={lang} page={page} otherHref={doc ? pathFor(other) : undefined} />
    <main id="main">
      <slot />
      {
        showByline && (
          <aside class="byline page" aria-label={lang === 'es' ? 'Autoría' : 'Authorship'}>
            <p>
              {lang === 'es' ? 'Por ' : 'By '}
              <a href={href(lang, 'about')} rel="author">{author.name}</a>, {lang === 'es' ? author.role.es.charAt(0).toLowerCase() + author.role.es.slice(1) : author.role.en}.{' '}
              {lang === 'es' ? 'Última revisión: ' : 'Last reviewed: '}
              <time datetime={modified}>{longDate}</time>.{' '}
              <a href={href(lang, 'methods')}>{lang === 'es' ? 'Cómo está hecho' : 'How it is made'}</a>
              {' · '}
              <a href={author.issues}>{lang === 'es' ? '¿Has visto un error?' : 'Spotted a mistake?'}</a>
            </p>
          </aside>
        )
      }
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: 1rem;
    top: -3rem;
    z-index: 100;
    background: var(--ink);
    color: var(--paper);
    padding: 0.5rem 0.9rem;
    font-family: var(--sans);
    font-size: 0.9rem;
    border-radius: var(--radius);
  }
  .skip:focus {
    top: 1rem;
  }
  .byline {
    margin-top: 4rem;
  }
  .byline p {
    max-width: 50rem;
    margin: 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--rule);
    font-family: var(--sans);
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--ink-3);
  }
  .byline a {
    color: var(--ink-2);
  }
</style>
