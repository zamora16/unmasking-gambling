---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout 
  title="Ventaja de la Casa en Ruleta" 
  description="Descubre cómo el cero verde garantiza las ganancias del casino. Visualización interactiva de la ventaja de la casa en ruleta europea vs americana."
>
  
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-green-700 via-gray-900 to-green-800 text-white py-12">
    <div class="container mx-auto px-4 text-center">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-3xl md:text-5xl font-bold mb-4">
          🏠 Ventaja de la Casa
        </h1>
        <p class="text-lg md:text-xl mb-6 text-green-100">
          El secreto del cero verde: cómo 
          <span class="text-yellow-300 font-semibold">un solo número garantiza billones al casino</span>
        </p>
        <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4 max-w-2xl mx-auto">
          <p class="text-green-100">
            🔍 <strong>La matemática del casino:</strong> Transparente, implacable y rentable
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- House Edge Comparison -->
  <section class="py-12 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        
        <!-- Main Comparison -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
          
          <!-- European Roulette -->
          <div class="bg-white rounded-lg shadow-lg p-6">
            <div class="text-center mb-6">
              <h3 class="text-2xl font-bold text-green-600 mb-2">🇪🇺 Ruleta Europea</h3>
              <div class="text-4xl font-bold text-green-700 mb-2">2.70%</div>
              <p class="text-gray-600">Ventaja de la casa</p>
            </div>
            
            <!-- Visual Wheel -->
            <div class="relative mx-auto mb-6 w-48 h-48">
              <div class="w-48 h-48 rounded-full border-4 border-gray-800 relative overflow-hidden">
                <!-- European wheel visualization -->
                <div class="absolute inset-0 rounded-full" style="background: conic-gradient(
                  #059669 0deg 9.73deg,
                  #dc2626 9.73deg 19.46deg,
                  #1f2937 19.46deg 29.19deg,
                  #dc2626 29.19deg 38.92deg,
                  #1f2937 38.92deg 48.65deg,
                  #dc2626 48.65deg 58.38deg,
                  #1f2937 58.38deg 68.11deg,
                  #dc2626 68.11deg 77.84deg,
                  #1f2937 77.84deg 87.57deg,
                  #dc2626 87.57deg 97.30deg,
                  #1f2937 97.30deg 107.03deg,
                  #dc2626 107.03deg 116.76deg,
                  #1f2937 116.76deg 126.49deg,
                  #dc2626 126.49deg 136.22deg,
                  #1f2937 136.22deg 145.95deg,
                  #dc2626 145.95deg 155.68deg,
                  #1f2937 155.68deg 165.41deg,
                  #dc2626 165.41deg 175.14deg,
                  #1f2937 175.14deg 184.87deg,
                  #dc2626 184.87deg 194.59deg,
                  #1f2937 194.59deg 204.32deg,
                  #dc2626 204.32deg 214.05deg,
                  #1f2937 214.05deg 223.78deg,
                  #dc2626 223.78deg 233.51deg,
                  #1f2937 233.51deg 243.24deg,
                  #dc2626 243.24deg 252.97deg,
                  #1f2937 252.97deg 262.70deg,
                  #dc2626 262.70deg 272.43deg,
                  #1f2937 272.43deg 282.16deg,
                  #dc2626 282.16deg 291.89deg,
                  #1f2937 291.89deg 301.62deg,
                  #dc2626 301.62deg 311.35deg,
                  #1f2937 311.35deg 321.08deg,
                  #dc2626 321.08deg 330.81deg,
                  #1f2937 330.81deg 340.54deg,
                  #dc2626 340.54deg 350.27deg,
                  #1f2937 350.27deg 360deg
                )"></div>
                <div class="absolute inset-4 bg-white rounded-full flex items-center justify-center">
                  <span class="text-2xl font-bold text-green-600">0</span>
                </div>
              </div>
              <div class="text-center mt-2">
                <span class="text-sm text-gray-600">37 números total</span>
              </div>
            </div>

            <div class="space-y-4">
              <div class="bg-green-50 border border-green-200 rounded-lg p-4">
                <h4 class="font-bold text-green-800 mb-2">Cálculo:</h4>
                <div class="text-sm text-green-700 space-y-1">
                  <p>• Apuesta Rojo/Negro: 18/37 = 48.65%</p>
                  <p>• Probabilidad de perder: 19/37 = 51.35%</p>
                  <p>• Ventaja casa: (19-18)/37 = 2.70%</p>
                </div>
              </div>
              
              <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
                <h4 class="font-bold text-gray-800 mb-2">Impacto Real:</h4>
                <div class="text-sm text-gray-700 space-y-1">
                  <p>• Por cada €1000 apostados: -€27</p>
                  <p>• En 1 hora (60 giros): -€16.20</p>
                  <p>• En 1 día completo: -€389</p>
                </div>
              </div>
            </div>
          </div>

          <!-- American Roulette -->
          <div class="bg-white rounded-lg shadow-lg p-6">
            <div class="text-center mb-6">
              <h3 class="text-2xl font-bold text-red-600 mb-2">🇺🇸 Ruleta Americana</h3>
              <div class="text-4xl font-bold text-red-700 mb-2">5.26%</div>
              <p class="text-gray-600">Ventaja de la casa</p>
            </div>
            
            <!-- Visual Wheel -->
            <div class="relative mx-auto mb-6 w-48 h-48">
              <div class="w-48 h-48 rounded-full border-4 border-gray-800 relative overflow-hidden">
                <!-- American wheel with double zero -->
                <div class="absolute inset-0 rounded-full" style="background: conic-gradient(
                  #059669 0deg 9.47deg,
                  #dc2626 9.47deg 18.95deg,
                  #1f2937 18.95deg 28.42deg,
                  #dc2626 28.42deg 37.89deg,
                  #1f2937 37.89deg 47.37deg,
                  #dc2626 47.37deg 56.84deg,
                  #1f2937 56.84deg 66.32deg,
                  #dc2626 66.32deg 75.79deg,
                  #1f2937 75.79deg 85.26deg,
                  #dc2626 85.26deg 94.74deg,
                  #1f2937 94.74deg 104.21deg,
                  #dc2626 104.21deg 113.68deg,
                  #1f2937 113.68deg 123.16deg,
                  #dc2626 123.16deg 132.63deg,
                  #1f2937 132.63deg 142.11deg,
                  #dc2626 142.11deg 151.58deg,
                  #1f2937 151.58deg 161.05deg,
                  #dc2626 161.05deg 170.53deg,
                  #1f2937 170.53deg 180deg,
                  #059669 180deg 189.47deg,
                  #dc2626 189.47deg 198.95deg,
                  #1f2937 198.95deg 208.42deg,
                  #dc2626 208.42deg 217.89deg,
                  #1f2937 217.89deg 227.37deg,
                  #dc2626 227.37deg 236.84deg,
                  #1f2937 236.84deg 246.32deg,
                  #dc2626 246.32deg 255.79deg,
                  #1f2937 255.79deg 265.26deg,
                  #dc2626 265.26deg 274.74deg,
                  #1f2937 274.74deg 284.21deg,
                  #dc2626 284.21deg 293.68deg,
                  #1f2937 293.68deg 303.16deg,
                  #dc2626 303.16deg 312.63deg,
                  #1f2937 312.63deg 322.11deg,
                  #dc2626 322.11deg 331.58deg,
                  #1f2937 331.58deg 341.05deg,
                  #dc2626 341.05deg 350.53deg,
                  #1f2937 350.53deg 360deg
                )"></div>
                <div class="absolute inset-4 bg-white rounded-full flex items-center justify-center">
                  <span class="text-xs font-bold text-green-600">0/00</span>
                </div>
              </div>
              <div class="text-center mt-2">
                <span class="text-sm text-gray-600">38 números total</span>
              </div>
            </div>

            <div class="space-y-4">
              <div class="bg-red-50 border border-red-200 rounded-lg p-4">
                <h4 class="font-bold text-red-800 mb-2">Cálculo:</h4>
                <div class="text-sm text-red-700 space-y-1">
                  <p>• Apuesta Rojo/Negro: 18/38 = 47.37%</p>
                  <p>• Probabilidad de perder: 20/38 = 52.63%</p>
                  <p>• Ventaja casa: (20-18)/38 = 5.26%</p>
                </div>
              </div>
              
              <div class="bg-gray-50 border border-gray-200 rounded-lg p-4">
                <h4 class="font-bold text-gray-800 mb-2">Impacto Real:</h4>
                <div class="text-sm text-gray-700 space-y-1">
                  <p>• Por cada €1000 apostados: -€53</p>
                  <p>• En 1 hora (60 giros): -€31.60</p>
                  <p>• En 1 día completo: -€758</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- The Power of Zero -->
        <div class="bg-white rounded-lg shadow-lg p-8 mb-12">
          <h2 class="text-3xl font-bold text-center text-gray-900 mb-8">🟢 El Poder del Cero Verde</h2>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="text-center">
              <div class="w-20 h-20 bg-green-600 rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="text-2xl font-bold text-white">0</span>
              </div>
              <h3 class="font-bold text-gray-900 mb-2">Sin el Cero</h3>
              <p class="text-sm text-gray-600">
                Si solo hubiera números del 1-36, las apuestas Rojo/Negro tendrían exactamente 50% de probabilidad. 
                El casino no tendría ventaja.
              </p>
              <div class="mt-3 text-lg font-bold text-green-600">0% Ventaja</div>
            </div>
            
            <div class="text-center">
              <div class="w-20 h-20 bg-green-700 rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="text-xl font-bold text-white">0</span>
              </div>
              <h3 class="font-bold text-gray-900 mb-2">Un Cero (Europa)</h3>
              <p class="text-sm text-gray-600">
                El cero no cuenta para Rojo/Negro, Par/Impar, etc. Cuando sale, el casino gana todas las apuestas simples.
              </p>
              <div class="mt-3 text-lg font-bold text-green-600">2.70% Ventaja</div>
            </div>
            
            <div class="text-center">
              <div class="w-20 h-20 bg-green-800 rounded-full flex items-center justify-center mx-auto mb-4">
                <span class="text-sm font-bold text-white">00</span>
              </div>
              <h3 class="font-bold text-gray-900 mb-2">Doble Cero (América)</h3>
              <p class="text-sm text-gray-600">
                América añade un segundo cero. Ahora hay 2 números que hacen ganar al casino en todas las apuestas simples.
              </p>
              <div class="mt-3 text-lg font-bold text-red-600">5.26% Ventaja</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Simulation -->
  <section class="py-12 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-3xl font-bold text-center text-gray-900 mb-8">🎮 Simulación de Convergencia</h2>
        
        <!-- Simple Explanation -->
        <div class="bg-gradient-to-r from-yellow-50 to-orange-50 border-2 border-yellow-300 rounded-lg p-8 mb-8">
          <div class="text-center mb-6">
            <h3 class="text-2xl font-bold text-yellow-900 mb-4">🤔 "Pero a mí me puede ir bien, ¿no?"</h3>
            <p class="text-lg text-yellow-800">
              Esta es la pregunta clave de todo jugador. <strong>Examinémosla con datos objetivos.</strong>
            </p>
          </div>
          
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Single Session -->
            <div class="bg-white rounded-lg p-6 border-2 border-blue-300">
              <div class="text-center mb-4">
                <div class="w-16 h-16 bg-blue-600 rounded-full flex items-center justify-center mx-auto mb-3">
                  <span class="text-2xl">🎰</span>
                </div>
                <h4 class="text-xl font-bold text-blue-800">"Mi sesión de hoy"</h4>
              </div>
              
              <div class="space-y-3 text-sm">
                <div class="bg-blue-50 p-3 rounded">
                  <p class="font-bold text-blue-800">🎯 Lo que piensas:</p>
                  <p class="text-blue-700">"Hoy podría ser mi día de suerte"</p>
                </div>
                
                <div class="bg-red-50 p-3 rounded">
                  <p class="font-bold text-red-800">📉 Lo que observarás:</p>
                  <p class="text-red-700">Cómo las matemáticas se imponen gradualmente, giro tras giro</p>
                </div>
                
                <div class="bg-gray-50 p-3 rounded text-center">
                  <p class="font-bold text-gray-800">⏱️ Perfecto para ver:</p>
                  <p class="text-gray-700">"¿En qué momento empiezo a perder?"</p>
                </div>
              </div>
            </div>
            
            <!-- Multiple Sessions -->
            <div class="bg-white rounded-lg p-6 border-2 border-purple-300">
              <div class="text-center mb-4">
                <div class="w-16 h-16 bg-purple-600 rounded-full flex items-center justify-center mx-auto mb-3">
                  <span class="text-2xl">📊</span>
                </div>
                <h4 class="text-xl font-bold text-purple-800">"Si lo intento 100 veces"</h4>
              </div>
              
              <div class="space-y-3 text-sm">
                <div class="bg-purple-50 p-3 rounded">
                  <p class="font-bold text-purple-800">🎯 Lo que piensas:</p>
                  <p class="text-purple-700">"Algunas veces ganaré, ¿verdad?"</p>
                </div>
                
                <div class="bg-red-50 p-3 rounded">
                  <p class="font-bold text-red-800">🔍 Lo que demostrarás:</p>
                  <p class="text-red-700">Que independientemente del número de intentos, el resultado promedio es predecible</p>
                </div>
                
                <div class="bg-gray-50 p-3 rounded text-center">
                  <p class="font-bold text-gray-800">💥 La evidencia:</p>
                  <p class="text-gray-700">"La mayoría de sesiones terminan en pérdida"</p>
                </div>
              </div>
            </div>
          </div>
          
          <div class="mt-6 p-4 bg-blue-100 border border-blue-300 rounded-lg text-center">
            <p class="text-lg font-bold text-blue-800 mb-2">🎯 Propósito educativo</p>
            <p class="text-blue-700">
              <strong>Una sesión:</strong> Demuestra la convergencia individual | 
              <strong>100 sesiones:</strong> Demuestra la consistencia estadística
            </p>
          </div>
        </div>
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          
          <!-- Simulation Controls -->
          <div class="bg-gray-50 rounded-lg p-6">
            <h3 class="text-xl font-bold text-gray-900 mb-4">🎛️ Controles de Simulación</h3>
            
            <div class="space-y-4 mb-6">
              <div>
                <label class="block text-gray-700 font-medium mb-2">Tipo de Ruleta:</label>
                <div class="flex gap-2">
                  <button id="simEuropeanBtn" class="flex-1 bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded-lg transition-all duration-200 active-sim">
                    🇪🇺 Europea (2.7%)
                  </button>
                  <button id="simAmericanBtn" class="flex-1 bg-red-600 hover:bg-red-700 text-white font-bold py-2 px-4 rounded-lg transition-all duration-200">
                    🇺🇸 Americana (5.26%)
                  </button>
                </div>
                <div class="mt-2 p-2 bg-blue-50 border border-blue-200 rounded text-xs">
                  <span id="rouletteInfo">Europea: 37 números (0-36) | Ventaja casa: 2.70%</span>
                </div>
              </div>
              
              <div>
                <label class="block text-gray-700 font-medium mb-2">Número de Giros:</label>
                <select id="simulationSpins" class="w-full px-3 py-2 border border-gray-300 rounded-lg">
                  <option value="100">100 giros (~2 minutos)</option>
                  <option value="500">500 giros (~10 minutos)</option>
                  <option value="1000" selected>1,000 giros (~20 minutos)</option>
                  <option value="5000">5,000 giros (~1.5 horas)</option>
                  <option value="10000">10,000 giros (~3 horas)</option>
                </select>
              </div>
              
              <div>
                <label class="block text-gray-700 font-medium mb-2">Apuesta por Giro:</label>
                <select id="betPerSpin" class="w-full px-3 py-2 border border-gray-300 rounded-lg">
                  <option value="1">€1</option>
                  <option value="5">€5</option>
                  <option value="10" selected>€10</option>
                  <option value="25">€25</option>
                  <option value="50">€50</option>
                  <option value="100">€100</option>
                </select>
              </div>
            </div>
            
            <button id="runSimulationBtn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg transition-all duration-200 mb-2">
              🎰 Simular "MI sesión de hoy"
            </button>
            <p class="text-xs text-blue-600 text-center mb-4 font-medium">» Analizar cómo se comporta una sesión individual</p>
            
            <button id="run100SimulationsBtn" class="w-full bg-purple-600 hover:bg-purple-700 text-white font-bold py-3 px-6 rounded-lg transition-all duration-200 mb-2">
              📊 Probar "100 veces diferentes"
            </button>
            <p class="text-xs text-purple-600 text-center font-medium">» Demostrar la consistencia de las probabilidades</p>

            <!-- Current Results -->
            <div class="mt-6 p-4 bg-white rounded-lg border">
              <h4 class="font-bold text-gray-900 mb-3">📈 Resultados Actuales</h4>
              <div class="space-y-2 text-sm">
                <div class="flex justify-between">
                  <span class="text-gray-600">Tipo de simulación:</span>
                  <span id="simType" class="font-bold">-</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-600">Giros simulados:</span>
                  <span id="totalSimSpins" class="font-bold">0</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-600">Total apostado:</span>
                  <span id="totalBet" class="font-bold">€0</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-600">Total devuelto:</span>
                  <span id="totalReturned" class="font-bold">€0</span>
                </div>
                <div class="flex justify-between border-t pt-2">
                  <span class="text-gray-600">Pérdida neta:</span>
                  <span id="netLoss" class="font-bold text-red-600">€0</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-600">% Perdido:</span>
                  <span id="lossPercentage" class="font-bold text-red-600">0%</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-gray-600">Ventaja casa teórica:</span>
                  <span id="theoreticalHouseEdge" class="font-bold text-red-600">2.70%</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Chart Display -->
          <div class="bg-gray-50 rounded-lg p-6">
            <h3 class="text-xl font-bold text-gray-900 mb-4">📊 Gráfico: "Análisis de Convergencia"</h3>
            <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-4 text-sm">
              <p class="font-bold text-yellow-800 mb-2">📖 Cómo leer este gráfico:</p>
              <ul class="text-yellow-700 space-y-1 list-disc list-inside">
                <li><span style="color: #2563eb;">Línea azul:</span> Ventaja de la casa real (calculada a partir de los resultados)</li>
                <li><span style="color: #dc2626;">Línea roja punteada:</span> Ventaja de la casa teórica</li>
                <li><strong>Lo que verás:</strong> La línea azul fluctúa al principio pero gradualmente se acerca a la línea roja</li>
              </ul>
            </div>
            <div class="h-80 relative">
              <canvas id="convergenceChart" class="w-full h-full"></canvas>
            </div>
          </div>
        </div>

        <!-- Multiple Simulation Results -->
        <div id="multipleResults" class="mt-12 bg-gray-50 rounded-lg p-6" style="display: none;">
          <h3 class="text-2xl font-bold text-gray-900 mb-4">📊 Resultados de Múltiples Simulaciones</h3>
          <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-6">
            <p class="text-yellow-800">
              <strong>🎯 Lo que demuestran estas simulaciones:</strong> 
              Aunque cada simulación individual puede tener resultados diferentes, el promedio siempre se aproxima a la ventaja teórica de la casa. Las matemáticas son predecibles y consistentes.
            </p>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
            <div class="bg-white rounded-lg p-4 text-center">
              <h4 class="font-bold text-gray-700 mb-2">Simulaciones</h4>
              <div id="simCount" class="text-2xl font-bold text-blue-600">0</div>
            </div>
            <div class="bg-white rounded-lg p-4 text-center">
              <h4 class="font-bold text-gray-700 mb-2">Pérdida Promedio</h4>
              <div id="avgLoss" class="text-2xl font-bold text-red-600">€0</div>
            </div>
            <div class="bg-white rounded-lg p-4 text-center">
              <h4 class="font-bold text-gray-700 mb-2">Ventaja Casa Promedio</h4>
              <div id="avgEdge" class="text-2xl font-bold text-red-600">0.00%</div>
            </div>
            <div class="bg-white rounded-lg p-4 text-center">
              <h4 class="font-bold text-gray-700 mb-2">Simulaciones con Pérdidas</h4>
              <div id="lossingSims" class="text-2xl font-bold text-red-600">0%</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Real World Impact -->
  <section class="py-12 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-center text-gray-900 mb-8">💰 Impacto en el Mundo Real</h2>
        
        <!-- Casino Profits -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
          <div class="bg-white rounded-lg shadow-lg p-6">
            <h3 class="text-xl font-bold text-green-600 mb-4">🏛️ Ganancias de Casino</h3>
            <div class="space-y-4">
              <div class="border-b pb-3">
                <h4 class="font-bold text-gray-900">Por Mesa de Ruleta/Día</h4>
                <div class="text-2xl font-bold text-green-600">€2,000 - €5,000</div>
                <p class="text-sm text-gray-600">Promedio en casinos europeos</p>
              </div>
              <div class="border-b pb-3">
                <h4 class="font-bold text-gray-900">Casino Grande/Año</h4>
                <div class="text-2xl font-bold text-green-600">€50-200 Millones</div>
                <p class="text-sm text-gray-600">Solo de mesas de ruleta</p>
              </div>
              <div>
                <h4 class="font-bold text-gray-900">Las Vegas Strip/Año</h4>
                <div class="text-2xl font-bold text-green-600">€600 Millones</div>
                <p class="text-sm text-gray-600">Ganancias totales de ruleta</p>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-lg shadow-lg p-6">
