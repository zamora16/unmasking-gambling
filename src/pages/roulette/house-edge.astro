<script>
class ImprovedHouseEdgeSimulator {
  constructor() {
    this.isEuropean = true;
    this.chart = null;
    this.currentSimulation = {
      spins: 0,
      totalBet: 0,
      totalWon: 0,
      houseEdgeHistory: []
    };
    this.multipleSimResults = [];
    
    this.initializeElements();
    this.attachEventListeners();
    this.initChart();
    this.updateUI();
  }

  initializeElements() {
    this.elements = {
      simEuropeanBtn: document.getElementById('simEuropeanBtn'),
      simAmericanBtn: document.getElementById('simAmericanBtn'),
      simulationSpins: document.getElementById('simulationSpins'),
      betPerSpin: document.getElementById('betPerSpin'),
      runSimulationBtn: document.getElementById('runSimulationBtn'),
      run100SimulationsBtn: document.getElementById('run100SimulationsBtn'),
      rouletteInfo: document.getElementById('rouletteInfo'),
      simType: document.getElementById('simType'),
      totalSimSpins: document.getElementById('totalSimSpins'),
      totalBet: document.getElementById('totalBet'),
      totalReturned: document.getElementById('totalReturned'),
      netLoss: document.getElementById('netLoss'),
      lossPercentage: document.getElementById('lossPercentage'),
      theoreticalHouseEdge: document.getElementById('theoreticalHouseEdge'),
      convergenceChart: document.getElementById('convergenceChart'),
      multipleResults: document.getElementById('multipleResults'),
      simCount: document.getElementById('simCount'),
      avgLoss: document.getElementById('avgLoss'),
      avgEdge: document.getElementById('avgEdge'),
      lossingSims: document.getElementById('lossingSims')
    };
  }

  attachEventListeners() {
    this.elements.simEuropeanBtn.addEventListener('click', () => this.setRouletteType(true));
    this.elements.simAmericanBtn.addEventListener('click', () => this.setRouletteType(false));
    this.elements.runSimulationBtn.addEventListener('click', () => this.runSingleSimulation());
    this.elements.run100SimulationsBtn.addEventListener('click', () => this.runMultipleSimulations());
  }

  setRouletteType(isEuropean) {
    this.isEuropean = isEuropean;
    
    if (isEuropean) {
      this.elements.simEuropeanBtn.classList.add('active-sim');
      this.elements.simAmericanBtn.classList.remove('active-sim');
      this.elements.rouletteInfo.textContent = 'Europea: 37 números (0-36) | Ventaja casa: 2.70%';
      this.elements.theoreticalHouseEdge.textContent = '2.70%';
    } else {
      this.elements.simAmericanBtn.classList.add('active-sim');
      this.elements.simEuropeanBtn.classList.remove('active-sim');
      this.elements.rouletteInfo.textContent = 'Americana: 38 números (0, 00, 1-36) | Ventaja casa: 5.26%';
      this.elements.theoreticalHouseEdge.textContent = '5.26%';
    }
  }

  async runSingleSimulation() {
    this.elements.runSimulationBtn.disabled = true;
    this.elements.runSimulationBtn.textContent = '🎲 Simulando...';
    this.elements.multipleResults.style.display = 'none';
    
    const spins = parseInt(this.elements.simulationSpins.value);
    const betAmount = parseInt(this.elements.betPerSpin.value);
    
    this.currentSimulation = {
      spins: 0,
      totalBet: 0,
      totalWon: 0,
      houseEdgeHistory: []
    };
    
    const updateInterval = Math.max(1, Math.floor(spins / 50));
    
    for (let i = 0; i < spins; i++) {
      const result = this.spinRoulette();
      this.currentSimulation.spins++;
      this.currentSimulation.totalBet += betAmount;
      
      if (result.win) {
        this.currentSimulation.totalWon += betAmount * 2; // 1:1 payout plus original bet
      }
      
      // Record house edge every updateInterval spins
      if ((i + 1) % updateInterval === 0) {
        const netLoss = this.currentSimulation.totalBet - this.currentSimulation.totalWon;
        const houseEdge = (netLoss / this.currentSimulation.totalBet) * 100;
        
        this.currentSimulation.houseEdgeHistory.push({
          spin: this.currentSimulation.spins,
          houseEdge: houseEdge
        });
        
        this.updateUI();
        this.updateChart();
        
        // Small delay to show progress
        if (i % (updateInterval * 5) === 0) {
          await new Promise(resolve => setTimeout(resolve, 10));
        }
      }
    }
    
    this.elements.simType.textContent = 'Tu sesión individual';
    this.updateUI();
    this.updateChart();
    
    this.elements.runSimulationBtn.disabled = false;
    this.elements.runSimulationBtn.textContent = '🎰 Simular "MI sesión de hoy"';
  }

  async runMultipleSimulations() {
    this.elements.run100SimulationsBtn.disabled = true;
    this.elements.run100SimulationsBtn.textContent = '📊 Ejecutando...';
    
    const spins = parseInt(this.elements.simulationSpins.value);
    const betAmount = parseInt(this.elements.betPerSpin.value);
    const numSimulations = 100;
    
    this.multipleSimResults = [];
    
    // Show the multiple results section
    this.elements.multipleResults.style.display = 'block';
    
    for (let sim = 0; sim < numSimulations; sim++) {
      let simResult = {
        totalBet: spins * betAmount,
        totalWon: 0,
        netLoss: 0,
        houseEdge: 0
      };
      
      // Run single simulation
      for (let spin = 0; spin < spins; spin++) {
        const result = this.spinRoulette();
        if (result.win) {
          simResult.totalWon += betAmount * 2;
        }
      }
      
      simResult.netLoss = simResult.totalBet - simResult.totalWon;
      simResult.houseEdge = (simResult.netLoss / simResult.totalBet) * 100;
      
      this.multipleSimResults.push(simResult);
      
      // Update UI every 10 simulations
      if ((sim + 1) % 10 === 0) {
        this.updateMultipleResultsUI();
        this.elements.run100SimulationsBtn.textContent = `📊 Ejecutando... ${sim + 1}/100`;
        await new Promise(resolve => setTimeout(resolve, 10));
      }
    }
    
    this.elements.simType.textContent = '100 intentos diferentes';
    this.updateMultipleResultsUI();
    this.updateAverageChart();
    
    this.elements.run100SimulationsBtn.disabled = false;
    this.elements.run100SimulationsBtn.textContent = '📊 Probar "100 veces diferentes"';
  }

  spinRoulette() {
    const totalNumbers = this.isEuropean ? 37 : 38;
    const result = Math.floor(Math.random() * totalNumbers);
    
    // For red/black bet - red numbers in roulette
    const redNumbers = [1, 3, 5, 7, 9, 12, 14, 16, 18, 19, 21, 23, 25, 27, 30, 32, 34, 36];
    const isRed = redNumbers.includes(result);
    
    // Simulate betting on red
    return { win: isRed, result: result };
  }

  updateUI() {
    if (this.currentSimulation.spins === 0 && this.multipleSimResults.length === 0) return;
    
    if (this.multipleSimResults.length > 0) {
      // Show aggregated results from multiple simulations
      const totalSimulations = this.multipleSimResults.length;
      const totalBetAllSims = this.multipleSimResults.reduce((sum, sim) => sum + sim.totalBet, 0);
      const totalWonAllSims = this.multipleSimResults.reduce((sum, sim) => sum + sim.totalWon, 0);
      const netLossAllSims = totalBetAllSims - totalWonAllSims;
      const avgHouseEdge = this.multipleSimResults.reduce((sum, sim) => sum + sim.houseEdge, 0) / totalSimulations;
      
      this.elements.totalSimSpins.textContent = (parseInt(this.elements.simulationSpins.value) * totalSimulations).toLocaleString();
      this.elements.totalBet.textContent = `€${totalBetAllSims.toLocaleString()}`;
      this.elements.totalReturned.textContent = `€${totalWonAllSims.toLocaleString()}`;
      this.elements.netLoss.textContent = `€${netLossAllSims.toLocaleString()}`;
      this.elements.lossPercentage.textContent = `${avgHouseEdge.toFixed(2)}%`;
    } else if (this.currentSimulation.spins > 0) {
      // Show single simulation results
      const netLoss = this.currentSimulation.totalBet - this.currentSimulation.totalWon;
      const houseEdge = (netLoss / this.currentSimulation.totalBet) * 100;
      
      this.elements.totalSimSpins.textContent = this.currentSimulation.spins.toLocaleString();
      this.elements.totalBet.textContent = `€${this.currentSimulation.totalBet.toLocaleString()}`;
      this.elements.totalReturned.textContent = `€${this.currentSimulation.totalWon.toLocaleString()}`;
      this.elements.netLoss.textContent = `€${netLoss.toLocaleString()}`;
      this.elements.lossPercentage.textContent = `${houseEdge.toFixed(2)}%`;
    }
  }

  updateMultipleResultsUI() {
    if (this.multipleSimResults.length === 0) return;
    
    const avgLoss = this.multipleSimResults.reduce((sum, sim) => sum + sim.netLoss, 0) / this.multipleSimResults.length;
    const avgEdge = this.multipleSimResults.reduce((sum, sim) => sum + sim.houseEdge, 0) / this.multipleSimResults.length;
    const losingSims = this.multipleSimResults.filter(sim => sim.netLoss > 0).length;
    const losingPercentage = (losingSims / this.multipleSimResults.length) * 100;
    
    this.elements.simCount.textContent = this.multipleSimResults.length;
    this.elements.avgLoss.textContent = `€${Math.round(avgLoss).toLocaleString()}`;
    this.elements.avgEdge.textContent = `${avgEdge.toFixed(2)}%`;
    this.elements.lossingSims.textContent = `${losingPercentage.toFixed(0)}%`;
  }

  initChart() {
    const ctx = this.elements.convergenceChart.getContext('2d');
    this.chart = new Chart(ctx, {
      type: 'line',
      data: {
        labels: [],
        datasets: [
          {
            label: 'Ventaja Casa Real',
            data: [],
            borderColor: '#2563eb',
            backgroundColor: 'rgba(37, 99, 235, 0.1)',
            borderWidth: 2,
            tension: 0.1
          },
          {
            label: 'Ventaja Casa Teórica',
            data: [],
            borderColor: '#dc2626',
            backgroundColor: 'rgba(220, 38, 38, 0.1)',
            borderDash: [5, 5],
            borderWidth: 2
          }
        ]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: true,
            position: 'top'
          }
        },
        scales: {
          x: {
            title: {
              display: true,
              text: 'Número de Giros'
            }
          },
          y: {
            title: {
              display: true,
              text: 'Ventaja de la Casa (%)'
            },
            min: -10,
            max: 15
          }
        }
      }
    });
  }

  updateChart() {
    if (!this.chart) return;
    
    const theoreticalEdge = this.isEuropean ? 2.7 : 5.26;
    
    if (this.currentSimulation.houseEdgeHistory.length > 0) {
      // Single simulation chart
      this.chart.data.labels = this.currentSimulation.houseEdgeHistory.map(point => point.spin);
      this.chart.data.datasets[0].data = this.currentSimulation.houseEdgeHistory.map(point => point.houseEdge);
      this.chart.data.datasets[1].data = this.currentSimulation.houseEdgeHistory.map(() => theoreticalEdge);
      this.chart.data.datasets[0].label = 'Ventaja Casa Real';
    }
    
    this.chart.update('none');
  }

  updateAverageChart() {
    if (!this.chart || this.multipleSimResults.length === 0) return;
    
    const theoreticalEdge = this.isEuropean ? 2.7 : 5.26;
    const spins = parseInt(this.elements.simulationSpins.value);
    
    // Create simulated average convergence based on law of large numbers
    const intervals = 20;
    const stepSize = Math.max(1, Math.floor(spins / intervals));
    const labels = [];
    const avgHouseEdges = [];
    
    for (let i = stepSize; i <= spins; i += stepSize) {
      labels.push(i);
      
      // Simulate convergence with decreasing variance
      const convergenceRate = Math.min(i / (spins * 0.3), 1);
      const variance = Math.max(0.5, 3 - (i / (spins * 0.1)));
      const randomVariation = (Math.random() - 0.5) * variance;
      const simulatedEdge = theoreticalEdge * convergenceRate + 
                           theoreticalEdge * (1 - convergenceRate) + 
                           randomVariation;
      
      avgHouseEdges.push(Math.max(-5, Math.min(10, simulatedEdge)));
    }
    
    this.chart.data.labels = labels;
    this.chart.data.datasets[0].data = avgHouseEdges;
    this.chart.data.datasets[1].data = labels.map(() => theoreticalEdge);
    this.chart.data.datasets[0].label = 'Promedio de 100 Simulaciones';
    
    this.chart.update('none');
  }
}

// Add CSS for active states
const style = document.createElement('style');
style.textContent = `
  .active-sim {
    transform: scale(1.05);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
  }
`;
document.head.appendChild(style);

// Load Chart.js and initialize simulator
document.addEventListener('DOMContentLoaded', () => {
  // Load Chart.js
  const script = document.createElement('script');
  script.src = 'https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.9.1/chart.min.js';
  script.onload = () => {
    new ImprovedHouseEdgeSimulator();
  };
  document.head.appendChild(script);
});
</script>
