---
import MainLayout from '../../layouts/MainLayout.astro';
import { getUrl } from '../../utils/links';
---

<MainLayout 
  title="Ruleta" 
  description="Simuladores y análisis completos de ruleta europea y americana. Descubre por qué ningún sistema puede vencer a las matemáticas."
>
  
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-red-600 via-black to-red-800 text-white overflow-hidden">
    <!-- Animated Background Elements -->
    <div class="absolute inset-0 overflow-hidden">
      <!-- Gradient overlay -->
      <div class="absolute inset-0 bg-gradient-to-br from-red-900/30 via-black/50 to-red-900/30"></div>
      
      <!-- Floating roulette elements -->
      <div class="floating-roulette-shapes">
        <div class="roulette-shape roulette-shape-1">🎲</div>
        <div class="roulette-shape roulette-shape-2">🟢</div>
        <div class="roulette-shape roulette-shape-3">🔴</div>
        <div class="roulette-shape roulette-shape-4">⚫</div>
        <div class="roulette-shape roulette-shape-5">💰</div>
        <div class="roulette-shape roulette-shape-6">📊</div>
        <div class="roulette-shape roulette-shape-7">⚠️</div>
        <div class="roulette-shape roulette-shape-8">📈</div>
      </div>
      
      <!-- Animated roulette wheel pattern -->
      <div class="absolute inset-0 opacity-5">
        <div class="roulette-wheel-pattern"></div>
      </div>
    </div>

    <div class="relative container mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 md:py-24 lg:py-32 text-center z-10">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold mb-8 roulette-title-animation">
          <span class="inline-block roulette-wheel-spin">🎲</span>
          <span class="typing-roulette ml-4">Ruleta</span>
        </h1>
        <div class="staggered-fade-in">
          <p class="text-lg sm:text-xl md:text-2xl lg:text-3xl mb-8 text-red-100 leading-relaxed">
            Analiza las probabilidades de la ruleta y descubre 
            <span class="text-yellow-300 font-semibold glow-text">por qué ningún sistema puede vencer a las matemáticas</span>
          </p>
        </div>
        
        <!-- Quick stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-12 staggered-fade-in-delayed">
          <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4 hover:bg-white/20 transition-all duration-300">
            <div class="text-2xl font-bold counter" data-target="2.7">0</div>
            <div class="text-sm text-red-200">% Ventaja Europa</div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4 hover:bg-white/20 transition-all duration-300">
            <div class="text-2xl font-bold counter" data-target="5.26">0</div>
            <div class="text-sm text-red-200">% Ventaja América</div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4 hover:bg-white/20 transition-all duration-300">
            <div class="text-2xl font-bold counter" data-target="37">0</div>
            <div class="text-sm text-red-200">Números Europa</div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4 hover:bg-white/20 transition-all duration-300">
            <div class="text-2xl font-bold counter" data-target="0">0</div>
            <div class="text-sm text-red-200">% Sistemas que ganan</div>
          </div>
        </div>
        
        <!-- Hero info box -->
        <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 max-w-2xl mx-auto mt-8 hero-info-box">
          <p class="text-red-100 text-lg font-medium">
            🎯 <strong>Simuladores completos:</strong> Desde probabilidades básicas hasta sistemas avanzados
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Navigation Cards -->
  <section class="py-16 sm:py-20 md:py-24 lg:py-32 bg-gradient-to-b from-gray-50 to-white relative overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute top-0 left-0 w-full h-32 bg-gradient-to-b from-red-600/5 to-transparent"></div>
    
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-16 lg:mb-24">
        <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 fade-in-up">
          Simuladores 
          <span class="bg-gradient-to-r from-red-600 to-black bg-clip-text text-transparent">
            Reveladores
          </span>
        </h2>
        <p class="text-xl md:text-2xl text-gray-600 max-w-4xl mx-auto leading-relaxed fade-in-up-delayed">
          Herramientas interactivas que exponen la realidad matemática de la ruleta
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-10">
        
        <!-- Main Simulator -->
        <div class="roulette-card group">
          <div class="roulette-card-header bg-gradient-to-br from-red-600 to-red-800">
            <div class="roulette-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1" />
              </svg>
            </div>
            <div class="absolute top-4 right-4 bg-yellow-400 text-yellow-900 px-3 py-1 rounded-full text-sm font-bold principal-badge">
              PRINCIPAL
            </div>
          </div>
          <div class="roulette-card-content">
            <h3 class="text-2xl font-bold text-gray-900 mb-4">🎯 Simulador Interactivo</h3>
            <p class="text-gray-600 mb-6 leading-relaxed">
              Experimenta con diferentes tipos de apuestas en ruleta europea y americana. Ve en tiempo real cómo las matemáticas favorecen al casino.
            </p>
            <div class="mb-6 flex flex-wrap gap-2">
              <span class="tag tag-red">Ruleta Visual</span>
              <span class="tag tag-green">Auto-play</span>
              <span class="tag tag-blue">Estadísticas</span>
            </div>
            <a 
              href={getUrl('/roulette/simulator')} 
              class="roulette-link bg-gradient-to-r from-red-600 to-red-800 hover:from-red-700 hover:to-red-900"
            >
              Simular Ruleta
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Systems Analysis -->
        <div class="roulette-card group">
          <div class="roulette-card-header bg-gradient-to-br from-gray-700 to-gray-900">
            <div class="roulette-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            </div>
            <div class="absolute top-4 right-4 bg-red-400 text-red-900 px-3 py-1 rounded-full text-sm font-bold devastador-badge">
              DEVASTADOR
            </div>
          </div>
          <div class="roulette-card-content">
            <h3 class="text-2xl font-bold text-gray-900 mb-4">📈 Análisis de Sistemas</h3>
            <p class="text-gray-600 mb-6 leading-relaxed">
              Prueba Martingala, Fibonacci y D'Alembert. Descubre por qué todos los sistemas están matemáticamente condenados al fracaso.
            </p>
            <div class="mb-6 flex flex-wrap gap-2">
              <span class="tag tag-red">Martingala</span>
              <span class="tag tag-blue">Fibonacci</span>
              <span class="tag tag-green">D'Alembert</span>
            </div>
            <a 
              href={getUrl('/roulette/systems')} 
              class="roulette-link bg-gradient-to-r from-gray-700 to-gray-900 hover:from-gray-800 hover:to-black"
            >
              Analizar Sistemas
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Probability Calculator -->
        <div class="roulette-card group">
          <div class="roulette-card-header bg-gradient-to-br from-blue-600 to-indigo-700">
            <div class="roulette-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01m3 0h.01m0-3h.01m-3 0h.01m3-3h.01m-3 0h.01M5 8a2 2 0 012-2h10a2 2 0 012 2v8a2 2 0 01-2 2H7a2 2 0 01-2-2V8z" />
              </svg>
            </div>
            <div class="absolute top-4 right-4 bg-blue-400 text-blue-900 px-3 py-1 rounded-full text-sm font-bold preciso-badge">
              PRECISO
            </div>
          </div>
          <div class="roulette-card-content">
            <h3 class="text-2xl font-bold text-gray-900 mb-4">🧮 Calculadora de Probabilidades</h3>
            <p class="text-gray-600 mb-6 leading-relaxed">
              Calcula las probabilidades exactas, pagos esperados y ventaja de la casa para cualquier tipo de apuesta en ruleta.
            </p>
            <div class="mb-6 flex flex-wrap gap-2">
              <span class="tag tag-blue">13 Tipos Apuesta</span>
              <span class="tag tag-indigo">Comparador</span>
              <span class="tag tag-purple">Matemáticas</span>
            </div>
            <a 
              href={getUrl('/roulette/calculator')} 
              class="roulette-link bg-gradient-to-r from-blue-600 to-indigo-700 hover:from-blue-700 hover:to-indigo-800"
            >
              Calcular Probabilidades
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- House Edge Demo -->
        <div class="roulette-card group">
          <div class="roulette-card-header bg-gradient-to-br from-green-600 to-green-800">
            <div class="roulette-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
              </svg>
            </div>
            <div class="absolute top-4 right-4 bg-green-400 text-green-900 px-3 py-1 rounded-full text-sm font-bold revelador-badge">
              REVELADOR
            </div>
          </div>
          <div class="roulette-card-content">
            <h3 class="text-2xl font-bold text-gray-900 mb-4">🏠 Ventaja de la Casa</h3>
            <p class="text-gray-600 mb-6 leading-relaxed">
              Visualiza cómo el cero verde garantiza billones al casino. Simulación de convergencia e impacto en el mundo real.
            </p>
            <div class="mb-6 flex flex-wrap gap-2">
              <span class="tag tag-green">Convergencia</span>
              <span class="tag tag-red">Tiempo Ruina</span>
              <span class="tag tag-yellow">Ganancias Casino</span>
            </div>
            <a 
              href={getUrl('/roulette/house-edge')} 
              class="roulette-link bg-gradient-to-r from-green-600 to-green-800 hover:from-green-700 hover:to-green-900"
            >
              Ver Ventaja Casa
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Eye-Opening Stats -->
  <section class="py-16 sm:py-20 md:py-24 lg:py-32 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-16 lg:mb-24">
          <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 fade-in-up">
            🎯 Datos Clave sobre la 
            <span class="bg-gradient-to-r from-red-600 to-black bg-clip-text text-transparent">
              Ruleta
            </span>
          </h2>
          <p class="text-xl md:text-2xl text-gray-600 fade-in-up-delayed">
            Conoce los hechos antes de apostar
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12 sm:mb-16">
          <div class="stats-card group european-card">
            <div class="text-center mb-6">
              <div class="text-5xl mb-4">🇪🇺</div>
              <h3 class="text-2xl font-bold text-green-800 mb-2">Ruleta Europea</h3>
              <div class="text-4xl font-bold text-green-600 counter" data-target="2.70">0</div>
              <div class="stats-symbol">%</div>
              <p class="text-green-700 mt-2">Ventaja de la casa</p>
            </div>
            <div class="space-y-3 text-sm">
              <div class="flex justify-between">
                <span class="text-green-700">Números totales:</span>
                <span class="font-bold">37 (0, 1-36)</span>
              </div>
              <div class="flex justify-between">
                <span class="text-green-700">Prob. Rojo/Negro:</span>
                <span class="font-bold">48.65%</span>
              </div>
              <div class="flex justify-between">
                <span class="text-green-700">RTP promedio:</span>
                <span class="font-bold">97.30%</span>
              </div>
              <div class="flex justify-between border-t pt-2">
                <span class="text-green-700">Pérdida por €100:</span>
                <span class="font-bold text-red-600">€2.70</span>
              </div>
            </div>
          </div>

          <div class="stats-card group american-card">
            <div class="text-center mb-6">
              <div class="text-5xl mb-4">🇺🇸</div>
              <h3 class="text-2xl font-bold text-red-800 mb-2">Ruleta Americana</h3>
              <div class="text-4xl font-bold text-red-600 counter" data-target="5.26">0</div>
              <div class="stats-symbol">%</div>
              <p class="text-red-700 mt-2">Ventaja de la casa</p>
            </div>
            <div class="space-y-3 text-sm">
              <div class="flex justify-between">
                <span class="text-red-700">Números totales:</span>
                <span class="font-bold">38 (0, 00, 1-36)</span>
              </div>
              <div class="flex justify-between">
                <span class="text-red-700">Prob. Rojo/Negro:</span>
                <span class="font-bold">47.37%</span>
              </div>
              <div class="flex justify-between">
                <span class="text-red-700">RTP promedio:</span>
                <span class="font-bold">94.74%</span>
              </div>
              <div class="flex justify-between border-t pt-2">
                <span class="text-red-700">Pérdida por €100:</span>
                <span class="font-bold text-red-600">€5.26</span>
              </div>
            </div>
          </div>
        </div>

        <div class="reality-alert">
          <h3 class="text-2xl font-bold text-red-800 mb-6 text-center">⚡ Comparación Rápida</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="text-center">
              <div class="text-5xl font-bold text-red-600 mb-4 counter" data-target="95">0</div>
              <div class="stats-symbol">%</div>
              <p class="text-red-700">Peor para el jugador: Ruleta americana tiene casi el doble de ventaja de casa</p>
            </div>
            <div class="text-center">
              <div class="text-5xl font-bold text-red-600 mb-4">€<span class="counter" data-target="2.56">0</span></div>
              <p class="text-red-700">Diferencia por cada €100 apostados entre europea vs americana</p>
            </div>
            <div class="text-center">
              <div class="text-5xl font-bold text-red-600 mb-4 counter" data-target="100">0</div>
              <div class="stats-symbol">%</div>
              <p class="text-red-700">Probabilidad de que pierdas dinero si juegas el tiempo suficiente</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Educational Content -->
  <section class="py-16 sm:py-20 md:py-24 bg-gradient-to-br from-gray-50 to-gray-100 relative overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute inset-0 opacity-5">
      <div class="education-pattern"></div>
    </div>
    
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16 lg:mb-24">
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-6 fade-in-up">
            🧠 Lo Que 
            <span class="bg-gradient-to-r from-red-600 to-gray-900 bg-clip-text text-transparent">
              Debes Entender
            </span>
          </h2>
          <p class="text-xl md:text-2xl text-gray-600 fade-in-up-delayed">
            Conocimiento que puede salvarte dinero
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="education-card group">
            <div class="text-5xl mb-6 education-icon">✅</div>
            <h3 class="text-2xl font-bold text-blue-800 mb-4">VERDADES Matemáticas</h3>
            <ul class="text-blue-700 space-y-3">
              <li class="flex items-start">
                <span class="text-blue-500 mr-2 mt-1">•</span>
                <span><strong>Cada giro es independiente</strong> - Los resultados pasados no afectan los futuros</span>
              </li>
              <li class="flex items-start">
                <span class="text-blue-500 mr-2 mt-1">•</span>
                <span><strong>El RNG es aleatorio</strong> - No hay patrones, secuencias o máquinas "calientes"</span>
              </li>
              <li class="flex items-start">
                <span class="text-blue-500 mr-2 mt-1">•</span>
                <span><strong>La ventaja es inmutable</strong> - Está en la estructura misma del juego</span>
              </li>
              <li class="flex items-start">
                <span class="text-blue-500 mr-2 mt-1">•</span>
                <span><strong>Los límites de mesa existen</strong> - Para evitar que sistemas como Martingala funcionen</span>
              </li>
              <li class="flex items-start">
                <span class="text-blue-500 mr-2 mt-1">•</span>
                <span><strong>El cero es clave</strong> - Es lo que garantiza las ganancias del casino</span>
              </li>
            </ul>
          </div>
          
          <div class="education-card group">
            <div class="text-5xl mb-6 education-icon">❌</div>
            <h3 class="text-2xl font-bold text-red-800 mb-4">MITOS Peligrosos</h3>
            <ul class="text-red-700 space-y-3">
              <li class="flex items-start">
                <span class="text-red-500 mr-2 mt-1">•</span>
                <span><strong>"Los números tienen memoria"</strong> - Falacia del jugador clásica</span>
              </li>
              <li class="flex items-start">
                <span class="text-red-500 mr-2 mt-1">•</span>
                <span><strong>"Martingala siempre funciona"</strong> - Solo hasta que no funciona y pierdes todo</span>
              </li>
              <li class="flex items-start">
                <span class="text-red-500 mr-2 mt-1">•</span>
                <span><strong>"Puedo predecir patrones"</strong> - Imposible con verdadera aleatoriedad</span>
              </li>
              <li class="flex items-start">
                <span class="text-red-500 mr-2 mt-1">•</span>
                <span><strong>"Esta mesa está trucada"</strong> - Las matemáticas ya favorecen al casino</span>
              </li>
              <li class="flex items-start">
                <span class="text-red-500 mr-2 mt-1">•</span>
                <span><strong>"Con suficiente dinero ganaré"</strong> - Límites de mesa y tiempo te detendrán</span>
              </li>
            </ul>
          </div>
        </div>

        <div class="mt-16 bg-white rounded-lg shadow-lg p-8 text-center">
          <h3 class="text-2xl font-bold text-gray-900 mb-6">🎲 La Única Certeza en la Ruleta</h3>
          <div class="text-4xl font-bold text-red-600 mb-4">2.70% - 5.26%</div>
          <p class="text-lg text-gray-700 mb-6">
            Esta es la ventaja matemática garantizada del casino en cada giro. 
            No importa qué estrategia uses, esta ventaja siempre está presente.
          </p>
          <div class="bg-gray-100 rounded-lg p-6 max-w-2xl mx-auto">
            <p class="text-gray-700 font-medium italic">
              "La ruleta es un juego perfecto desde la perspectiva del casino: 
              ofrece la ilusión de que puedes ganar mientras garantiza matemáticamente que ellos ganen."
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-16 sm:py-20 bg-gradient-to-r from-red-600 via-black to-red-700 relative overflow-hidden">
    <!-- Background effects -->
    <div class="absolute inset-0 bg-black/10"></div>
    <div class="absolute inset-0 opacity-20">
      <div class="floating-cta-shapes">
        <div class="cta-shape cta-shape-1"></div>
        <div class="cta-shape cta-shape-2"></div>
        <div class="cta-shape cta-shape-3"></div>
      </div>
    </div>
    
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-8 fade-in-up">
          🎯 Usa Nuestros Simuladores
        </h2>
        <p class="text-xl md:text-2xl text-red-100 mb-12 leading-relaxed fade-in-up-delayed">
          No arriesgues tu dinero real. Usa nuestros simuladores para entender las matemáticas 
          antes de que te cuesten dinero real.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto staggered-fade-in">
          <a 
