---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout 
  title="Gestor Inteligente de Dinero - ¿Funciona Controlar Cuánto Apuesto?" 
  description="¿Crees que controlando cuánto apuestas puedes ganar dinero? Prueba diferentes estrategias de gestión y descubre por qué el 95% sigue perdiendo."
>
  
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-purple-600 via-indigo-600 to-purple-800 text-white py-20">
    <div class="container mx-auto px-4 text-center">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl md:text-6xl font-bold mb-6">
          🧠 Gestor Inteligente de Dinero
        </h1>
        <p class="text-xl md:text-2xl mb-8 text-purple-100">
          "Si controlo bien cuánto apuesto en cada partido, podré ganar dinero"
        </p>
        <div class="bg-white/10 backdrop-blur-sm rounded-lg p-6 max-w-2xl mx-auto">
          <p class="text-purple-100 text-lg">
            🤔 <strong>¿Te suena familiar?</strong> Vamos a poner esta creencia a prueba...
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Reality Check -->
  <section class="py-12 bg-blue-50 border-b border-blue-200">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-8">
          <h2 class="text-2xl font-bold text-blue-800 mb-4">💡 ¿Qué significa "gestionar bien el dinero"?</h2>
          <p class="text-blue-700 text-lg">
            Muchas personas creen que el secreto está en controlar cuánto apuestan. 
            <strong>"Si nunca apuesto más del 5% de mi dinero, podré ganar"</strong> es una frase muy común.
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
          <div class="bg-white rounded-lg p-4 border border-blue-200">
            <div class="text-2xl font-bold text-green-600">💶</div>
            <div class="text-sm text-gray-700 mt-2">
              <strong>Método 1:</strong><br>
              "Siempre apuesto la misma cantidad"<br>
              <span class="text-xs text-gray-500">Ej: Siempre 50€</span>
            </div>
          </div>
          <div class="bg-white rounded-lg p-4 border border-blue-200">
            <div class="text-2xl font-bold text-blue-600">📊</div>
            <div class="text-sm text-gray-700 mt-2">
              <strong>Método 2:</strong><br>
              "Siempre el mismo porcentaje"<br>
              <span class="text-xs text-gray-500">Ej: Siempre el 3%</span>
            </div>
          </div>
          <div class="bg-white rounded-lg p-4 border border-blue-200">
            <div class="text-2xl font-bold text-purple-600">🤓</div>
            <div class="text-sm text-gray-700 mt-2">
              <strong>Método 3:</strong><br>
              "Hay una fórmula matemática"<br>
              <span class="text-xs text-gray-500">Que calcula por mí</span>
            </div>
          </div>
        </div>
        
        <div class="bg-yellow-100 border border-yellow-300 rounded-lg p-4 mt-6 max-w-2xl mx-auto">
          <p class="text-yellow-800 text-center">
            <strong>🤔 La pregunta de 1000€:</strong><br>
            Si alguno de estos métodos realmente funcionara...<br>
            ¿Por qué siguen perdiendo dinero el 95% de los apostadores?
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Interface -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        
        <!-- Configuration Panel -->
        <div class="bg-white rounded-xl shadow-lg p-6 mb-8">
          <h3 class="text-2xl font-bold text-gray-900 mb-6">⚙️ Vamos a Probarlo Tú Mismo</h3>
          
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">¿Cuánto dinero tienes para apostar?</label>
              <input 
                type="number" 
                id="initialBankroll"
                value="1000"
                min="100"
                step="100"
                class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500"
              >
              <small class="text-gray-500">No te preocupes, es solo una simulación</small>
            </div>
            
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">¿Qué tal crees que se te da predecir?</label>
              <select id="winRate" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500">
                <option value="0.48">Malo - Peor que la suerte (48%)</option>
                <option value="0.50">Regular - Como tirar una moneda (50%)</option>
                <option value="0.52" selected>Bueno - Un poco mejor que la suerte (52%)</option>
                <option value="0.55">Muy bueno - Bastante hábil (55%)</option>
              </select>
            </div>
            
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">¿Cuánto te suelen pagar las casas?</label>
              <select id="avgOdds" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500">
                <option value="1.80">€1.80 por cada euro (casas codiciosas)</option>
                <option value="1.85">€1.85 por cada euro (casas normales)</option>
                <option value="1.90" selected>€1.90 por cada euro (casas buenas)</option>
                <option value="1.95">€1.95 por cada euro (casas generosas)</option>
                <option value="2.00">€2.00 por cada euro (ideal teórico)</option>
              </select>
            </div>
            
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">¿Cuántas apuestas quieres simular?</label>
              <select id="numBets" class="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-500">
                <option value="100">100 apuestas (3 meses)</option>
                <option value="250" selected>250 apuestas (8 meses)</option>
                <option value="500">500 apuestas (1 año y medio)</option>
                <option value="1000">1000 apuestas (3 años)</option>
              </select>
            </div>
          </div>

          <!-- Strategy Selection -->
          <div class="border-t border-gray-200 pt-6">
            <h4 class="text-lg font-semibold text-gray-800 mb-4">📊 Estrategia de Gestión</h4>
            
            <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6">
              <h5 class="font-bold text-blue-800 mb-2">💡 ¿Cómo quieres gestionar tu dinero?</h5>
              <p class="text-blue-700 text-sm mb-3">
                Elige una estrategia y veamos qué tal funciona en la práctica.
                Cada método tiene sus defensores que juran que "es la clave del éxito".
              </p>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
              <label class="strategy-option cursor-pointer">
                <input type="radio" name="strategy" value="fixed" class="sr-only" checked>
                <div class="strategy-card border-2 border-blue-200 rounded-lg p-4 hover:border-blue-400 transition-all">
                  <h5 class="font-bold text-blue-800">💶 Cantidad Fija</h5>
                  <p class="text-blue-600 text-sm">"Siempre apuesto la misma cantidad"</p>
                  <p class="text-blue-500 text-xs mt-1">La estrategia más simple</p>
                </div>
              </label>
              
              <label class="strategy-option cursor-pointer">
                <input type="radio" name="strategy" value="percentage" class="sr-only">
                <div class="strategy-card border-2 border-gray-200 rounded-lg p-4 hover:border-gray-400 transition-all">
                  <h5 class="font-bold text-gray-800">📊 Porcentaje Fijo</h5>
                  <p class="text-gray-600 text-sm">"Siempre apuesto el mismo % de mi dinero"</p>
                  <p class="text-gray-500 text-xs mt-1">Se adapta al dinero disponible</p>
                </div>
              </label>
              
              <label class="strategy-option cursor-pointer">
                <input type="radio" name="strategy" value="kelly" class="sr-only">
                <div class="strategy-card border-2 border-gray-200 rounded-lg p-4 hover:border-gray-400 transition-all">
                  <h5 class="font-bold text-gray-800">🤓 Fórmula Inteligente</h5>
                  <p class="text-gray-600 text-sm">"Que las matemáticas decidan por mí"</p>
                  <p class="text-gray-500 text-xs mt-1">Los profesionales la usan</p>
                </div>
              </label>
            </div>

            <div id="strategyParams" class="mb-6">
              <!-- Strategy-specific parameters will be inserted here -->
            </div>
          </div>

          <button 
            onclick="runBankrollSimulation()" 
            id="simulateBtn"
            class="w-full bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white font-bold py-3 px-6 rounded-lg transition-all duration-200"
          >
            🎯 Probar Mi Estrategia
          </button>
        </div>

        <!-- Results Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
          
          <!-- Chart -->
          <div class="bg-white rounded-xl shadow-lg p-6">
            <h3 class="text-xl font-bold text-gray-900 mb-4">📈 ¿Cómo Evolucionó Tu Dinero?</h3>
            <div id="chartContainer" class="h-80">
              <div class="flex items-center justify-center h-full text-gray-500">
                💰 Prueba tu estrategia para ver cómo evoluciona tu dinero
              </div>
            </div>
          </div>
          
          <!-- Risk Metrics -->
          <div class="bg-white rounded-xl shadow-lg p-6">
            <h3 class="text-xl font-bold text-gray-900 mb-4">📊 ¿Cómo te Fue?</h3>
            <div id="riskMetrics" class="space-y-4">
              <div class="text-center text-gray-500 py-8">
                🎯 Tus resultados aparecerán aquí
              </div>
            </div>
          </div>
        </div>

        <!-- Kelly Reality Check -->
        <div class="bg-white rounded-xl shadow-lg p-6 mb-8" id="kellyReality" style="display: none;">
          <h3 class="text-xl font-bold text-gray-900 mb-4">🤓 ¿Qué es esa "Fórmula Inteligente"?</h3>
          <div id="kellyAnalysis"></div>
        </div>

        <!-- Comparison Results -->
        <div class="bg-white rounded-xl shadow-lg p-6" id="comparisonSection">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-xl font-bold text-gray-900">⚖️ Comparación Educativa</h3>
            <button 
              id="toggleComparison" 
              onclick="toggleComparisonVisibility()" 
              class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg text-sm transition-all"
              style="display: none;"
            >
              📊 Mostrar Comparación
            </button>
          </div>
          
          <div id="comparisonIntro" class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-6" style="display: none;">
            <div class="text-blue-800 text-sm">
              <strong>🤔 ¿Te preguntas cómo se compara tu estrategia con las otras?</strong><br>
              Aunque elegiste <strong id="selectedStrategyName"></strong>, aquí puedes ver cómo se comportarían 
              las 3 estrategias usando exactamente los mismos parámetros que configuraste.
              <br><br>
              <em>Nota: Esto es solo para comparación educativa. Los parámetros de las otras estrategias 
              son valores estándar típicos.</em>
            </div>
          </div>
          
          <div id="strategyComparison" style="display: none;">
            <div class="text-center text-gray-500 py-8">
              📈 La comparación aparecerá después de la simulación
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Educational Content -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold text-center text-gray-900 mb-12">💡 La Realidad de la Gestión de Dinero</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          
          <!-- What Management CAN Do -->
          <div class="bg-green-50 border border-green-200 rounded-lg p-6">
            <h3 class="text-xl font-bold text-green-800 mb-4">✅ Lo que SÍ Puede Hacer la Gestión</h3>
            <div class="text-green-700 space-y-3 text-sm">
              <div>
                <strong>• Durar más tiempo:</strong><br>
                Con buena gestión no te quedas sin dinero tan rápido
              </div>
              <div>
                <strong>• Reducir el estrés:</strong><br>
                Apostando cantidades razonables duermes mejor
              </div>
              <div>
                <strong>• Evitar la ruina total:</strong><br>
                Nunca apostar "todo a una carta"
              </div>
              <div>
                <strong>• Mantener el control:</strong><br>
                Tener un plan te ayuda a no volverte loco
              </div>
              <div class="bg-green-100 p-3 rounded border-l-4 border-green-400">
                <strong>💪 Beneficio real:</strong> La gestión te ayuda a apostar de forma más inteligente y disciplinada.
              </div>
            </div>
          </div>

          <!-- What Management CANNOT Do -->
          <div class="bg-red-50 border border-red-200 rounded-lg p-6">
            <h3 class="text-xl font-bold text-red-800 mb-4">❌ Lo que NO Puede Hacer la Gestión</h3>
            <div class="text-red-700 space-y-3 text-sm">
              <div>
                <strong>• Crear ganancias mágicas:</strong><br>
                Si no sabes predecir, ningún método te hará ganar
              </div>
              <div>
                <strong>• Vencer las matemáticas:</strong><br>
                El margen de las casas sigue ahí, hagas lo que hagas
              </div>
              <div>
                <strong>• Eliminar las rachas malas:</strong><br>
                Puedes perder 10 seguidas aunque gestiones perfectamente
              </div>
              <div>
                <strong>• Convertirte en profesional:</strong><br>
                La gestión es una herramienta, no una solución mágica
              </div>
              <div class="bg-red-100 p-3 rounded border-l-4 border-red-400">
                <strong>⚠️ Realidad:</strong> Sin ventaja real, todas las estrategias llevan al mismo destino: pérdidas graduales.
              </div>
            </div>
          </div>
        </div>

        <!-- Examples -->
        <div class="mt-12">
          <h3 class="text-2xl font-bold text-center text-gray-900 mb-8">📊 ¿Qué Puedes Esperar Realmente?</h3>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-green-50 border border-green-200 rounded-lg p-4">
              <h4 class="font-bold text-green-800 mb-2">🎆 Escenario Ideal</h4>
              <div class="text-green-700 text-sm space-y-1">
                <div>• Tienes €10,000 para apostar</div>
                <div>• Eres realmente bueno (53% aciertos)</div>
                <div>• Encuentras casas generosas</div>
                <div>• Mantienes disciplina perfecta</div>
                <div class="border-t border-green-300 pt-2 mt-2 font-bold">
                  ✅ Podrías ganar dinero lentamente
                </div>
              </div>
              <p class="text-green-600 text-xs mt-2 font-semibold">
                Solo el 2-3% de apostadores llega aquí
              </p>
            </div>
            
            <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
              <h4 class="font-bold text-yellow-800 mb-2">🤷 Escenario Realista</h4>
              <div class="text-yellow-700 text-sm space-y-1">
                <div>• Tienes €2,000 ahorrados</div>
                <div>• Aciertas como tirar una moneda (50%)</div>
                <div>• Las casas se quedan su parte</div>
                <div>• A veces te emocionas y apuestas más</div>
                <div class="border-t border-yellow-300 pt-2 mt-2 font-bold">
                  ⚠️ Perderás dinero gradualmente
                </div>
              </div>
              <p class="text-yellow-600 text-xs mt-2 font-semibold">
                La situación del 90% de la gente
              </p>
            </div>
            
            <div class="bg-red-50 border border-red-200 rounded-lg p-4">
              <h4 class="font-bold text-red-800 mb-2">😨 Escenario Peligroso</h4>
              <div class="text-red-700 text-sm space-y-1">
                <div>• Apuestas dinero que necesitas</div>
                <div>• Persigues las pérdidas</div>
                <div>• "Esta vez seguro que gano"</div>
                <div>• La gestión se va por la ventana</div>
                <div class="border-t border-red-300 pt-2 mt-2 font-bold">
                  ❌ Problemas serios garantizados
                </div>
              </div>
              <p class="text-red-600 text-xs mt-2 font-semibold">
                El 5-8% acaba aquí
              </p>
            </div>
          </div>
          
          <div class="bg-blue-100 border border-blue-300 rounded-lg p-6 mt-8 max-w-2xl mx-auto">
            <h4 class="text-blue-800 font-bold mb-3">🎯 La Conclusión Más Importante</h4>
            <p class="text-blue-700">
              La gestión de dinero es como un cinturón de seguridad en un coche:
              <strong>Te protege en caso de accidente, pero no puede llevarte a donde no existe carretera.</strong>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-16 bg-purple-600">
    <div class="container mx-auto px-4 text-center">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-bold text-white mb-6">💡 La Gestión es Solo una Herramienta</h2>
        <p class="text-xl text-purple-100 mb-8">
          Gestionar bien el dinero te ayuda a apostar de forma más inteligente y durar más tiempo. 
          Pero <strong>no puede crear ganancias donde no las hay</strong>.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="/sports" 
            class="bg-white hover:bg-gray-100 text-purple-600 font-bold py-3 px-6 rounded-lg transition-all duration-200"
          >
            🏈 Más Simuladores
          </a>
          <a 
            href="/the-way" 
            class="bg-purple-800 hover:bg-purple-900 text-white font-bold py-3 px-6 rounded-lg transition-all duration-200"
          >
            🛤️ El Camino
          </a>
        </div>
      </div>
    </div>
  </section>

</MainLayout>

<script client:load>
  let simulationData = [];
  let currentStrategy = 'fixed';
  
  document.addEventListener('DOMContentLoaded', function() {
    console.log('Bankroll manager loaded');
    updateStrategyUI();
    setupStrategyListeners();
  });
  
  function setupStrategyListeners() {
    document.querySelectorAll('input[name="strategy"]').forEach(radio => {
      radio.addEventListener('change', function() {
        currentStrategy = this.value;
        updateStrategyUI();
      });
    });
  }
  
  function updateStrategyUI() {
    // Update visual selection
    document.querySelectorAll('.strategy-card').forEach(card => {
      card.classList.remove('border-purple-400', 'bg-purple-50');
      card.classList.add('border-gray-200');
    });
    
    const selectedCard = document.querySelector(`input[value="${currentStrategy}"]`).parentNode.querySelector('.strategy-card');
    selectedCard.classList.add('border-purple-400', 'bg-purple-50');
    selectedCard.classList.remove('border-gray-200');
    
    // Update strategy parameters
    const paramsContainer = document.getElementById('strategyParams');
    let paramsHTML = '';
    
    switch(currentStrategy) {
      case 'kelly':
        paramsHTML = `
          <div class="bg-purple-50 border border-purple-200 rounded-lg p-4">
            <div class="text-purple-800 text-sm">
              <strong>🤓 Sobre la "Fórmula Inteligente":</strong> 
              <br>• <strong>¿Qué hace?</strong> Calcula automáticamente cuánto apostar según tus posibilidades de ganar
              <br>• <strong>¿Cómo funciona?</strong> Mira tus aciertos, las ganancias, y decide el porcentaje "óptimo"
              <br>• <strong>El problema:</strong> Solo funciona si realmente tienes ventaja (muy raro)
              <br>• <strong>En la práctica:</strong> La mayoría sobreestima sus habilidades
            </div>
          </div>
        `;
        break;
      case 'fixed':
        paramsHTML = `
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Cantidad por apuesta (€)</label>
              <input type="number" id="fixedAmount" value="50" min="10" class="w-full p-2 border rounded">
            </div>
            <div class="flex items-end">
              <div class="text-gray-600 text-sm">Apuesta siempre la misma cantidad fija</div>
            </div>
          </div>
        `;
        break;
      case 'percentage':
        paramsHTML = `
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">% del bankroll</label>
              <input type="number" id="fixedPercentage" value="3" min="1" max="10" step="0.5" class="w-full p-2 border rounded">
            </div>
            <div class="flex items-end">
              <div class="text-gray-600 text-sm">% fijo del bankroll actual en cada apuesta</div>
            </div>
          </div>
        `;
        break;
    }
    
    paramsContainer.innerHTML = paramsHTML;
  }
  
  function runBankrollSimulation() {
    console.log('Starting bankroll simulation...');
    
    const initialBankroll = parseFloat(document.getElementById('initialBankroll').value);
    const winRate = parseFloat(document.getElementById('winRate').value);
    const avgOdds = parseFloat(document.getElementById('avgOdds').value);
    const numBets = parseInt(document.getElementById('numBets').value);
    
    console.log('Parameters:', { initialBankroll, winRate, avgOdds, numBets, strategy: currentStrategy });
    
    const btn = document.getElementById('simulateBtn');
    btn.textContent = '⏳ Ejecutando simulación...';
    btn.disabled = true;
    
    setTimeout(() => {
      try {
        // Calculate true edge (correct mathematical formula)
        const trueEdge = (winRate * (avgOdds - 1)) - (1 - winRate);
        // Simplified: trueEdge = (winRate * avgOdds) - 1
        
        console.log('True edge:', trueEdge);
        
        // Run simulation
        const result = simulateBankroll(initialBankroll, winRate, avgOdds, numBets, currentStrategy);
        
        simulationData = result;
        
        updateChart(result.history);
        
        // Calculate realistic Risk of Ruin
        result.riskOfRuin = calculateRiskOfRuin(initialBankroll, winRate, avgOdds, numBets, currentStrategy, result);
        
        updateRiskMetrics(result);
        updateKellyReality(result, trueEdge);
        
        // Show comparison button after simulation
        showComparisonOption();
        runStrategyComparison();
        
        // Update selected strategy name in comparison intro
        updateSelectedStrategyName();
        
        btn.textContent = '🔄 Ejecutar Nueva Simulación';
        btn.disabled = false;
      } catch (error) {
        console.error('Simulation error:', error);
        btn.textContent = '❌ Error - Intentar de nuevo';
        btn.disabled = false;
      }
    }, 100);
  }
  
  function simulateBankroll(initialBankroll, winRate, avgOdds, numBets, strategy) {
    let bankroll = initialBankroll;
    const history = [{ bet: 0, bankroll: bankroll, bet_amount: 0, won: null }];
    
    // Calculate Kelly fraction (theoretical) - using correct edge formula
    const edge = (winRate * (avgOdds - 1)) - (1 - winRate); // Correct edge calculation
    const kellyFraction = edge > 0 ? (winRate * avgOdds - 1) / (avgOdds - 1) : 0;
    
    let maxBankroll = bankroll;
    let minBankroll = bankroll;
    let maxDrawdown = 0;
    let consecutiveLosses = 0;
    let maxConsecutiveLosses = 0;
    let winsCount = 0;
    
    for (let i = 1; i <= numBets; i++) {
      if (bankroll <= 0.01) break; // Practically busted
      
      // Calculate bet amount based on strategy
      let betAmount = 0;
      
      switch(strategy) {
        case 'kelly':
          // Kelly with educational minimum - even if Kelly says "don't bet", bet small amount for demonstration
          const kellySuggestion = Math.max(0, kellyFraction * bankroll);
          if (kellySuggestion <= 0) {
            // If Kelly says don't bet, use 1% for educational purposes
            betAmount = bankroll * 0.01;
          } else {
            // Cap Kelly at 10% to prevent disaster
            betAmount = Math.min(kellySuggestion, bankroll * 0.1);
          }
          break;
        case 'fixed':
          const fixedAmount = document.getElementById('fixedAmount') ? 
            parseFloat(document.getElementById('fixedAmount').value) : 50;
          betAmount = Math.min(fixedAmount, bankroll);
          break;
        case 'percentage':
          const percentage = document.getElementById('fixedPercentage') ? 
            parseFloat(document.getElementById('fixedPercentage').value) : 3;
          betAmount = (percentage / 100) * bankroll;
          break;
      }
      
      betAmount = Math.max(0.01, Math.min(betAmount, bankroll * 0.99)); // Minimum €0.01, max 99% of bankroll
      
      // Simulate bet outcome
      const won = Math.random() < winRate;
      
      if (won) {
        bankroll += betAmount * (avgOdds - 1);
        consecutiveLosses = 0;
        winsCount++;
      } else {
        bankroll -= betAmount;
        consecutiveLosses++;
        maxConsecutiveLosses = Math.max(maxConsecutiveLosses, consecutiveLosses);
      }
      
      // Track statistics
      maxBankroll = Math.max(maxBankroll, bankroll);
      minBankroll = Math.min(minBankroll, bankroll);
      const currentDrawdown = maxBankroll > 0 ? (maxBankroll - bankroll) / maxBankroll : 0;
      maxDrawdown = Math.max(maxDrawdown, currentDrawdown);
      
      history.push({ 
        bet: i, 
        bankroll: Math.max(0, bankroll), 
        bet_amount: betAmount,
        won: won 
      });
    }
    
    const actualWinRate = winsCount / numBets;
    // Calculate risk of ruin after we have the result
    const riskOfRuin = 0; // Will be calculated later with more context
    
    return {
      history,
      finalBankroll: Math.max(0, bankroll),
      maxBankroll,
      minBankroll,
      maxDrawdown,
      maxConsecutiveLosses,
      totalReturn: ((bankroll - initialBankroll) / initialBankroll) * 100,
      kellyFraction,
      busted: bankroll <= 0.01,
      actualWinRate,
      riskOfRuin,
      edge
    };
  }
  
  function calculateRiskOfRuin(initialBankroll, winRate, avgOdds, numBets, strategy, currentResult) {
    // More realistic Risk of Ruin using Monte Carlo simulation
    // For performance, we'll run a smaller simulation and combine with current result
    
    if (currentResult.busted) return 100;
    
    const numSimulations = 250; // Reduced for performance
    let ruinedSimulations = 0;
    const edge = (winRate * (avgOdds - 1)) - (1 - winRate);
    
    for (let sim = 0; sim < numSimulations; sim++) {
      let bankroll = initialBankroll;
      const kellyFraction = edge > 0 ? (winRate * avgOdds - 1) / (avgOdds - 1) : 0;
      
      for (let bet = 0; bet < numBets; bet++) {
        if (bankroll <= 0.01) {
          ruinedSimulations++;
          break;
        }
        
        // Calculate bet amount based on strategy
        let betAmount = 0;
        switch(strategy) {
          case 'kelly':
            betAmount = Math.min(Math.max(0, kellyFraction * bankroll), bankroll * 0.1);
            break;
          case 'fixed':
            const fixedAmt = 50; // Default assumption
            betAmount = Math.min(fixedAmt, bankroll);
            break;
          case 'percentage':
            betAmount = bankroll * 0.03; // Default 3%
            break;
        }
        
        betAmount = Math.max(0.01, Math.min(betAmount, bankroll * 0.99));
        
        // Simulate outcome
        const won = Math.random() < winRate;
        if (won) {
          bankroll += betAmount * (avgOdds - 1);
        } else {
          bankroll -= betAmount;
        }
      }
    }
    
    const simulatedRoR = (ruinedSimulations / numSimulations) * 100;
    
    // Combine with current result for better estimation
    if (currentResult.totalReturn < -80) return Math.max(simulatedRoR, 90);
    if (currentResult.totalReturn < -50) return Math.max(simulatedRoR, 70);
    if (currentResult.totalReturn < -20) return Math.max(simulatedRoR, 40);
    
    return Math.min(simulatedRoR, 95); // Cap at 95%
  }
  
