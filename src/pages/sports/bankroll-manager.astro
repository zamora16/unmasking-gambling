      html += `<line x1="40" y1="${y}" x2="760" y2="${y}" stroke="#e5e7eb" stroke-width="1"/>`;
    }
    
    // Chart line
    let pathData = '';
    history.forEach((point, index) => {
      const x = 40 + ((index / (history.length - 1)) * 720);
