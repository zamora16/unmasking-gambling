---
import MainLayout from '../../layouts/MainLayout.astro';
import { getUrl } from '../../utils/links';
---

<MainLayout 
  title="Apuestas Deportivas" 
  description="Simuladores educativos sobre apuestas deportivas. Descubre por qué incluso los mejores apostadores luchan por ser rentables."
>
  
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-green-600 via-blue-700 to-green-800 text-white overflow-hidden">
    <!-- Animated Background Elements -->
    <div class="absolute inset-0 overflow-hidden">
      <!-- Gradient overlay -->
      <div class="absolute inset-0 bg-gradient-to-br from-green-900/30 via-blue-900/50 to-green-900/30"></div>
      
      <!-- Floating sports elements -->
      <div class="floating-sports-shapes">
        <div class="sports-shape sports-shape-1">🏆</div>
        <div class="sports-shape sports-shape-2">⚽</div>
        <div class="sports-shape sports-shape-3">🏀</div>
        <div class="sports-shape sports-shape-4">🎾</div>
        <div class="sports-shape sports-shape-5">🏈</div>
        <div class="sports-shape sports-shape-6">📊</div>
        <div class="sports-shape sports-shape-7">💰</div>
        <div class="sports-shape sports-shape-8">📈</div>
      </div>
      
      <!-- Animated sports pattern -->
      <div class="absolute inset-0 opacity-5">
        <div class="sports-grid-pattern"></div>
      </div>
    </div>

    <div class="relative container mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 md:py-24 lg:py-32 text-center z-10">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold mb-8 sports-title-animation">
          <span class="inline-block">🏆</span>
          <span class="typing-sports ml-4">Apuestas Deportivas</span>
        </h1>
        <div class="staggered-fade-in">
          <p class="text-lg sm:text-xl md:text-2xl lg:text-3xl mb-8 text-green-100 leading-relaxed">
            Descubre por qué incluso acertando el 70% de tus apuestas 
            <span class="text-yellow-300 font-semibold glow-text">puedes seguir perdiendo dinero</span>
          </p>
        </div>
        
        <!-- Quick stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-12 staggered-fade-in-delayed">
          <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4 hover:bg-white/20 transition-all duration-300">
            <div class="text-2xl font-bold counter" data-target="96">0</div>
            <div class="text-sm text-green-200">% Apostadores pierden</div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4 hover:bg-white/20 transition-all duration-300">
            <div class="text-2xl font-bold counter" data-target="5">0</div>
            <div class="text-sm text-green-200">% Margen Casa</div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4 hover:bg-white/20 transition-all duration-300">
            <div class="text-2xl font-bold counter" data-target="65">0</div>
            <div class="text-sm text-green-200">% Aciertos mínimo</div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4 hover:bg-white/20 transition-all duration-300">
            <div class="text-2xl font-bold counter" data-target="2">0</div>
            <div class="text-sm text-green-200">% ROI profesional</div>
          </div>
        </div>
        
        <!-- Hero info box -->
        <div class="bg-white/10 backdrop-blur-sm rounded-xl p-6 max-w-2xl mx-auto mt-8 hero-info-box">
          <p class="text-green-100 text-lg font-medium">
            📊 <strong>Simuladores reales:</strong> Las matemáticas del betting deportivo
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Navigation Cards -->
  <section class="py-16 sm:py-20 md:py-24 lg:py-32 bg-gradient-to-b from-gray-50 to-white relative overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute top-0 left-0 w-full h-32 bg-gradient-to-b from-green-600/5 to-transparent"></div>
    
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-16 lg:mb-24">
        <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 fade-in-up">
          Simuladores 
          <span class="bg-gradient-to-r from-green-600 to-blue-600 bg-clip-text text-transparent">
            Reveladores
          </span>
        </h2>
        <p class="text-xl md:text-2xl text-gray-600 max-w-4xl mx-auto leading-relaxed fade-in-up-delayed">
          Herramientas interactivas que muestran la realidad matemática de las apuestas deportivas
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
        
        <!-- Profit Illusion Simulator - Main Feature -->
        <div class="sports-card group">
          <div class="sports-card-header bg-gradient-to-br from-blue-600 to-indigo-700">
            <div class="sports-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <div class="absolute top-4 right-4 bg-blue-400 text-blue-900 px-3 py-1 rounded-full text-sm font-bold revelador-badge">
              REVELADOR
            </div>
          </div>
          <div class="sports-card-content">
            <h3 class="text-2xl font-bold text-gray-900 mb-4">📊 Ilusión de Ganancias</h3>
            <p class="text-gray-600 mb-6 leading-relaxed">
              Dos apostadores idénticos, misma habilidad, mismos aciertos. Solo cambian las cuotas. Descubre cómo el margen transforma ganancias en pérdidas.
            </p>
            <div class="mb-6 flex flex-wrap gap-2">
              <span class="tag tag-blue">Experimento Controlado</span>
              <span class="tag tag-indigo">Comparación Visual</span>
              <span class="tag tag-purple">Impacto del Margen</span>
            </div>
            <a 
              href={getUrl('/sports/season-simulator')} 
              class="sports-link bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700"
            >
              Ver Experimento
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Streak Simulator -->
        <div class="sports-card group">
          <div class="sports-card-header bg-gradient-to-br from-green-600 to-emerald-700">
            <div class="sports-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            </div>
            <div class="absolute top-4 right-4 bg-green-400 text-green-900 px-3 py-1 rounded-full text-sm font-bold esencial-badge">
              ESENCIAL
            </div>
          </div>
          <div class="sports-card-content">
            <h3 class="text-2xl font-bold text-gray-900 mb-4">📈 Simulador de Rachas</h3>
            <p class="text-gray-600 mb-6 leading-relaxed">
              ¿Tu racha de 10 aciertos demuestra habilidad? Simula 1000 apostadores aleatorios y descubre que las rachas son normales estadísticamente.
            </p>
            <div class="mb-6 flex flex-wrap gap-2">
              <span class="tag tag-green">1000 Apostadores</span>
              <span class="tag tag-emerald">Rachas Reales</span>
              <span class="tag tag-teal">Survival Bias</span>
            </div>
            <a 
              href={getUrl('/sports/streak-simulator')} 
              class="sports-link bg-gradient-to-r from-green-600 to-emerald-600 hover:from-green-700 hover:to-emerald-700"
            >
              Simular Rachas
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Bankroll Manager -->
        <div class="sports-card group">
          <div class="sports-card-header bg-gradient-to-br from-purple-600 to-purple-800">
            <div class="sports-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01m3 0h.01m0-3h.01m-3 0h.01m3-3h.01m-3 0h.01M5 8a2 2 0 012-2h10a2 2 0 012 2v8a2 2 0 01-2 2H7a2 2 0 01-2-2V8z" />
              </svg>
            </div>
            <div class="absolute top-4 right-4 bg-purple-400 text-purple-900 px-3 py-1 rounded-full text-sm font-bold avanzado-badge">
              AVANZADO
            </div>
          </div>
          <div class="sports-card-content">
            <h3 class="text-2xl font-bold text-gray-900 mb-4">💰 Bankroll Manager</h3>
            <p class="text-gray-600 mb-6 leading-relaxed">
              "Yo gestiono bien el dinero". Descubre por qué Kelly Criterion, gestión de riesgo y estrategias no pueden vencer las desventajas matemáticas.
            </p>
            <div class="mb-6 flex flex-wrap gap-2">
              <span class="tag tag-purple">Kelly Criterion</span>
              <span class="tag tag-pink">Risk of Ruin</span>
              <span class="tag tag-violet">Limitaciones</span>
            </div>
            <a 
              href={getUrl('/sports/bankroll-manager')} 
              class="sports-link bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700"
            >
              Gestionar Bankroll
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Eye-Opening Stats -->
  <section class="py-16 sm:py-20 md:py-24 lg:py-32 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-16 lg:mb-24">
          <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 fade-in-up">
            🚨 Estadísticas Que 
            <span class="bg-gradient-to-r from-red-600 to-orange-600 bg-clip-text text-transparent">
              Debes Conocer
            </span>
          </h2>
          <p class="text-xl md:text-2xl text-gray-600 fade-in-up-delayed">
            La realidad de las apuestas deportivas
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12 sm:mb-16">
          <div class="stats-card group">
            <div class="text-5xl font-bold text-red-600 mb-4 counter" data-target="96">0</div>
            <div class="stats-symbol">%</div>
            <p class="text-xl font-bold text-gray-900 mb-2">De apostadores pierde dinero</p>
            <p class="text-gray-500">Solo 4% tiene beneficios a largo plazo</p>
          </div>
          <div class="stats-card group">
            <div class="text-5xl font-bold text-red-600 mb-4"><span class="counter" data-target="5">0</span>-<span class="counter" data-target="10">0</span></div>
            <div class="stats-symbol">%</div>
            <p class="text-xl font-bold text-gray-900 mb-2">Margen típico de la casa</p>
            <p class="text-gray-500">Ventaja matemática en cada apuesta</p>
          </div>
          <div class="stats-card group">
            <div class="text-5xl font-bold text-red-600 mb-4"><span class="counter" data-target="2">0</span>-<span class="counter" data-target="5">0</span></div>
            <div class="stats-symbol">%</div>
            <p class="text-xl font-bold text-gray-900 mb-2">ROI de profesionales</p>
            <p class="text-gray-500">Incluso los mejores ganan poco</p>
          </div>
        </div>

        <div class="reality-alert">
          <h3 class="text-2xl font-bold text-red-800 mb-6 text-center">⚠️ La Verdad Incómoda</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="reality-section">
              <h4 class="text-xl font-bold text-red-800 mb-4">Incluso Acertando Mucho...</h4>
              <div class="accuracy-bars">
                <div class="accuracy-item">
                  <div class="flex justify-between mb-2">
                    <span class="font-semibold">55% aciertos</span>
                    <span class="text-red-600 font-bold">Pierdes dinero</span>
                  </div>
                  <div class="accuracy-bar bg-red-200">
                    <div class="accuracy-fill bg-red-500 w-[55%]"></div>
                  </div>
                </div>
                <div class="accuracy-item">
                  <div class="flex justify-between mb-2">
                    <span class="font-semibold">60% aciertos</span>
                    <span class="text-orange-600 font-bold">Rompes tablas</span>
                  </div>
                  <div class="accuracy-bar bg-orange-200">
                    <div class="accuracy-fill bg-orange-500 w-[60%]"></div>
                  </div>
                </div>
                <div class="accuracy-item">
                  <div class="flex justify-between mb-2">
                    <span class="font-semibold">65% aciertos</span>
                    <span class="text-yellow-600 font-bold">Ganancia mínima</span>
                  </div>
                  <div class="accuracy-bar bg-yellow-200">
                    <div class="accuracy-fill bg-yellow-500 w-[65%]"></div>
                  </div>
                </div>
                <div class="accuracy-item">
                  <div class="flex justify-between mb-2">
                    <span class="font-semibold">70% aciertos</span>
                    <span class="text-green-600 font-bold">Muy difícil mantener</span>
                  </div>
                  <div class="accuracy-bar bg-green-200">
                    <div class="accuracy-fill bg-green-500 w-[70%]"></div>
                  </div>
                </div>
              </div>
            </div>
            <div class="reality-section">
              <h4 class="text-xl font-bold text-red-800 mb-4">¿Por Qué Es Tan Difícil?</h4>
              <ul class="text-red-700 space-y-3">
                <li class="flex items-center">
                  <span class="text-red-500 mr-3 text-xl">⚠</span>
                  <span><strong>Margen de la casa</strong> (5-10%)</span>
                </li>
                <li class="flex items-center">
                  <span class="text-red-500 mr-3 text-xl">📉</span>
                  <span><strong>Varianza</strong> y rachas malas</span>
                </li>
                <li class="flex items-center">
                  <span class="text-red-500 mr-3 text-xl">🧠</span>
                  <span><strong>Sesgo de confirmación</strong></span>
                </li>
                <li class="flex items-center">
                  <span class="text-red-500 mr-3 text-xl">😰</span>
                  <span><strong>Gestión emocional</strong></span>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Educational Content -->
  <section class="py-16 sm:py-20 md:py-24 bg-gradient-to-br from-gray-50 to-gray-100 relative overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute inset-0 opacity-5">
      <div class="education-pattern"></div>
    </div>
    
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16 lg:mb-24">
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-6 fade-in-up">
            🎓 Lo Que 
            <span class="bg-gradient-to-r from-blue-600 to-green-600 bg-clip-text text-transparent">
              Aprenderás
            </span>
          </h2>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="education-card group">
            <div class="text-5xl mb-6 education-icon">📊</div>
            <h3 class="text-2xl font-bold text-blue-800 mb-4">Matemáticas Reales</h3>
            <ul class="text-blue-700 space-y-3">
              <li class="flex items-start">
                <span class="text-blue-500 mr-2 mt-1">•</span>
                <span><strong>Margen de la casa</strong> - Cómo se calcula el "juice"</span>
              </li>
              <li class="flex items-start">
                <span class="text-blue-500 mr-2 mt-1">•</span>
                <span><strong>Probabilidades implícitas</strong> - Qué significan las cuotas realmente</span>
              </li>
              <li class="flex items-start">
                <span class="text-blue-500 mr-2 mt-1">•</span>
                <span><strong>Valor esperado</strong> - Por qué pierdes incluso acertando</span>
              </li>
              <li class="flex items-start">
                <span class="text-blue-500 mr-2 mt-1">•</span>
                <span><strong>Varianza</strong> - Por qué las rachas no significan habilidad</span>
              </li>
            </ul>
          </div>
          
          <div class="education-card group">
            <div class="text-5xl mb-6 education-icon">🧠</div>
            <h3 class="text-2xl font-bold text-red-800 mb-4">Sesgos Mentales</h3>
            <ul class="text-red-700 space-y-3">
              <li class="flex items-start">
                <span class="text-red-500 mr-2 mt-1">•</span>
                <span><strong>Sesgo de confirmación</strong> - Solo recuerdas los aciertos</span>
              </li>
              <li class="flex items-start">
                <span class="text-red-500 mr-2 mt-1">•</span>
                <span><strong>Survival bias</strong> - Solo oyes de los ganadores</span>
              </li>
              <li class="flex items-start">
                <span class="text-red-500 mr-2 mt-1">•</span>
                <span><strong>Gamblers fallacy</strong> - "Esta vez será diferente"</span>
              </li>
              <li class="flex items-start">
                <span class="text-red-500 mr-2 mt-1">•</span>
                <span><strong>Overconfidence</strong> - Sobreestimar tu habilidad</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-16 sm:py-20 bg-gradient-to-r from-green-600 via-blue-600 to-green-700 relative overflow-hidden">
    <!-- Background effects -->
    <div class="absolute inset-0 bg-black/10"></div>
    <div class="absolute inset-0 opacity-20">
      <div class="floating-cta-shapes">
        <div class="cta-shape cta-shape-1"></div>
        <div class="cta-shape cta-shape-2"></div>
        <div class="cta-shape cta-shape-3"></div>
      </div>
    </div>
    
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white mb-8 fade-in-up">
          🎯 Usa Los 3 Simuladores
        </h2>
        <p class="text-xl md:text-2xl text-green-100 mb-12 leading-relaxed fade-in-up-delayed">
          No arriesgues dinero real. Usa nuestros simuladores para entender las matemáticas 
          y los sesgos psicológicos antes de apostar tu dinero real.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 max-w-3xl mx-auto staggered-fade-in">
          <a 
            href={getUrl('/sports/season-simulator')} 
            class="cta-button bg-white hover:bg-gray-100 text-green-600"
          >
            📊 Ilusión
          </a>
          <a 
            href={getUrl('/sports/streak-simulator')} 
            class="cta-button bg-green-700 hover:bg-green-800 text-white"
          >
            📈 Rachas
          </a>
          <a 
            href={getUrl('/sports/bankroll-manager')} 
            class="cta-button bg-green-600 hover:bg-green-700 text-white"
          >
            💰 Bankroll
          </a>
        </div>
      </div>
    </div>
  </section>

</MainLayout>

<style>
  /* Typing Animation for Sports */
  .typing-sports {
    animation: typing-sports 2.5s ease-in-out;
  }
  
  .sports-title-animation {
    animation: fadeInUp 1s ease-out;
  }
  
  @keyframes typing-sports {
    0% { 
      opacity: 0;
      transform: translateX(-20px);
    }
    100% { 
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Glow text effect */
  .glow-text {
    text-shadow: 0 0 20px rgba(253, 224, 71, 0.6);
  }

  /* Staggered Animations */
  .staggered-fade-in {
    animation: fadeInUp 1s ease-out 0.5s both;
  }
  
  .staggered-fade-in-delayed {
    animation: fadeInUp 1s ease-out 1s both;
  }
  
  .fade-in-up {
    animation: fadeInUp 1s ease-out;
  }
  
  .fade-in-up-delayed {
    animation: fadeInUp 1s ease-out 0.3s both;
  }
  
  @keyframes fadeInUp {
    0% {
      opacity: 0;
      transform: translateY(40px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Hero Info Box */
  .hero-info-box {
    animation: fadeInUp 1s ease-out 1.5s both;
  }

  /* Floating Sports Shapes */
  .floating-sports-shapes {
    position: absolute;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  
  .sports-shape {
    position: absolute;
    font-size: 2rem;
    opacity: 0.12;
    animation: float-sports 12s ease-in-out infinite;
  }
  
  .sports-shape-1 {
    top: 10%;
    left: 8%;
    animation-delay: 0s;
  }
  
  .sports-shape-2 {
    top: 25%;
    right: 12%;
    animation-delay: 1.5s;
  }
  
  .sports-shape-3 {
    bottom: 35%;
    left: 15%;
    animation-delay: 3s;
  }
  
  .sports-shape-4 {
    top: 55%;
    right: 20%;
    animation-delay: 4.5s;
  }
  
