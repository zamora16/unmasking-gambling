---
import MainLayout from '../../layouts/MainLayout.astro';
import { getUrl } from '../../utils/links';
---

<MainLayout 
  title="Simuladores de Slots" 
  description="Aprende sobre las máquinas tragaperras, el RTP y cómo funcionan realmente los algoritmos de casino."
>
  
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-indigo-600 via-purple-700 to-indigo-800 text-white overflow-hidden">
    <!-- Animated Background Elements -->
    <div class="absolute inset-0 overflow-hidden">
      <!-- Gradient overlay -->
      <div class="absolute inset-0 bg-gradient-to-br from-indigo-900/30 via-purple-900/50 to-indigo-900/30"></div>
      
      <!-- Floating casino elements -->
      <div class="floating-casino-shapes">
        <div class="casino-shape casino-shape-1">🎰</div>
        <div class="casino-shape casino-shape-2">🎲</div>
        <div class="casino-shape casino-shape-3">💰</div>
        <div class="casino-shape casino-shape-4">🍒</div>
        <div class="casino-shape casino-shape-5">🔔</div>
        <div class="casino-shape casino-shape-6">⭐</div>
      </div>
      
      <!-- Animated grid pattern -->
      <div class="absolute inset-0 opacity-5">
        <div class="slots-grid-pattern"></div>
      </div>
    </div>

    <div class="relative container mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 md:py-24 lg:py-32 text-center z-10">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold mb-8 slots-title-animation">
          <span class="inline-block">🎰</span>
          <span class="typing-slots ml-4">Máquinas Tragaperras</span>
        </h1>
        <div class="staggered-fade-in">
          <p class="text-lg sm:text-xl md:text-2xl lg:text-3xl mb-8 text-indigo-100 leading-relaxed">
            Descubre cómo funcionan realmente las slots y por qué 
            <span class="text-yellow-300 font-semibold glow-text">la casa siempre gana</span>
          </p>
        </div>
        
        <!-- Quick stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-12 staggered-fade-in-delayed">
          <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4 hover:bg-white/20 transition-all duration-300">
            <div class="text-2xl font-bold counter" data-target="95">0</div>
            <div class="text-sm text-indigo-200">% RTP Típico</div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4 hover:bg-white/20 transition-all duration-300">
            <div class="text-2xl font-bold counter" data-target="5">0</div>
            <div class="text-sm text-indigo-200">% Ventaja Casa</div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4 hover:bg-white/20 transition-all duration-300">
            <div class="text-2xl font-bold">∞</div>
            <div class="text-sm text-indigo-200">Combinaciones</div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4 hover:bg-white/20 transition-all duration-300">
            <div class="text-2xl font-bold counter" data-target="0">0</div>
            <div class="text-sm text-indigo-200">% Predicible</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Navigation Cards -->
  <section class="py-16 sm:py-20 md:py-24 lg:py-32 bg-gradient-to-b from-gray-50 to-white relative overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute top-0 left-0 w-full h-32 bg-gradient-to-b from-indigo-600/5 to-transparent"></div>
    
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-16 lg:mb-24">
        <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 fade-in-up">
          Simuladores 
          <span class="bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent">
            Interactivos
          </span>
        </h2>
        <p class="text-xl md:text-2xl text-gray-600 max-w-4xl mx-auto leading-relaxed fade-in-up-delayed">
          Herramientas prácticas para entender la mecánica de las tragaperras
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
        
        <!-- RTP Simulator - Main Feature -->
        <div class="simulator-card group">
          <div class="simulator-card-header bg-gradient-to-br from-indigo-500 to-purple-600">
            <div class="simulator-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
              </svg>
            </div>
            <div class="absolute top-4 right-4 bg-green-400 text-green-900 px-3 py-1 rounded-full text-sm font-bold popular-badge">
              POPULAR
            </div>
          </div>
          <div class="simulator-card-content">
            <h3 class="text-2xl font-bold text-gray-900 mb-4">Simulador RTP</h3>
            <p class="text-gray-600 mb-6 leading-relaxed">
              Experimenta con diferentes configuraciones de RTP y entiende por qué las matemáticas favorecen al casino.
            </p>
            <div class="mb-6 flex flex-wrap gap-2">
              <span class="tag tag-indigo">Interactivo</span>
              <span class="tag tag-purple">Gráficos</span>
              <span class="tag tag-green">Educativo</span>
            </div>
            <a 
              href={getUrl('/slots/rtp')} 
              class="simulator-link bg-gradient-to-r from-indigo-600 to-purple-600 hover:from-indigo-700 hover:to-purple-700"
            >
              Probar Simulador
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Volatility Analyzer -->
        <div class="simulator-card group">
          <div class="simulator-card-header bg-gradient-to-br from-orange-400 to-red-500">
            <div class="simulator-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
              </svg>
            </div>
            <div class="absolute top-4 right-4 bg-yellow-400 text-yellow-900 px-3 py-1 rounded-full text-sm font-bold new-badge">
              NUEVO
            </div>
          </div>
          <div class="simulator-card-content">
            <h3 class="text-2xl font-bold text-gray-900 mb-4">Analizador de Volatilidad</h3>
            <p class="text-gray-600 mb-6 leading-relaxed">
              Comprende la diferencia entre alta y baja volatilidad en las tragaperras y cómo afecta tu experiencia.
            </p>
            <div class="mb-6 flex flex-wrap gap-2">
              <span class="tag tag-orange">Comparativo</span>
              <span class="tag tag-red">Gráficos</span>
              <span class="tag tag-yellow">Interactivo</span>
            </div>
            <a 
              href={getUrl('/slots/volatilidad')} 
              class="simulator-link bg-gradient-to-r from-orange-500 to-red-500 hover:from-orange-600 hover:to-red-600"
            >
              Analizar Volatilidad
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Payline Calculator -->
        <div class="simulator-card group">
          <div class="simulator-card-header bg-gradient-to-br from-green-400 to-blue-500">
            <div class="simulator-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01m3 0h.01m0-3h.01m-3 0h.01m3-3h.01m-3 0h.01M5 8a2 2 0 012-2h10a2 2 0 012 2v8a2 2 0 01-2 2H7a2 2 0 01-2-2V8z" />
              </svg>
            </div>
            <div class="absolute top-4 right-4 bg-green-400 text-green-900 px-3 py-1 rounded-full text-sm font-bold new-badge">
              NUEVO
            </div>
          </div>
          <div class="simulator-card-content">
            <h3 class="text-2xl font-bold text-gray-900 mb-4">Calculadora de Líneas</h3>
            <p class="text-gray-600 mb-6 leading-relaxed">
              Analiza cómo las líneas de pago afectan tus probabilidades y coste total por tirada.
            </p>
            <div class="mb-6 flex flex-wrap gap-2">
              <span class="tag tag-green">Calculadora</span>
              <span class="tag tag-blue">Comparativo</span>
              <span class="tag tag-purple">Educativo</span>
            </div>
            <a 
              href={getUrl('/slots/lineas-pago')} 
              class="simulator-link bg-gradient-to-r from-green-500 to-blue-500 hover:from-green-600 hover:to-blue-600"
            >
              Calcular Líneas
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Educational Content -->
  <section class="py-16 sm:py-20 md:py-24 lg:py-32 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-16 lg:mb-24">
          <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 fade-in-up">
            ¿Cómo Funcionan las 
            <span class="bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent">
              Tragaperras?
            </span>
          </h2>
          <p class="text-xl md:text-2xl text-gray-600 fade-in-up-delayed">
            Conoce la ciencia y las matemáticas detrás de las máquinas de casino
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center mb-16 sm:mb-24">
          <div class="fade-in-up">
            <h3 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-6">🎲 Generador de Números Aleatorios (RNG)</h3>
            <p class="text-gray-600 mb-6 text-lg leading-relaxed">
              Cada milisegundo, el RNG genera números completamente aleatorios que determinan el resultado de cada tirada. 
              Esto significa que no hay patrones, no hay "máquinas calientes" y no hay forma de predecir el resultado.
            </p>
            <div class="bg-blue-50 border-l-4 border-blue-400 p-4 rounded">
              <p class="text-gray-700 font-semibold">
                <strong>Realidad:</strong> Tu resultado se decide en el momento exacto en que presionas el botón, 
                no cuando los rodillos se detienen.
              </p>
            </div>
          </div>
          <div class="educational-card fade-in-up-delayed">
            <div class="text-center">
              <div class="text-6xl mb-6 animate-bounce-slow">🎰</div>
              <div class="text-lg text-gray-700 mb-4 font-semibold">Cada giro es independiente</div>
              <div class="text-sm text-gray-500 mb-6">Los resultados anteriores NO afectan los siguientes</div>
              <div class="mt-6 space-y-4">
                <div class="grid grid-cols-3 gap-3">
                  <div class="reel-demo reel-lose">
                    <div class="text-3xl reel-symbol">🍒</div>
                    <div class="text-xs text-gray-600 mt-1">Perdió</div>
                  </div>
                  <div class="reel-demo reel-lose">
                    <div class="text-3xl reel-symbol">🍋</div>
                    <div class="text-xs text-gray-600 mt-1">Perdió</div>
                  </div>
                  <div class="reel-demo reel-win">
                    <div class="text-3xl reel-symbol">💰</div>
                    <div class="text-xs text-yellow-700 font-bold mt-1">¡Ganó!</div>
                  </div>
                </div>
                <div class="text-sm text-gray-500 text-center">
                  Cada resultado es aleatorio - los anteriores NO predicen los siguientes
                </div>
              </div>
              <div class="mt-4 text-sm text-gray-500">
                <div class="flex justify-center items-center gap-2">
                  <span>🎲</span>
                  <span>Cada resultado es 100% aleatorio</span>
                  <span>🎲</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center mb-16 sm:mb-24">
          <div class="educational-card fade-in-up order-2 md:order-1">
            <div class="text-center">
              <div class="text-6xl mb-6">📊</div>
              <div class="text-2xl font-bold text-red-600 mb-4">RTP: <span class="counter" data-target="95">0</span>%</div>
              <div class="text-lg text-gray-600 mb-6">Return to Player</div>
              <div class="rtp-bar">
                <div class="rtp-fill"></div>
              </div>
              <div class="text-sm text-gray-500 mt-4">El casino se queda con 5% garantizado</div>
            </div>
          </div>
          <div class="order-1 md:order-2 fade-in-up-delayed">
            <h3 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-6">📈 Return to Player (RTP)</h3>
            <p class="text-gray-600 mb-6 text-lg leading-relaxed">
              El RTP es el porcentaje del dinero apostado que la máquina devuelve a los jugadores <strong>a muy largo plazo</strong>. 
              Un RTP del 95% significa que por cada €100 apostados, la máquina devuelve €95 en premios.
            </p>
            <div class="bg-orange-50 border-l-4 border-orange-400 p-4 rounded">
              <p class="text-gray-700 font-semibold">
                <strong>Importante:</strong> Esto es una media estadística de millones de tiradas. 
                En el corto plazo, puedes ganar mucho o perder todo.
              </p>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
          <div class="fade-in-up">
            <h3 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-6">⚡ Volatilidad</h3>
            <p class="text-gray-600 mb-6 text-lg leading-relaxed">
              La volatilidad determina la frecuencia y el tamaño de los premios:
            </p>
            <ul class="text-gray-600 space-y-3 text-lg">
              <li class="flex items-center"><span class="text-green-500 mr-2">✓</span><strong>Baja volatilidad:</strong> Premios pequeños y frecuentes</li>
              <li class="flex items-center"><span class="text-red-500 mr-2">⚠</span><strong>Alta volatilidad:</strong> Premios grandes pero muy raros</li>
            </ul>
            <div class="bg-red-50 border-l-4 border-red-400 p-4 rounded mt-6">
              <p class="text-gray-700 font-semibold">
                <strong>Truco psicológico:</strong> Las máquinas de alta volatilidad crean más emoción 
                y pueden generar más adicción debido a los "casi premios".
              </p>
            </div>
          </div>
          <div class="educational-card fade-in-up-delayed">
            <div class="space-y-6">
              <div>
                <div class="flex justify-between text-sm mb-2 font-semibold">
                  <span>Baja Volatilidad</span>
                  <span class="text-green-600">Frecuente</span>
                </div>
                <div class="volatility-bar bg-green-200">
                  <div class="volatility-fill bg-green-500 w-[80%]"></div>
                </div>
              </div>
              <div>
                <div class="flex justify-between text-sm mb-2 font-semibold">
                  <span>Alta Volatilidad</span>
                  <span class="text-red-600">Raro</span>
                </div>
                <div class="volatility-bar bg-red-200">
                  <div class="volatility-fill bg-red-500 w-[20%]"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Warning Section -->
  <section class="py-16 sm:py-20 bg-gradient-to-br from-red-50 to-pink-50 relative overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute inset-0 opacity-5">
      <div class="warning-pattern"></div>
    </div>
    
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-6xl mx-auto text-center">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-red-800 mb-8 fade-in-up">
          ⚠️ La Realidad que Debes Conocer
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="warning-card group">
            <div class="text-5xl mb-6 warning-icon">🏠</div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">La Casa Siempre Gana</h3>
            <p class="text-gray-600 leading-relaxed">
              Las matemáticas garantizan que el casino obtenga beneficios. No hay sistema ni estrategia que pueda vencer esto.
            </p>
          </div>
          <div class="warning-card group">
            <div class="text-5xl mb-6 warning-icon">🧠</div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">Diseñadas para Adicción</h3>
            <p class="text-gray-600 leading-relaxed">
              Sonidos, luces y "casi premios" están diseñados para liberar dopamina y mantenerte jugando.
            </p>
          </div>
          <div class="warning-card group">
            <div class="text-5xl mb-6 warning-icon">💸</div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">Nunca una Inversión</h3>
            <p class="text-gray-600 leading-relaxed">
              El juego debe ser entretenimiento, nunca una forma de ganar dinero o solucionar problemas financieros.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

</MainLayout>

<style>
  /* Typing Animation for Slots */
  .typing-slots {
    animation: typing-slots 2s ease-in-out;
  }
  
  .slots-title-animation {
    animation: fadeInUp 1s ease-out;
  }
  
  @keyframes typing-slots {
    0% { 
      opacity: 0;
      transform: translateX(-20px);
    }
    100% { 
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Glow text effect */
  .glow-text {
    text-shadow: 0 0 20px rgba(253, 224, 71, 0.5);
  }

  /* Staggered Animations */
  .staggered-fade-in {
    animation: fadeInUp 1s ease-out 0.5s both;
  }
  
  .staggered-fade-in-delayed {
    animation: fadeInUp 1s ease-out 1s both;
  }
  
  .fade-in-up {
    animation: fadeInUp 1s ease-out;
  }
  
  .fade-in-up-delayed {
    animation: fadeInUp 1s ease-out 0.3s both;
  }
  
  @keyframes fadeInUp {
    0% {
      opacity: 0;
      transform: translateY(40px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Floating Casino Shapes */
  .floating-casino-shapes {
    position: absolute;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  
  .casino-shape {
    position: absolute;
    font-size: 2rem;
    opacity: 0.1;
    animation: float-casino 8s ease-in-out infinite;
  }
  
  .casino-shape-1 {
    top: 10%;
    left: 10%;
    animation-delay: 0s;
  }
  
  .casino-shape-2 {
    top: 20%;
    right: 15%;
    animation-delay: 1s;
  }
  
  .casino-shape-3 {
    bottom: 30%;
    left: 20%;
    animation-delay: 2s;
  }
  
  .casino-shape-4 {
    top: 60%;
    right: 25%;
    animation-delay: 3s;
  }
  
  .casino-shape-5 {
    bottom: 20%;
    right: 10%;
    animation-delay: 4s;
  }
  
  .casino-shape-6 {
    top: 30%;
    left: 70%;
    animation-delay: 5s;
  }
  
  @keyframes float-casino {
    0%, 100% { 
      transform: translateY(0) rotate(0deg); 
      opacity: 0.1;
    }
    50% { 
      transform: translateY(-30px) rotate(180deg); 
      opacity: 0.2;
    }
  }

  /* Grid Pattern */
  .slots-grid-pattern {
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.1) 1px, transparent 1px);
    background-size: 30px 30px;
    width: 100%;
    height: 100%;
    animation: grid-move-slots 15s linear infinite;
  }
  
  @keyframes grid-move-slots {
    0% { transform: translate(0, 0); }
    100% { transform: translate(30px, 30px); }
  }

  /* Counter Animation */
  .counter {
    transition: all 0.5s ease;
  }

  /* Simulator Cards */
  .simulator-card {
    background: white;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    transition: all 0.5s ease;
    animation: fadeInUp 0.8s ease-out;
  }
  
  .simulator-card:nth-child(1) { animation-delay: 0.1s; }
  .simulator-card:nth-child(2) { animation-delay: 0.2s; }
  .simulator-card:nth-child(3) { animation-delay: 0.3s; }
  
  .simulator-card:hover {
    transform: translateY(-15px) scale(1.02);
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.15);
  }
  
  .simulator-card-header {
    height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  
  .simulator-card-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(45deg, rgba(255, 255, 255, 0.15), transparent);
    transform: translateX(-100%);
    transition: transform 0.6s ease;
  }
  
  .simulator-card:hover .simulator-card-header::before {
