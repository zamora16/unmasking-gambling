---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout 
  title="Calculadora de Probabilidades de Lotería" 
  description="Calcula las probabilidades reales de ganar en diferentes loterías y compáralas con eventos cotidianos."
>
  
  <!-- Hero Section -->
  <section class="bg-gradient-to-br from-purple-600 via-indigo-600 to-purple-800 text-white py-20">
    <div class="container mx-auto px-4 text-center">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl md:text-6xl font-bold mb-6">
          🎯 Calculadora de Probabilidades
        </h1>
        <p class="text-xl md:text-2xl mb-8 text-purple-100">
          Descubre las probabilidades reales y compáralas con 
          <span class="text-yellow-300 font-semibold">eventos de la vida real</span>
        </p>
      </div>
    </div>
  </section>

  <!-- Main Calculator Section -->
  <section class="py-20 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        
        <!-- Lottery Type Selector -->
        <div class="bg-white rounded-xl shadow-lg p-8 mb-8">
          <h2 class="text-3xl font-bold text-gray-900 mb-6 text-center">Selecciona el Tipo de Lotería</h2>
          
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
            <button id="btn-6-49" class="lottery-btn bg-purple-500 hover:bg-purple-600 text-white p-4 rounded-lg transition-all duration-200 transform hover:scale-105">
              <div class="text-lg font-bold">6/49</div>
              <div class="text-sm opacity-90">Lotería Nacional</div>
            </button>
            <button id="btn-euromillions" class="lottery-btn bg-indigo-500 hover:bg-indigo-600 text-white p-4 rounded-lg transition-all duration-200 transform hover:scale-105">
              <div class="text-lg font-bold">5/50 + 2</div>
              <div class="text-sm opacity-90">Euromillones</div>
            </button>
            <button id="btn-powerball" class="lottery-btn bg-pink-500 hover:bg-pink-600 text-white p-4 rounded-lg transition-all duration-200 transform hover:scale-105">
              <div class="text-lg font-bold">5/69 + 1/26</div>
              <div class="text-sm opacity-90">Powerball</div>
            </button>
            <button id="btn-custom" class="lottery-btn bg-gray-500 hover:bg-gray-600 text-white p-4 rounded-lg transition-all duration-200 transform hover:scale-105">
              <div class="text-lg font-bold">Personalizar</div>
              <div class="text-sm opacity-90">Tu configuración</div>
            </button>
          </div>

          <!-- Custom Lottery Settings -->
          <div id="customSettings" class="hidden">
            <div class="bg-gray-50 p-6 rounded-lg mb-6">
              <h3 class="text-xl font-bold text-gray-900 mb-4">Configuración Personalizada</h3>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Números principales</label>
                  <div class="flex space-x-2">
                    <input type="number" id="mainNumbers" min="1" max="10" value="6" class="w-16 px-3 py-2 border border-gray-300 rounded-md">
                    <span class="self-center text-gray-600">números de</span>
                    <input type="number" id="mainPool" min="10" max="100" value="49" class="w-16 px-3 py-2 border border-gray-300 rounded-md">
                  </div>
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">Números bonus (opcional)</label>
                  <div class="flex space-x-2">
                    <input type="number" id="bonusNumbers" min="0" max="5" value="0" class="w-16 px-3 py-2 border border-gray-300 rounded-md">
                    <span class="self-center text-gray-600">números de</span>
                    <input type="number" id="bonusPool" min="0" max="100" value="0" class="w-16 px-3 py-2 border border-gray-300 rounded-md">
                  </div>
                </div>
              </div>
              <button id="btn-calculate-custom" class="mt-4 bg-purple-600 hover:bg-purple-700 text-white px-6 py-2 rounded-lg">
                Calcular Probabilidades
              </button>
            </div>
          </div>
        </div>

        <!-- Results Section -->
        <div id="resultsSection" class="hidden">
          
          <!-- Main Result -->
          <div class="bg-white rounded-xl shadow-lg p-8 mb-8">
            <div class="text-center">
              <h3 class="text-2xl font-bold text-gray-900 mb-4">Probabilidad de Ganar el Premio Mayor</h3>
              <div id="mainProbability" class="text-6xl font-bold text-red-600 mb-4">
                1 en 14,000,000
              </div>
              <div id="percentageProbability" class="text-xl text-gray-600 mb-6">
                0.000007% de probabilidad
              </div>
              <div class="bg-red-50 p-4 rounded-lg">
                <p id="timeToWin" class="text-lg text-red-800">
                  Si compras 1 billete cada semana, estadísticamente tardarías <strong>269,230 años</strong> en ganar.
                </p>
