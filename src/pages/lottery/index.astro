---
import MainLayout from '../../layouts/MainLayout.astro';
import { getUrl } from '../../utils/links';
---

<MainLayout 
  title="Simuladores de Loterías" 
  description="Aprende sobre las loterías, rascas y probabilidades reales. Descubre por qué las matemáticas no están de tu lado."
>
  
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-br from-purple-600 via-pink-700 to-purple-800 text-white overflow-hidden">
    <!-- Animated Background Elements -->
    <div class="absolute inset-0 overflow-hidden">
      <!-- Gradient overlay -->
      <div class="absolute inset-0 bg-gradient-to-br from-purple-900/30 via-pink-900/50 to-purple-900/30"></div>
      
      <!-- Floating lottery elements -->
      <div class="floating-lottery-shapes">
        <div class="lottery-shape lottery-shape-1">🎟️</div>
        <div class="lottery-shape lottery-shape-2">🎫</div>
        <div class="lottery-shape lottery-shape-3">💰</div>
        <div class="lottery-shape lottery-shape-4">🎯</div>
        <div class="lottery-shape lottery-shape-5">🍀</div>
        <div class="lottery-shape lottery-shape-6">⭐</div>
        <div class="lottery-shape lottery-shape-7">🔢</div>
        <div class="lottery-shape lottery-shape-8">💎</div>
      </div>
      
      <!-- Animated numbers pattern -->
      <div class="absolute inset-0 opacity-5">
        <div class="lottery-numbers-pattern"></div>
      </div>
    </div>

    <div class="relative container mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 md:py-24 lg:py-32 text-center z-10">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold mb-8 lottery-title-animation">
          <span class="inline-block">🎟️</span>
          <span class="typing-lottery ml-4">Loterías y Rascas</span>
        </h1>
        <div class="staggered-fade-in">
          <p class="text-lg sm:text-xl md:text-2xl lg:text-3xl mb-8 text-purple-100 leading-relaxed">
            Descubre las probabilidades reales y por qué 
            <span class="text-yellow-300 font-semibold glow-text">las matemáticas no mienten</span>
          </p>
        </div>
        
        <!-- Quick stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-12 staggered-fade-in-delayed">
          <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4 hover:bg-white/20 transition-all duration-300">
            <div class="text-2xl font-bold">1:<span class="counter" data-target="14">0</span>M</div>
            <div class="text-sm text-purple-200">Probabilidad</div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4 hover:bg-white/20 transition-all duration-300">
            <div class="text-2xl font-bold counter" data-target="50">0</div>
            <div class="text-sm text-purple-200">% RTP</div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4 hover:bg-white/20 transition-all duration-300">
            <div class="text-2xl font-bold counter" data-target="250">0</div>
            <div class="text-sm text-purple-200">K años espera</div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4 hover:bg-white/20 transition-all duration-300">
            <div class="text-2xl font-bold counter" data-target="0">0</div>
            <div class="text-sm text-purple-200">% Predicible</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Navigation Cards -->
  <section class="py-16 sm:py-20 md:py-24 lg:py-32 bg-gradient-to-b from-gray-50 to-white relative overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute top-0 left-0 w-full h-32 bg-gradient-to-b from-purple-600/5 to-transparent"></div>
    
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-16 lg:mb-24">
        <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 fade-in-up">
          Calculadoras 
          <span class="bg-gradient-to-r from-purple-600 to-pink-600 bg-clip-text text-transparent">
            Reveladoras
          </span>
        </h2>
        <p class="text-xl md:text-2xl text-gray-600 max-w-4xl mx-auto leading-relaxed fade-in-up-delayed">
          Herramientas que te muestran la verdad matemática detrás de loterías y rascas
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
        
        <!-- Probability Calculator - Main Feature -->
        <div class="lottery-card group">
          <div class="lottery-card-header bg-gradient-to-br from-purple-500 to-pink-600">
            <div class="lottery-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01m3 0h.01m0-3h.01m-3 0h.01m3-3h.01m-3 0h.01M5 8a2 2 0 012-2h10a2 2 0 012 2v8a2 2 0 01-2 2H7a2 2 0 01-2-2V8z" />
              </svg>
            </div>
            <div class="absolute top-4 right-4 bg-yellow-400 text-yellow-900 px-3 py-1 rounded-full text-sm font-bold new-badge">
              NUEVO
            </div>
          </div>
          <div class="lottery-card-content">
            <h3 class="text-2xl font-bold text-gray-900 mb-4">Calculadora de Probabilidades</h3>
            <p class="text-gray-600 mb-6 leading-relaxed">
              Calcula las probabilidades reales de ganar en diferentes tipos de lotería y compáralas con eventos cotidianos.
            </p>
            <div class="mb-6 flex flex-wrap gap-2">
              <span class="tag tag-purple">Calculadora</span>
              <span class="tag tag-pink">Comparativo</span>
              <span class="tag tag-yellow">Educativo</span>
            </div>
            <a 
              href={getUrl('/lottery/probability-calculator')} 
              class="lottery-link bg-gradient-to-r from-purple-600 to-pink-600 hover:from-purple-700 hover:to-pink-700"
            >
              Calcular Probabilidades
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Scratch Cards Simulator -->
        <div class="lottery-card group">
          <div class="lottery-card-header bg-gradient-to-br from-green-400 to-blue-500">
            <div class="lottery-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
              </svg>
            </div>
            <div class="absolute top-4 right-4 bg-green-400 text-green-900 px-3 py-1 rounded-full text-sm font-bold popular-badge">
              POPULAR
            </div>
          </div>
          <div class="lottery-card-content">
            <h3 class="text-2xl font-bold text-gray-900 mb-4">Simulador de Rascas</h3>
            <p class="text-gray-600 mb-6 leading-relaxed">
              Simula la compra de múltiples rascas del mismo lote y descubre cómo están distribuidos los premios.
            </p>
            <div class="mb-6 flex flex-wrap gap-2">
              <span class="tag tag-green">Simulador</span>
              <span class="tag tag-blue">Interactivo</span>
              <span class="tag tag-orange">Visual</span>
            </div>
            <a 
              href={getUrl('/lottery/scratch-cards')} 
              class="lottery-link bg-gradient-to-r from-green-500 to-blue-500 hover:from-green-600 hover:to-blue-600"
            >
              Simular Rascas
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Expected Value Calculator -->
        <div class="lottery-card group">
          <div class="lottery-card-header bg-gradient-to-br from-orange-400 to-red-500">
            <div class="lottery-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div class="absolute top-4 right-4 bg-orange-400 text-orange-900 px-3 py-1 rounded-full text-sm font-bold new-badge">
              NUEVO
            </div>
          </div>
          <div class="lottery-card-content">
            <h3 class="text-2xl font-bold text-gray-900 mb-4">Calculadora de Valor Esperado</h3>
            <p class="text-gray-600 mb-6 leading-relaxed">
              Calcula cuánto dinero pierdes realmente por cada euro que gastas en lotería y compáralo con alternativas.
            </p>
            <div class="mb-6 flex flex-wrap gap-2">
              <span class="tag tag-orange">Matemático</span>
              <span class="tag tag-red">Revelador</span>
              <span class="tag tag-purple">Educativo</span>
            </div>
            <a 
              href={getUrl('/lottery/expected-value')} 
              class="lottery-link bg-gradient-to-r from-orange-500 to-red-500 hover:from-orange-600 hover:to-red-600"
            >
              Calcular Valor Esperado
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Educational Content -->
  <section class="py-16 sm:py-20 md:py-24 lg:py-32 bg-white">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-16 lg:mb-24">
          <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 fade-in-up">
            ¿Cómo Funcionan las 
            <span class="bg-gradient-to-r from-purple-600 to-pink-600 bg-clip-text text-transparent">
              Loterías?
            </span>
          </h2>
          <p class="text-xl md:text-2xl text-gray-600 fade-in-up-delayed">
            La verdad matemática detrás de los billetes y los sueños
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center mb-16 sm:mb-24">
          <div class="fade-in-up">
            <h3 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-6">🎯 Probabilidades Extremas</h3>
            <p class="text-gray-600 mb-6 text-lg leading-relaxed">
              La probabilidad de ganar una lotería típica (como 6/49) es de aproximadamente 1 entre 14 millones. 
              Esto significa que tienes más probabilidades de ser alcanzado por un rayo múltiples veces.
            </p>
            <div class="bg-blue-50 border-l-4 border-blue-400 p-4 rounded">
              <p class="text-gray-700 font-semibold">
                <strong>Perspectiva:</strong> Si compraras un billete cada semana, estadísticamente tardarías 
                más de 250,000 años en ganar el premio mayor.
              </p>
            </div>
          </div>
          <div class="educational-card fade-in-up-delayed">
            <div class="text-center">
              <div class="text-6xl mb-6 animate-pulse-slow">⚡</div>
              <div class="comparison-container">
                <div class="comparison-item">
                  <div class="text-sm text-gray-600 mb-2">Probabilidad de ser alcanzado por un rayo</div>
                  <div class="text-xl font-bold text-blue-600">1 en 1,000,000</div>
                </div>
                <div class="comparison-vs">VS</div>
                <div class="comparison-item">
                  <div class="text-sm text-gray-600 mb-2">Probabilidad de ganar la lotería</div>
                  <div class="text-xl font-bold text-red-600">1 en <span class="counter" data-target="14">0</span>,000,000</div>
                </div>
              </div>
              <div class="mt-6 text-sm text-gray-500">
                <span class="inline-block bg-red-100 text-red-700 px-3 py-1 rounded-full">
                  14 veces menos probable que un rayo
                </span>
              </div>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center mb-16 sm:mb-24">
          <div class="educational-card fade-in-up order-2 md:order-1">
            <div class="text-center">
              <div class="text-6xl mb-6">💸</div>
              <div class="text-2xl font-bold text-red-600 mb-4">RTP: <span class="counter" data-target="50">0</span>%</div>
              <div class="text-lg text-gray-600 mb-6">Return to Player</div>
              <div class="rtp-bar-lottery">
                <div class="rtp-fill-lottery"></div>
              </div>
              <div class="text-sm text-gray-500 mt-4">El peor RTP de todos los juegos</div>
              <div class="mt-4 text-xs text-gray-400">
                Por cada €2 que gastas, pierdes €1 automáticamente
              </div>
            </div>
          </div>
          <div class="order-1 md:order-2 fade-in-up-delayed">
            <h3 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-6">📉 Valor Esperado Negativo</h3>
            <p class="text-gray-600 mb-6 text-lg leading-relaxed">
              Las loterías tienen el peor RTP (Return to Player) de todos los juegos de azar, típicamente entre 40-50%. 
              Esto significa que por cada €1 que gastas, solo recuperas €0.50 en premios.
            </p>
            <div class="bg-orange-50 border-l-4 border-orange-400 p-4 rounded">
              <p class="text-gray-700 font-semibold">
                <strong>En otras palabras:</strong> Cada billete que compras pierde automáticamente la mitad de su valor.
              </p>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
          <div class="fade-in-up">
            <h3 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-6">🎫 Rascas y Ganas</h3>
            <p class="text-gray-600 mb-6 text-lg leading-relaxed">
              Los rascas son especialmente engañosos porque dan la sensación de control e inmediatez. 
              Cada "lote" tiene un número fijo de premios distribuidos aleatoriamente.
            </p>
            <ul class="text-gray-600 space-y-3 text-lg">
              <li class="flex items-center"><span class="text-red-500 mr-2">⚠</span><strong>Premio mayor:</strong> Solo 1 o 2 por lote completo</li>
              <li class="flex items-center"><span class="text-yellow-500 mr-2">⚠</span><strong>Premios menores:</strong> Distribuidos para crear "falsas esperanzas"</li>
              <li class="flex items-center"><span class="text-red-500 mr-2">❌</span><strong>Pérdidas garantizadas:</strong> 70-80% de los billetes no tienen premio</li>
            </ul>
          </div>
          <div class="educational-card fade-in-up-delayed">
            <div class="text-center">
              <div class="text-4xl mb-4">🎫</div>
              <div class="text-lg font-semibold mb-6">Lote de 1000 rascas</div>
              <div class="space-y-4">
                <div class="scratch-distribution">
                  <div class="flex justify-between text-sm mb-2">
                    <span>Premios mayores</span>
                    <span class="font-bold">2 billetes</span>
                  </div>
                  <div class="scratch-bar bg-green-200">
                    <div class="scratch-fill bg-green-500 w-[0.2%]"></div>
                  </div>
                </div>
                <div class="scratch-distribution">
                  <div class="flex justify-between text-sm mb-2">
                    <span>Premios menores</span>
                    <span class="font-bold">150 billetes</span>
                  </div>
                  <div class="scratch-bar bg-yellow-200">
                    <div class="scratch-fill bg-yellow-500 w-[15%]"></div>
                  </div>
                </div>
                <div class="scratch-distribution">
                  <div class="flex justify-between text-sm mb-2">
                    <span>Sin premio</span>
                    <span class="font-bold">848 billetes</span>
                  </div>
                  <div class="scratch-bar bg-red-200">
                    <div class="scratch-fill bg-red-500 w-[85%]"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Psychological Tricks Section -->
  <section class="py-16 sm:py-20 md:py-24 bg-gradient-to-br from-gray-50 to-gray-100 relative overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute inset-0 opacity-5">
      <div class="psychology-pattern"></div>
    </div>
    
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16 lg:mb-24">
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-6 fade-in-up">
            🧠 Trucos 
            <span class="bg-gradient-to-r from-purple-600 to-pink-600 bg-clip-text text-transparent">
              Psicológicos
            </span>
          </h2>
          <p class="text-xl md:text-2xl text-gray-600 fade-in-up-delayed">
            Cómo las loterías manipulan tu mente para seguir jugando
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="psychology-card group">
            <div class="text-5xl mb-6 psychology-icon">🔢</div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">"Números de la Suerte"</h3>
            <p class="text-gray-600 leading-relaxed">
              No existen números con más probabilidad de salir. Cada combinación tiene exactamente 
              las mismas probabilidades, pero nuestro cerebro busca patrones donde no los hay.
            </p>
          </div>

          <div class="psychology-card group">
            <div class="text-5xl mb-6 psychology-icon">📺</div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">Sesgo del Superviviente</h3>
            <p class="text-gray-600 leading-relaxed">
              Solo vemos a los ganadores en los medios, no a los millones que perdieron. 
              Esto crea una falsa sensación de que ganar es más común de lo que realmente es.
            </p>
          </div>

          <div class="psychology-card group">
            <div class="text-5xl mb-6 psychology-icon">🎯</div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">"Casi Gané"</h3>
            <p class="text-gray-600 leading-relaxed">
              Tener números cercanos a los ganadores no significa nada, pero activa las mismas 
              áreas del cerebro que una victoria real, manteniéndote enganchado.
            </p>
          </div>

          <div class="psychology-card group">
            <div class="text-5xl mb-6 psychology-icon">🔄</div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">Falacia del Jugador</h3>
            <p class="text-gray-600 leading-relaxed">
              Creer que los números que no han salido tienen más probabilidad de salir. 
              Cada sorteo es independiente, no hay "números que deben salir".
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Warning Section -->
  <section class="py-16 sm:py-20 bg-gradient-to-br from-red-50 to-pink-50 relative overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute inset-0 opacity-5">
      <div class="warning-pattern"></div>
    </div>
    
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-6xl mx-auto text-center">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-red-800 mb-8 fade-in-up">
          ⚠️ La Realidad Matemática
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="warning-card group">
            <div class="text-5xl mb-6 warning-icon">📚</div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">Impuesto a la Ignorancia</h3>
            <p class="text-gray-600 leading-relaxed">
              Las loterías son llamadas "impuesto a los que no saben matemáticas" por una razón: 
              las probabilidades están completamente en tu contra.
            </p>
          </div>
          <div class="warning-card group">
            <div class="text-5xl mb-6 warning-icon">💰</div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">Peor "Inversión" Posible</h3>
            <p class="text-gray-600 leading-relaxed">
              Con un RTP del 50%, las loterías son la peor forma posible de "invertir" tu dinero. 
              Incluso los casinos ofrecen mejores probabilidades.
            </p>
          </div>
          <div class="warning-card group">
            <div class="text-5xl mb-6 warning-icon">🎯</div>
            <h3 class="text-xl font-bold text-gray-900 mb-4">Matemáticas Inmutables</h3>
            <p class="text-gray-600 leading-relaxed">
              No hay sistema, estrategia o "método" que pueda cambiar las probabilidades. 
              Las matemáticas no mienten, no negocian y no hacen excepciones.
            </p>
          </div>
        </div>
        <div class="mt-12 p-6 bg-yellow-100 rounded-xl lottery-alternative">
          <p class="text-lg text-yellow-800">
            <strong>💡 Alternativa inteligente:</strong> Ese dinero que gastas en lotería cada semana, 
            inviértelo en un fondo de inversión. En 20 años tendrás un "premio" garantizado.
          </p>
        </div>
      </div>
    </div>
  </section>

</MainLayout>

<style>
  /* Typing Animation for Lottery */
  .typing-lottery {
    animation: typing-lottery 2.5s ease-in-out;
  }
  
  .lottery-title-animation {
    animation: fadeInUp 1s ease-out;
  }
  
  @keyframes typing-lottery {
    0% { 
      opacity: 0;
      transform: translateX(-20px);
    }
    100% { 
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Glow text effect */
  .glow-text {
    text-shadow: 0 0 20px rgba(253, 224, 71, 0.6);
  }

  /* Staggered Animations */
