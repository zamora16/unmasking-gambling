---
import MainLayout from '../layouts/MainLayout.astro';
import { getUrl } from '../utils/links';
---

<MainLayout title="Inicio" description="Descubre los secretos detrás de las máquinas tragaperras y aprende sobre juego responsable con Unmasking Gambling.">
  
  <!-- Hero Section -->
  <section class="relative min-h-screen bg-gradient-to-br from-slate-900 via-purple-900 to-slate-800 text-white overflow-hidden flex items-center">
    <!-- Animated Background Elements -->
    <div class="absolute inset-0 overflow-hidden">
      <!-- Gradient overlay -->
      <div class="absolute inset-0 bg-gradient-to-br from-indigo-900/50 via-purple-900/70 to-slate-900/80"></div>
      
      <!-- Floating geometric shapes -->
      <div class="floating-shapes">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
        <div class="shape shape-4"></div>
        <div class="shape shape-5"></div>
        <div class="shape shape-6"></div>
      </div>
      
      <!-- Animated grid pattern -->
      <div class="absolute inset-0 opacity-10">
        <div class="grid-pattern"></div>
      </div>
    </div>
    
    <div class="relative container mx-auto px-4 sm:px-6 lg:px-8 py-12 z-10">
      <div class="max-w-5xl mx-auto text-center">
        <!-- Main Title with typing animation -->
        <div class="mb-8">
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl font-bold mb-6">
            <span class="typing-animation bg-gradient-to-r from-yellow-400 via-orange-400 to-yellow-300 bg-clip-text text-transparent">
              Unmasking
            </span>
            <br />
            <span class="typing-animation-delayed text-white">
              Gambling
            </span>
          </h1>
        </div>
        
        <!-- Subtitle with staggered animation -->
        <div class="staggered-fade-in mb-10">
          <p class="text-xl sm:text-2xl md:text-3xl lg:text-4xl text-gray-200 leading-relaxed font-light">
            Descubre los secretos detrás de las máquinas tragaperras
          </p>
          <p class="text-lg sm:text-xl md:text-2xl lg:text-3xl mt-2 text-yellow-400 font-semibold">
            y aprende sobre juego responsable
          </p>
        </div>
        
        <!-- Call to action buttons -->
        <div class="flex flex-col sm:flex-row gap-6 justify-center items-center staggered-fade-in-delayed">
          <a 
            href={getUrl('/the-way')} 
            class="group inline-flex items-center px-10 py-5 bg-gradient-to-r from-yellow-400 to-orange-500 hover:from-yellow-500 hover:to-orange-600 text-gray-900 font-bold rounded-full transition-all duration-500 shadow-2xl hover:shadow-yellow-400/25 transform hover:scale-105 hover:-translate-y-1"
          >
            <span class="mr-3 text-2xl">🚀</span>
            <span class="text-lg">Comienza tu camino</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 ml-3 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
          <a 
            href={getUrl('/slots')} 
            class="group inline-flex items-center px-10 py-5 bg-white/10 hover:bg-white/20 backdrop-blur-lg border-2 border-white/30 hover:border-white/50 text-white font-semibold rounded-full transition-all duration-500 hover:shadow-2xl hover:shadow-white/10"
          >
            <span class="mr-3 text-2xl">🎰</span>
            <span class="text-lg">Simuladores</span>
          </a>
        </div>
        
        <!-- Scroll indicator -->
        <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
          <div class="w-6 h-10 border-2 border-white/30 rounded-full flex justify-center">
            <div class="w-1 h-3 bg-white/50 rounded-full mt-2 animate-pulse"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Overview -->
  <section class="py-20 lg:py-32 bg-gradient-to-b from-gray-50 to-white relative overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute top-0 left-0 w-full h-32 bg-gradient-to-b from-purple-900/5 to-transparent"></div>
    
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center mb-16 lg:mb-24">
        <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 fade-in-up">
          Herramientas 
          <span class="bg-gradient-to-r from-indigo-600 to-purple-600 bg-clip-text text-transparent">
            Educativas
          </span>
        </h2>
        <p class="text-xl md:text-2xl text-gray-600 max-w-4xl mx-auto leading-relaxed fade-in-up-delayed">
          Explora nuestros simuladores y recursos diseñados para revelar 
          la verdad detrás de los juegos de azar
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
        <!-- Simulador de Slots -->
        <div class="feature-card group">
          <div class="feature-card-header bg-gradient-to-br from-indigo-500 to-purple-600">
            <div class="feature-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01m3 0h.01m0-3h.01m-3 0h.01m3-3h.01m-3 0h.01M5 8a2 2 0 012-2h10a2 2 0 012 2v8a2 2 0 01-2 2H7a2 2 0 01-2-2V8z" />
              </svg>
            </div>
          </div>
          <div class="feature-card-content">
            <h3 class="text-2xl font-bold text-gray-900 mb-4">Simulador de Slots</h3>
            <p class="text-gray-600 mb-6 leading-relaxed">
              Experimenta con diferentes RTPs y entiende por qué la casa siempre gana a largo plazo.
            </p>
            <a 
              href={getUrl('/slots/rtp')} 
              class="feature-link text-indigo-600 hover:text-indigo-800"
            >
              Probar simulador
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- El Camino -->
        <div class="feature-card group">
          <div class="feature-card-header bg-gradient-to-br from-yellow-400 to-orange-500">
            <div class="feature-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
              </svg>
            </div>
          </div>
          <div class="feature-card-content">
            <h3 class="text-2xl font-bold text-gray-900 mb-4">El Camino</h3>
            <p class="text-gray-600 mb-6 leading-relaxed">
              Una guía interactiva de 6 pasos para el juego responsable y la prevención de la adicción.
            </p>
            <a 
              href={getUrl('/the-way')} 
              class="feature-link text-yellow-600 hover:text-yellow-800"
            >
              Iniciar el camino
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Loterías y Rascas -->
        <div class="feature-card group">
          <div class="feature-card-header bg-gradient-to-br from-purple-500 to-pink-600">
            <div class="feature-icon">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
              </svg>
            </div>
          </div>
          <div class="feature-card-content">
            <h3 class="text-2xl font-bold text-gray-900 mb-4">Loterías y Rascas</h3>
            <p class="text-gray-600 mb-6 leading-relaxed">
              Descubre las probabilidades reales de ganar y por qué las matemáticas no están de tu lado.
            </p>
            <a 
              href={getUrl('/lottery')} 
              class="feature-link text-purple-600 hover:text-purple-800"
            >
              Explorar simuladores
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Statistics Section -->
  <section class="py-20 lg:py-32 bg-gradient-to-br from-slate-50 to-gray-100 relative">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16 lg:mb-24">
        <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 fade-in-up">
          La Realidad de los 
          <span class="bg-gradient-to-r from-red-600 to-orange-600 bg-clip-text text-transparent">
            Números
          </span>
        </h2>
        <p class="text-xl md:text-2xl text-gray-600 max-w-4xl mx-auto fade-in-up-delayed">
          Datos que todo jugador debería conocer antes de apostar
        </p>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-12 max-w-6xl mx-auto">
        <div class="stat-card">
          <div class="stat-number text-red-600 counter" data-target="5">0</div>
          <div class="stat-symbol">%</div>
          <h3 class="stat-title">Ventaja de la Casa</h3>
          <p class="stat-description">Promedio de ventaja que tienen los casinos en las tragaperras</p>
        </div>
        
        <div class="stat-card">
          <div class="stat-number text-orange-600 counter" data-target="1.6">0</div>
          <div class="stat-symbol">%</div>
          <h3 class="stat-title">Población Afectada</h3>
          <p class="stat-description">Porcentaje de adultos con problemas de juego patológico</p>
        </div>
        
        <div class="stat-card">
          <div class="stat-number text-indigo-600 counter" data-target="90">0</div>
          <div class="stat-symbol">%</div>
          <h3 class="stat-title">Pérdidas a Largo Plazo</h3>
          <p class="stat-description">De jugadores que pierden dinero en el tiempo</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Call to Action -->
  <section class="py-20 lg:py-32 bg-gradient-to-r from-red-500 via-red-600 to-pink-600 text-white relative overflow-hidden">
    <!-- Background effects -->
    <div class="absolute inset-0 bg-black/10"></div>
    <div class="absolute inset-0 opacity-20">
      <div class="floating-shapes-cta">
        <div class="shape-cta shape-cta-1"></div>
        <div class="shape-cta shape-cta-2"></div>
        <div class="shape-cta shape-cta-3"></div>
      </div>
    </div>
    
    <div class="container mx-auto px-4 text-center relative z-10">
      <h2 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold mb-8 fade-in-up">
        ¿Necesitas Ayuda?
      </h2>
      <p class="text-xl md:text-2xl mb-12 max-w-3xl mx-auto leading-relaxed fade-in-up-delayed">
        Si sientes que el juego está afectando tu vida, no estás solo. 
        Hay recursos disponibles para ayudarte.
      </p>
      <div class="flex flex-col sm:flex-row gap-6 justify-center items-center staggered-fade-in">
        <a 
          href={getUrl('/ayuda')} 
          class="group inline-flex items-center px-10 py-5 bg-white text-red-600 font-bold rounded-full hover:bg-gray-100 transition-all duration-500 shadow-2xl hover:shadow-white/25 transform hover:scale-105 hover:-translate-y-1"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
          <span class="text-lg">Buscar Ayuda</span>
        </a>
        <a 
          href="tel:900200999" 
          class="group inline-flex items-center px-10 py-5 bg-transparent border-2 border-white text-white font-semibold rounded-full hover:bg-white hover:text-red-600 transition-all duration-500 hover:shadow-2xl hover:shadow-white/10"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 mr-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span class="text-lg">Línea de Crisis: 900 200 999</span>
        </a>
      </div>
    </div>
  </section>

</MainLayout>

<style>
  /* Typing Animation */
  .typing-animation {
    background-size: 200% 200%;
    animation: typing 3s ease-in-out, gradient-shift 4s ease-in-out infinite;
  }
  
  .typing-animation-delayed {
    animation: typing 3s ease-in-out 0.5s both;
  }
  
  @keyframes typing {
    0% { 
      opacity: 0;
      transform: translateY(30px);
    }
    100% { 
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes gradient-shift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  /* Staggered Animations */
  .staggered-fade-in {
    animation: fadeInUp 1s ease-out 1s both;
  }
  
  .staggered-fade-in-delayed {
    animation: fadeInUp 1s ease-out 1.5s both;
  }
  
  .fade-in-up {
    animation: fadeInUp 1s ease-out;
  }
  
  .fade-in-up-delayed {
    animation: fadeInUp 1s ease-out 0.3s both;
  }
  
  @keyframes fadeInUp {
    0% {
      opacity: 0;
      transform: translateY(40px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Floating Shapes */
  .floating-shapes {
    position: absolute;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  
  .shape {
    position: absolute;
    background: linear-gradient(45deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
    border-radius: 50%;
    animation: float 6s ease-in-out infinite;
  }
  
  .shape-1 {
    width: 80px;
    height: 80px;
    top: 20%;
    left: 10%;
    animation-delay: 0s;
  }
  
  .shape-2 {
    width: 120px;
    height: 120px;
    top: 60%;
    right: 10%;
    animation-delay: 2s;
  }
  
  .shape-3 {
    width: 60px;
    height: 60px;
    top: 30%;
    right: 25%;
    animation-delay: 4s;
  }
  
  .shape-4 {
    width: 100px;
    height: 100px;
    bottom: 30%;
    left: 15%;
    animation-delay: 1s;
  }
  
  .shape-5 {
    width: 40px;
    height: 40px;
    top: 10%;
    left: 50%;
    animation-delay: 3s;
  }
  
  .shape-6 {
    width: 90px;
    height: 90px;
    bottom: 10%;
    right: 30%;
    animation-delay: 5s;
  }
  
  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    33% { transform: translateY(-30px) rotate(120deg); }
    66% { transform: translateY(20px) rotate(240deg); }
  }

  /* Grid Pattern */
  .grid-pattern {
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.1) 1px, transparent 1px);
    background-size: 50px 50px;
    width: 100%;
    height: 100%;
    animation: grid-move 20s linear infinite;
  }
  
  @keyframes grid-move {
    0% { transform: translate(0, 0); }
    100% { transform: translate(50px, 50px); }
  }

  /* Feature Cards */
  .feature-card {
    background: white;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
    transition: all 0.5s ease;
    animation: fadeInUp 0.8s ease-out;
  }
  
  .feature-card:nth-child(1) { animation-delay: 0.1s; }
  .feature-card:nth-child(2) { animation-delay: 0.2s; }
  .feature-card:nth-child(3) { animation-delay: 0.3s; }
  
  .feature-card:hover {
    transform: translateY(-10px) scale(1.02);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.15);
  }
  
  .feature-card-header {
    height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }
  
  .feature-card-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(45deg, rgba(255, 255, 255, 0.1), transparent);
    transition: transform 0.5s ease;
  }
  
  .feature-card:hover .feature-card-header::before {
    transform: translateX(100%);
  }
  
  .feature-icon {
    transform: scale(1);
    transition: transform 0.3s ease;
  }
  
  .feature-card:hover .feature-icon {
    transform: scale(1.1) rotate(5deg);
  }
  
  .feature-card-content {
    padding: 2rem;
  }
  
  .feature-link {
    display: inline-flex;
    align-items: center;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  /* Statistics */
  .stat-card {
    text-align: center;
    padding: 3rem 2rem;
    background: white;
    border-radius: 20px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
    transition: all 0.5s ease;
    animation: fadeInUp 0.8s ease-out;
  }
  
  .stat-card:nth-child(1) { animation-delay: 0.1s; }
  .stat-card:nth-child(2) { animation-delay: 0.2s; }
  .stat-card:nth-child(3) { animation-delay: 0.3s; }
  
  .stat-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.12);
  }
  
  .stat-number {
    font-size: 4rem;
    font-weight: 900;
    line-height: 1;
    margin-bottom: 0.5rem;
    display: inline-block;
  }
  
  .stat-symbol {
    font-size: 3rem;
    font-weight: 900;
    opacity: 0.7;
    display: inline-block;
    margin-left: 0.2rem;
  }
  
  .stat-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #1f2937;
    margin: 1rem 0;
  }
  
  .stat-description {
    color: #6b7280;
    line-height: 1.6;
  }

  /* CTA Floating Shapes */
  .floating-shapes-cta {
    position: absolute;
    width: 100%;
    height: 100%;
  }
  
  .shape-cta {
    position: absolute;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 50%;
    animation: float-cta 8s ease-in-out infinite;
  }
  
  .shape-cta-1 {
    width: 100px;
    height: 100px;
    top: 20%;
    left: 10%;
    animation-delay: 0s;
  }
  
  .shape-cta-2 {
    width: 60px;
    height: 60px;
    top: 70%;
    right: 15%;
    animation-delay: 2s;
  }
  
  .shape-cta-3 {
    width: 80px;
    height: 80px;
    bottom: 20%;
    left: 70%;
    animation-delay: 4s;
  }
  
  @keyframes float-cta {
    0%, 100% { transform: translateY(0) scale(1); }
    50% { transform: translateY(-20px) scale(1.1); }
  }

  /* Counter Animation */
  .counter {
    transition: all 0.5s ease;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .stat-number {
      font-size: 3rem;
    }
    
    .stat-symbol {
      font-size: 2rem;
    }
    
    .feature-card-content {
      padding: 1.5rem;
    }
  }
</style>

<script>
  // Enhanced intersection observer for animations
  document.addEventListener('DOMContentLoaded', () => {
    // Counter animation
    const counters = document.querySelectorAll('.counter');
    const observerOptions = {
      threshold: 0.5,
      rootMargin: '0px 0px -50px 0px'
    };

    const counterObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const counter = entry.target;
          const target = parseFloat(counter.getAttribute('data-target'));
          const duration = 2000; // 2 seconds
          const start = performance.now();
          
          const animate = (currentTime) => {
            const elapsed = currentTime - start;
            const progress = Math.min(elapsed / duration, 1);
            
            // Easing function for smooth animation
            const easeOutCubic = 1 - Math.pow(1 - progress, 3);
            const current = target * easeOutCubic;
            
            if (target % 1 === 0) {
              counter.textContent = Math.floor(current);
            } else {
              counter.textContent = current.toFixed(1);
            }
            
            if (progress < 1) {
              requestAnimationFrame(animate);
            }
          };
          
          requestAnimationFrame(animate);
          counterObserver.unobserve(counter);
        }
      });
    }, observerOptions);

    counters.forEach(counter => {
      counterObserver.observe(counter);
    });

    // Enhanced fade-in animations
    const fadeElements = document.querySelectorAll('.fade-in, .fade-in-up, .fade-in-up-delayed');
    const fadeObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.style.opacity = '1';
          entry.target.style.transform = 'translateY(0)';
        }
      });
    }, { threshold: 0.1 });

    fadeElements.forEach(el => {
      el.style.opacity = '0';
      el.style.transform = 'translateY(40px)';
      el.style.transition = 'opacity 0.8s ease, transform 0.8s ease';
      fadeObserver.observe(el);
    });


  });
</script>