import React, { useState } from 'react';

// Definición de líneas de pago reales para un slot 5x3
const PAYLINES = [
  // Líneas horizontales
  { id: 1, name: "Línea 1 - Horizontal Superior", path: [0, 1, 2, 3, 4], color: "bg-red-400" },
  { id: 2, name: "Línea 2 - Horizontal Centro", path: [5, 6, 7, 8, 9], color: "bg-blue-400" },
  { id: 3, name: "Línea 3 - Horizontal Inferior", path: [10, 11, 12, 13, 14], color: "bg-green-400" },
  
  // Líneas en V
  { id: 4, name: "Línea 4 - V Hacia Abajo", path: [0, 6, 12, 8, 4], color: "bg-yellow-400" },
  { id: 5, name: "Línea 5 - V Hacia Arriba", path: [10, 6, 2, 8, 14], color: "bg-purple-400" },
  
  // Líneas diagonales
  { id: 6, name: "Línea 6 - Diagonal Descendente", path: [0, 6, 12, 13, 14], color: "bg-pink-400" },
  { id: 7, name: "Línea 7 - Diagonal Ascendente", path: [10, 6, 2, 3, 4], color: "bg-indigo-400" },
  
  // Líneas zigzag
  { id: 8, name: "Línea 8 - Zigzag Superior", path: [0, 1, 7, 3, 4], color: "bg-orange-400" },
  { id: 9, name: "Línea 9 - Zigzag Inferior", path: [10, 11, 7, 13, 14], color: "bg-teal-400" },
  { id: 10, name: "Línea 10 - Zigzag Centro", path: [5, 1, 12, 8, 9], color: "bg-cyan-400" },
  
  // Líneas más complejas
  { id: 11, name: "Línea 11 - W", path: [0, 11, 2, 13, 4], color: "bg-lime-400" },
  { id: 12, name: "Línea 12 - M", path: [10, 1, 12, 3, 14], color: "bg-rose-400" },
  { id: 13, name: "Línea 13 - Lightning", path: [5, 1, 7, 13, 9], color: "bg-amber-400" },
  { id: 14, name: "Línea 14 - Crown", path: [0, 6, 2, 8, 4], color: "bg-emerald-400" },
  { id: 15, name: "Línea 15 - Valleys", path: [10, 6, 12, 8, 14], color: "bg-violet-400" },
];

// Símbolos típicos de slots
const SYMBOLS = ['🍒', '🍋', '⭐', '💎', '7️⃣', '🍇', '🔔', '💰', '🍀', '👑'];

const PaylineVisualizer: React.FC = () => {
  const [selectedLine, setSelectedLine] = useState(1);
  const [showAllLines, setShowAllLines] = useState(false);
  const [gridValues, setGridValues] = useState(() => 
    Array.from({ length: 15 }, () => SYMBOLS[Math.floor(Math.random() * SYMBOLS.length)])
  );
  
  // Generar nueva combinación de símbolos
  const generateNewSpin = () => {
    setGridValues(Array.from({ length: 15 }, () => SYMBOLS[Math.floor(Math.random() * SYMBOLS.length)]));
  };

  // Simular una combinación ganadora
  const generateWinningSpin = () => {
    const newGrid = Array.from({ length: 15 }, () => SYMBOLS[Math.floor(Math.random() * SYMBOLS.length)]);
    const currentPayline = PAYLINES.find(line => line.id === selectedLine);
    
    if (currentPayline) {
      // Poner el mismo símbolo en los primeros 3 o 4 positions de la línea seleccionada
      const winSymbol = SYMBOLS[Math.floor(Math.random() * SYMBOLS.length)];
      const winLength = Math.random() > 0.5 ? 3 : 4; // 3 o 4 símbolos iguales
      
      for (let i = 0; i < winLength; i++) {
        newGrid[currentPayline.path[i]] = winSymbol;
      }
    }
    
    setGridValues(newGrid);
  };

  const currentPayline = PAYLINES.find(line => line.id === selectedLine);
  
  // Verificar si la línea actual tiene una combinación ganadora
  const checkWinningCombination = (payline) => {
    const positions = payline.path;
    const symbols = positions.map(pos => gridValues[pos]);
    
    // Verificar al menos 3 símbolos iguales desde la izquierda
    let count = 1;
    for (let i = 1; i < symbols.length; i++) {
      if (symbols[i] === symbols[0]) {
        count++;
      } else {
        break;
      }
    }
    
    return count >= 3 ? { winning: true, symbol: symbols[0], count } : { winning: false, count: 0 };
  };

  const currentWin = currentPayline ? checkWinningCombination(currentPayline) : { winning: false, count: 0 };
  
  return (
    <div className="bg-gray-50 p-6 rounded-lg">
      <div className="text-center mb-6">
        <h3 className="text-xl font-bold text-gray-800 mb-2">
          🎰 Líneas de Pago Reales
        </h3>
        <p className="text-gray-600 text-sm">
          Explora cómo funcionan realmente los patrones de líneas de pago
        </p>
      </div>

      {/* Controles */}
      <div className="mb-4 flex flex-wrap gap-2 justify-center">
        <button
          onClick={generateNewSpin}
          className="px-3 py-2 bg-blue-500 hover:bg-blue-600 text-white rounded font-semibold transition-colors text-sm"
        >
          🎲 Nueva Tirada
        </button>
        <button
          onClick={generateWinningSpin}
          className="px-3 py-2 bg-green-500 hover:bg-green-600 text-white rounded font-semibold transition-colors text-sm"
        >
          ✨ Simular Ganancia
        </button>
        <button
          onClick={() => setShowAllLines(!showAllLines)}
          className={`px-3 py-2 rounded font-semibold transition-colors text-sm ${
            showAllLines 
              ? 'bg-red-500 hover:bg-red-600 text-white' 
              : 'bg-gray-500 hover:bg-gray-600 text-white'
          }`}
        >
          {showAllLines ? '👁️ Solo una línea' : '👀 Ver todas'}
        </button>
      </div>

      {/* Selector de línea */}
      {!showAllLines && (
        <div className="mb-4 text-center">
          <label className="block text-sm font-medium text-gray-700 mb-2">
            Línea Activa: <span className="font-bold text-blue-600">#{selectedLine}</span>
          </label>
          <input
            type="range"
            min="1"
            max="15"
            value={selectedLine}
            onChange={(e) => setSelectedLine(Number(e.target.value))}
            className="w-full max-w-sm mx-auto h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer"
          />
          <div className="flex justify-between text-xs text-gray-500 max-w-sm mx-auto mt-1">
            <span>1</span>
            <span>15</span>
          </div>
        </div>
      )}

      {/* Información de la línea actual */}
      {!showAllLines && currentPayline && (
        <div className="mb-4 text-center">
          <div className={`inline-block px-3 py-1 rounded ${currentPayline.color} text-gray-800 font-semibold text-sm`}>
            {currentPayline.name}
          </div>
          {currentWin.winning && (
            <div className="mt-2 p-2 bg-green-100 border border-green-300 rounded">
              <p className="text-green-800 font-bold text-sm">
                🎉 ¡GANANCIA! {currentWin.count} {currentWin.symbol} consecutivos
              </p>
            </div>
          )}
        </div>
      )}

      {/* Grid de la slot */}
      <div className="mb-4">
        <div className="grid grid-cols-5 gap-2 max-w-lg mx-auto bg-gray-800 p-4 rounded-lg">
          {gridValues.map((symbol, index) => {
            let cellClasses = "w-12 h-12 rounded flex items-center justify-center text-xl font-bold border-2 border-gray-600";
            
            if (showAllLines) {
              // Mostrar todas las líneas con opacidad reducida
              const linesContaining = PAYLINES.filter(line => line.path.includes(index));
              if (linesContaining.length > 0) {
                cellClasses += " bg-yellow-300 text-gray-800";
              } else {
                cellClasses += " bg-gray-200 text-gray-600";
              }
            } else if (currentPayline && currentPayline.path.includes(index)) {
              // Resaltar solo la línea actual
              cellClasses += ` ${currentPayline.color} text-gray-800`;
              if (currentWin.winning) {
                const positionInLine = currentPayline.path.indexOf(index);
                if (positionInLine < currentWin.count) {
                  cellClasses += " ring-2 ring-green-400";
                }
              }
            } else {
              cellClasses += " bg-gray-200 text-gray-600";
            }
            
            return (
              <div key={index} className={cellClasses}>
                {symbol}
              </div>
            );
          })}
        </div>
        
        {/* Etiquetas de filas */}
        <div className="flex justify-center mt-2 text-xs text-gray-500">
          <div className="flex gap-12">
            <span>Rodillo 1</span>
            <span>Rodillo 2</span>
            <span>Rodillo 3</span>
            <span>Rodillo 4</span>
            <span>Rodillo 5</span>
          </div>
        </div>
      </div>

      {/* Selector compacto de líneas */}
      <div className="mb-4">
        <h4 className="text-sm font-bold text-gray-700 mb-2 text-center">Líneas Disponibles</h4>
        <div className="flex flex-wrap justify-center gap-1">
          {PAYLINES.slice(0, 10).map((line) => (
            <button
              key={line.id}
              onClick={() => {setSelectedLine(line.id); setShowAllLines(false);}}
              className={`w-8 h-8 rounded text-xs font-bold transition-all ${line.color} ${
                selectedLine === line.id && !showAllLines 
                  ? 'ring-2 ring-gray-800 text-gray-800' 
                  : 'text-gray-700 hover:ring-2 hover:ring-gray-400'
              }`}
            >
              {line.id}
            </button>
          ))}
        </div>
        {PAYLINES.length > 10 && (
          <div className="flex flex-wrap justify-center gap-1 mt-1">
            {PAYLINES.slice(10).map((line) => (
              <button
                key={line.id}
                onClick={() => {setSelectedLine(line.id); setShowAllLines(false);}}
                className={`w-8 h-8 rounded text-xs font-bold transition-all ${line.color} ${
                  selectedLine === line.id && !showAllLines 
                    ? 'ring-2 ring-gray-800 text-gray-800' 
                    : 'text-gray-700 hover:ring-2 hover:ring-gray-400'
                }`}
              >
                {line.id}
              </button>
            ))}
          </div>
        )}
      </div>

      {/* Explicación educativa */}
      <div className="bg-blue-100 p-4 rounded border-l-4 border-blue-400">
        <h4 className="font-bold text-blue-800 mb-2 text-sm">
          💡 Puntos Clave:
        </h4>
        <div className="grid grid-cols-1 md:grid-cols-2 gap-3 text-blue-700 text-sm">
          <div>
            <ul className="space-y-1">
              <li>• Cada línea tiene un patrón <strong>fijo y específico</strong></li>
              <li>• Se necesitan al menos 3 símbolos iguales consecutivos</li>
              <li>• Los símbolos deben empezar desde el primer rodillo</li>
            </ul>
          </div>
          <div>
            <ul className="space-y-1">
              <li>• <strong>Activar más líneas NO mejora el RTP</strong></li>
              <li>• Solo aumenta tu apuesta total por tirada</li>
              <li>• Es una ilusión de "más oportunidades"</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  );
};

export default PaylineVisualizer;