---
import { type Lang, type PageKey, href, ui } from '../i18n';
interface Props {
  lang: Lang;
  page: PageKey;
}
const { lang, page } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'es' ? 'en' : 'es';
const items = ['lab', 'odds', 'market', 'games'] as const;
---

<header class="site-header">
  <div class="bar page">
    <a class="brand" href={href(lang, 'home')} aria-label={t.siteName}>
      <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true"
        ><rect width="32" height="32" rx="7" fill="currentColor"></rect><path
          d="M7 22 L13 15 L18 18 L25 9"
          fill="none"
          stroke="var(--paper)"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-linejoin="round"></path><circle cx="25" cy="23" r="2.6" fill="var(--accent)"></circle></svg
      >
      <span class="brand-name">Unmasking <em>Gambling</em></span>
    </a>

    <nav class="nav" aria-label={lang === 'es' ? 'Principal' : 'Main'}>
      <ul>
        {
          items.map((k) => (
            <li>
              <a href={href(lang, k)} aria-current={page === k ? 'page' : undefined}>
                {t.nav[k]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="tools">
      <a class="help" href={href(lang, 'help')} aria-current={page === 'help' ? 'page' : undefined}>
        <span class="dot" aria-hidden="true"></span>{t.nav.help}
      </a>
      <a class="lang" href={href(other, page)} hreflang={other} lang={other}>{other.toUpperCase()}</a>
      <button class="theme" type="button" aria-label={t.themeToggle} title={t.themeToggle} data-theme-toggle>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"
          ><circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle><path
            d="M10 2.75 A7.25 7.25 0 0 1 10 17.25 Z"
            fill="currentColor"></path></svg
        >
      </button>
    </div>
  </div>
  <nav class="nav-mobile page" aria-label={lang === 'es' ? 'Secciones' : 'Sections'}>
    {
      items.map((k) => (
        <a href={href(lang, k)} aria-current={page === k ? 'page' : undefined}>
          {t.nav[k]}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const current = root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('ug-theme', next);
    } catch (e) {}
    window.dispatchEvent(new CustomEvent('ug-theme'));
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--rule);
    font-family: var(--sans);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 60px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--ink);
    flex-shrink: 0;
  }
  .brand-name {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .brand-name em {
    font-style: italic;
    font-weight: 500;
  }
  .nav {
    margin-left: auto;
  }
  .nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a,
  .nav-mobile a {
    display: block;
    padding: 0.4rem 0.7rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
    border-radius: 4px;
  }
  .nav a:hover {
    color: var(--ink);
    background: var(--paper-2);
  }
  .nav a[aria-current='page'],
  .nav-mobile a[aria-current='page'] {
    color: var(--ink);
    box-shadow: inset 0 -2px 0 var(--accent);
    border-radius: 0;
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .help {
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    text-decoration: none;
    color: var(--ink);
  }
  .help:hover {
    border-color: var(--ink);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--series-3);
  }
  .lang,
  .theme {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--ink-2);
    text-decoration: none;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .lang:hover,
  .theme:hover {
    background: var(--paper-2);
    color: var(--ink);
  }
  .nav-mobile {
    display: none;
  }
  @media (max-width: 880px) {
    .nav {
      display: none;
    }
    .tools {
      margin-left: auto;
    }
    .nav-mobile {
      display: flex;
      gap: 0.25rem;
      overflow-x: auto;
      scrollbar-width: none;
      padding-bottom: 0.4rem;
    }
    .nav-mobile a {
      white-space: nowrap;
      font-size: 0.85rem;
    }
  }
  @media (max-width: 420px) {
    .bar {
      gap: 0.6rem;
    }
    .brand-name {
      font-size: 1rem;
    }
    .dot {
      display: none;
    }
    .help {
      padding: 0.35rem 0.6rem;
    }
  }
</style>
