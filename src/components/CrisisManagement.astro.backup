---\n// Crisis Management Component - Versión Simplificada\n---\n\n<div id=\"crisis-management-system\">\n  <!-- Botón Flotante -->\n  <div id=\"crisis-floating-button\" class=\"fixed bottom-6 right-6 z-50\">\n    <button \n      id=\"crisis-help-btn\"\n      class=\"bg-red-600 hover:bg-red-700 text-white p-4 rounded-full shadow-lg transition-all duration-300 animate-pulse\"\n      title=\"¿Necesitas ayuda inmediata?\"\n    >\n      <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-6 h-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n        <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192L5.636 18.364M12 2.25a9.75 9.75 0 11-9.75 9.75A9.75 9.75 0 0112 2.25z\" />\n      </svg>\n    </button>\n  </div>\n\n  <!-- Modal Básico -->\n  <div id=\"crisis-modal\" class=\"hidden fixed inset-0 bg-black bg-opacity-75 z-[100] flex items-center justify-center p-4\">\n    <div class=\"bg-white rounded-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto\">\n      \n      <!-- Header -->\n      <div class=\"bg-red-600 text-white p-6\">\n        <div class=\"flex items-center justify-between\">\n          <h2 class=\"text-2xl font-bold\">🆘 Ayuda Inmediata</h2>\n          <button id=\"close-crisis-modal\" class=\"text-white hover:text-gray-200 p-2\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" class=\"w-6 h-6\" fill=\"none\" viewBox=\"0 0 24 24\" stroke=\"currentColor\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M6 18L18 6M6 6l12 12\" />\n            </svg>\n          </button>\n        </div>\n      </div>\n\n      <!-- Contenido -->\n      <div class=\"p-6\">\n        <h3 class=\"text-xl font-bold text-gray-900 mb-4\">Recursos de Ayuda Inmediata</h3>\n        \n        <!-- Enlaces telefónicos -->\n        <div class=\"space-y-4 mb-6\">\n          <a href=\"tel:024\" class=\"flex items-center p-4 bg-red-100 border-2 border-red-300 rounded-lg hover:bg-red-200 transition-colors\">\n            <div class=\"flex-shrink-0 w-12 h-12 bg-red-500 rounded-full flex items-center justify-center mr-4 text-white font-bold\">\n              📞\n            </div>\n            <div>\n              <div class=\"font-bold text-red-800 text-lg\">024 - Línea de Crisis</div>\n              <div class=\"text-sm text-red-600\">Prevención del suicidio • 24h • Gratuita</div>\n            </div>\n          </a>\n          \n          <a href=\"tel:900200225\" class=\"flex items-center p-4 bg-blue-100 border-2 border-blue-300 rounded-lg hover:bg-blue-200 transition-colors\">\n            <div class=\"flex-shrink-0 w-12 h-12 bg-blue-500 rounded-full flex items-center justify-center mr-4 text-white font-bold\">\n              🎲\n            </div>\n            <div>\n              <div class=\"font-bold text-blue-800 text-lg\">900 200 225 - FEJAR</div>\n              <div class=\"text-sm text-blue-600\">Ayuda con problemas de juego • 24h</div>\n            </div>\n          </a>\n        </div>\n        \n        <!-- Botones de navegación -->\n        <div class=\"flex flex-col sm:flex-row gap-3\">\n          <button onclick=\"navigateToPath('/the-way/paso-4')\" class=\"flex-1 px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors\">\n            🧘 Técnicas de Autocontrol\n          </button>\n          <button onclick=\"navigateToPath('/ayuda')\" class=\"flex-1 px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors\">\n            📞 Más Recursos de Ayuda\n          </button>\n        </div>\n      </div>\n    </div>\n  </div>\n</div>\n\n<script define:vars={{ BASE_URL: import.meta.env.BASE_URL }}>\n// Función de navegación simplificada\nfunction navigateToPath(path) {\n  const baseUrl = BASE_URL || '';\n  const normalizedPath = path.startsWith('/') ? path : '/' + path;\n  let fullPath;\n  if (baseUrl === '/' || baseUrl === '') {\n    fullPath = normalizedPath;\n  } else {\n    fullPath = baseUrl.replace(/\\/$/, '') + normalizedPath;\n  }\n  window.location.href = fullPath;\n}\n\n// Hacer función global\nwindow.navigateToPath = navigateToPath;\n\n// Funcionalidad básica del modal\ndocument.addEventListener('DOMContentLoaded', () => {\n  const crisisBtn = document.getElementById('crisis-help-btn');\n  const crisisModal = document.getElementById('crisis-modal');\n  const closeModalBtn = document.getElementById('close-crisis-modal');\n\n  if (crisisBtn && crisisModal && closeModalBtn) {\n    crisisBtn.addEventListener('click', () => {\n      crisisModal.classList.remove('hidden');\n      document.body.style.overflow = 'hidden';\n    });\n\n    closeModalBtn.addEventListener('click', () => {\n      crisisModal.classList.add('hidden');\n      document.body.style.overflow = 'auto';\n    });\n\n    // Cerrar con Escape\n    document.addEventListener('keydown', (e) => {\n      if (e.key === 'Escape' && !crisisModal.classList.contains('hidden')) {\n        crisisModal.classList.add('hidden');\n        document.body.style.overflow = 'auto';\n      }\n    });\n\n    // Cerrar haciendo click fuera\n    crisisModal.addEventListener('click', (e) => {\n      if (e.target === crisisModal) {\n        crisisModal.classList.add('hidden');\n        document.body.style.overflow = 'auto';\n      }\n    });\n  }\n});\n</script>\n\n<style>\n#crisis-floating-button button {\n  box-shadow: 0 4px 12px rgba(220, 38, 38, 0.4);\n}\n\n#crisis-floating-button button:hover {\n  transform: scale(1.05);\n}\n\n@media (max-width: 768px) {\n  #crisis-modal .bg-white {\n    margin: 1rem;\n    max-height: calc(100vh - 2rem);\n  }\n}\n</style>