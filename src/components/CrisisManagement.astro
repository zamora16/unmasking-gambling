---
// Sistema de Gestión de Crisis - Versión corregida
import { getUrl } from '../utils/url';

// Generar las URLs correctas en build time
const autoControlUrl = getUrl('/the-way/paso-4');
const helpResourcesUrl = getUrl('/ayuda');
---

<!-- Botón de Crisis Flotante -->
<div class="fixed bottom-6 right-6 z-50">
  <button 
    id="crisis-help-btn"
    class="bg-red-600 hover:bg-red-700 text-white p-4 rounded-full shadow-lg transition-all duration-300 animate-pulse"
    title="¿Necesitas ayuda inmediata?"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192L5.636 18.364M12 2.25a9.75 9.75 0 11-9.75 9.75A9.75 9.75 0 0112 2.25z" />
    </svg>
  </button>
</div>

<!-- Modal de Crisis -->
<div id="crisis-modal" class="hidden fixed inset-0 bg-black bg-opacity-75 z-[100] flex items-center justify-center p-4">
  <div class="bg-white rounded-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto">
    
    <!-- Header -->
    <div class="bg-red-600 text-white p-6">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-bold">🆘 Ayuda Inmediata</h2>
        <button id="close-crisis-modal" class="text-white hover:text-gray-200 p-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Contenido -->
    <div class="p-6">
      <h3 class="text-xl font-bold text-gray-900 mb-4">Recursos de Ayuda</h3>
      
      <!-- Enlaces telefónicos -->
      <div class="space-y-4 mb-6">
        <a href="tel:024" class="flex items-center p-4 bg-red-100 border-2 border-red-300 rounded-lg hover:bg-red-200 transition-colors">
          <div class="flex-shrink-0 w-12 h-12 bg-red-500 rounded-full flex items-center justify-center mr-4 text-white font-bold">
            📞
          </div>
          <div>
            <div class="font-bold text-red-800 text-lg">024 - Línea de Crisis</div>
            <div class="text-sm text-red-600">Prevención del suicidio • 24h • Gratuita</div>
          </div>
        </a>
        
        <a href="tel:900200225" class="flex items-center p-4 bg-blue-100 border-2 border-blue-300 rounded-lg hover:bg-blue-200 transition-colors">
          <div class="flex-shrink-0 w-12 h-12 bg-blue-500 rounded-full flex items-center justify-center mr-4 text-white font-bold">
            🎲
          </div>
          <div>
            <div class="font-bold text-blue-800 text-lg">900 200 225 - FEJAR</div>
            <div class="text-sm text-blue-600">Ayuda con problemas de juego • 24h</div>
          </div>
        </a>
      </div>
      
      <!-- Botones de navegación -->
      <div class="flex flex-col sm:flex-row gap-3">
        <a href={autoControlUrl} class="flex-1 px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors text-center">
          🧘 Técnicas de Autocontrol
        </a>
        <a href={helpResourcesUrl} class="flex-1 px-6 py-3 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors text-center">
          📞 Más Recursos de Ayuda
        </a>
      </div>
    </div>
  </div>
</div>

<script>
// Event listeners - Solo JavaScript del cliente
document.addEventListener('DOMContentLoaded', function() {
  const crisisBtn = document.getElementById('crisis-help-btn');
  const crisisModal = document.getElementById('crisis-modal');
  const closeBtn = document.getElementById('close-crisis-modal');

  if (crisisBtn && crisisModal && closeBtn) {
    crisisBtn.addEventListener('click', function() {
      crisisModal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    });

    closeBtn.addEventListener('click', function() {
      crisisModal.classList.add('hidden');
      document.body.style.overflow = 'auto';
    });

    // Cerrar con Escape
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && !crisisModal.classList.contains('hidden')) {
        crisisModal.classList.add('hidden');
        document.body.style.overflow = 'auto';
      }
    });

    // Cerrar al hacer click fuera
    crisisModal.addEventListener('click', function(e) {
      if (e.target === crisisModal) {
        crisisModal.classList.add('hidden');
        document.body.style.overflow = 'auto';
      }
    });
  }
});
</script>

<style>
.fixed.bottom-6.right-6 button {
  box-shadow: 0 4px 12px rgba(220, 38, 38, 0.4);
}

.fixed.bottom-6.right-6 button:hover {
  transform: scale(1.05);
}

@media (max-width: 768px) {
  #crisis-modal .bg-white {
    margin: 1rem;
    max-height: calc(100vh - 2rem);
  }
}
</style>
