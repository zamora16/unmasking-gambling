---
// Componente de herramientas de autocontrol para el Paso 4
---

<section class="mb-16">
  <div class="bg-gradient-to-r from-sky-600 to-cyan-600 text-white p-8 rounded-xl">
    <h2 class="text-2xl font-bold mb-6">🧘 Herramientas de Autocontrol</h2>
    <p class="text-sky-100 mb-8">
      Práctica estas técnicas ahora mismo. Son especialmente útiles en momentos de impulso:
    </p>
    
    <!-- Technique Tabs -->
    <div class="flex flex-wrap mb-8 border-b border-white/20">
      <button 
        class="tab-button px-6 py-3 font-semibold border-b-2 border-transparent hover:border-white/50 transition-colors active"
        data-tab="breathing"
      >
        🌬️ Respiración Guiada
      </button>
      <button 
        class="tab-button px-6 py-3 font-semibold border-b-2 border-transparent hover:border-white/50 transition-colors"
        data-tab="stop-think"
      >
        ✋ Stop-Think-Act
      </button>
      <button 
        class="tab-button px-6 py-3 font-semibold border-b-2 border-transparent hover:border-white/50 transition-colors"
        data-tab="distractors"
      >
        🎯 Distractores de Urgencia
      </button>
      <button 
        class="tab-button px-6 py-3 font-semibold border-b-2 border-transparent hover:border-white/50 transition-colors"
        data-tab="plan"
      >
        📝 Plan de Acción
      </button>
    </div>

    <!-- Breathing Exercise Tab -->
    <div id="breathing-tab" class="tab-content">
      <div class="bg-white/10 p-6 rounded-lg">
        <h3 class="text-xl font-bold mb-4">🌬️ Ejercicio de Respiración 4-7-8</h3>
        <p class="text-sky-100 mb-6">
          Esta técnica ayuda a reducir la ansiedad y los impulsos en 2-3 minutos:
        </p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-4">
            <div class="text-center">
              <div id="breathing-circle" class="w-32 h-32 mx-auto rounded-full border-4 border-white/30 flex items-center justify-center transition-all duration-1000">
                <span id="breathing-text" class="text-2xl font-bold">Preparado</span>
              </div>
              <div id="breathing-phase" class="mt-4 text-lg font-semibold">Presiona para comenzar</div>
            </div>
            
            <div class="flex justify-center space-x-4">
              <button id="start-breathing" class="px-6 py-3 bg-white/20 hover:bg-white/30 rounded-lg font-semibold transition-colors">
                ▶️ Comenzar
              </button>
              <button id="stop-breathing" class="px-6 py-3 bg-red-500/70 hover:bg-red-500 rounded-lg font-semibold transition-colors hidden">
                ⏹️ Parar
              </button>
            </div>
          </div>
          
          <div class="space-y-4">
            <h4 class="font-bold">Cómo funciona:</h4>
            <div class="space-y-3 text-sm">
              <div class="flex items-start">
                <span class="w-6 h-6 bg-white/20 rounded-full flex items-center justify-center mr-3 mt-0.5 text-xs font-bold">1</span>
                <div>
                  <div class="font-semibold">Inhala por 4 segundos</div>
                  <div class="text-sky-200">Por la nariz, llenando el abdomen</div>
                </div>
              </div>
              <div class="flex items-start">
                <span class="w-6 h-6 bg-white/20 rounded-full flex items-center justify-center mr-3 mt-0.5 text-xs font-bold">2</span>
                <div>
                  <div class="font-semibold">Mantén por 7 segundos</div>
                  <div class="text-sky-200">Sin forzar, cómodamente</div>
                </div>
              </div>
              <div class="flex items-start">
                <span class="w-6 h-6 bg-white/20 rounded-full flex items-center justify-center mr-3 mt-0.5 text-xs font-bold">3</span>
                <div>
                  <div class="font-semibold">Exhala por 8 segundos</div>
                  <div class="text-sky-200">Por la boca, completamente</div>
                </div>
              </div>
            </div>
            <div class="bg-white/10 p-3 rounded">
              <div class="text-sm">
                <strong>Ciclos completados:</strong> <span id="breathing-cycles">0</span>/4
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Stop-Think-Act Tab -->
    <div id="stop-think-tab" class="tab-content hidden">
      <div class="bg-white/10 p-6 rounded-lg">
        <h3 class="text-xl font-bold mb-4">✋ Técnica Stop-Think-Act</h3>
        <p class="text-sky-100 mb-6">
          Cuando sientes el impulso de jugar, sigue estos pasos:
        </p>
        
        <div class="space-y-6">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-red-500/20 p-6 rounded-lg text-center">
              <div class="text-4xl mb-3">✋</div>
              <h4 class="text-xl font-bold mb-3">STOP</h4>
              <p class="text-sky-100">Para lo que estás haciendo. Reconoce el impulso.</p>
              <button class="mt-4 px-4 py-2 bg-red-500 hover:bg-red-600 rounded-lg transition-colors" onclick="activateStopPhase()">
                Activar STOP
              </button>
            </div>
            
            <div class="bg-yellow-500/20 p-6 rounded-lg text-center">
              <div class="text-4xl mb-3">🤔</div>
              <h4 class="text-xl font-bold mb-3">THINK</h4>
              <p class="text-sky-100">Reflexiona sobre las consecuencias y alternativas.</p>
            </div>
            
            <div class="bg-green-500/20 p-6 rounded-lg text-center">
              <div class="text-4xl mb-3">⚙️</div>
              <h4 class="text-xl font-bold mb-3">ACT</h4>
              <p class="text-sky-100">Elige una acción saludable alternativa.</p>
            </div>
          </div>
          
          <div id="stop-think-interactive" class="hidden bg-white/10 p-6 rounded-lg">
            <div id="stop-phase" class="text-center">
              <h4 class="text-xl font-bold mb-4 text-red-300">✋ STOP - Toma un momento</h4>
              <p class="mb-4">Reconoce que estás sintiendo un impulso. Esto es normal.</p>
              <div class="text-6xl mb-4 animate-pulse">✋</div>
              <button class="px-6 py-3 bg-yellow-500 hover:bg-yellow-600 text-gray-900 font-bold rounded-lg" onclick="activateThinkPhase()">
                Continuar a THINK →
              </button>
            </div>
            
            <div id="think-phase" class="hidden">
              <h4 class="text-xl font-bold mb-4 text-yellow-300">🤔 THINK - Reflexiona</h4>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                  <h5 class="font-bold mb-2 text-red-300">Si juego ahora...</h5>
                  <ul class="text-sm space-y-1 text-sky-100">
                    <li>• Probablemente perderé dinero</li>
                    <li>• Me sentiré culpable después</li>
                    <li>• No resolveré mis problemas reales</li>
                    <li>• Reforzaré el hábito</li>
                  </ul>
                </div>
                <div>
                  <h5 class="font-bold mb-2 text-green-300">Si no juego...</h5>
                  <ul class="text-sm space-y-1 text-sky-100">
                    <li>• Mantendré mi dinero</li>
                    <li>• Me sentiré orgulloso/a</li>
                    <li>• Podré hacer algo constructivo</li>
                    <li>• Fortaleceré mi autocontrol</li>
                  </ul>
                </div>
              </div>
              <div class="text-center mt-6">
                <button class="px-6 py-3 bg-green-500 hover:bg-green-600 text-white font-bold rounded-lg" onclick="activateActPhase()">
                  Continuar a ACT →
                </button>
              </div>
            </div>
            
            <div id="act-phase" class="hidden">
              <h4 class="text-xl font-bold mb-4 text-green-300">⚙️ ACT - Elige una acción</h4>
              <p class="mb-4">Selecciona una actividad alternativa:</p>
              <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <button class="p-4 bg-white/10 hover:bg-white/20 rounded-lg transition-colors" onclick="selectAction('Llamar a un amigo')">
                  <div class="text-2xl mb-2">📞</div>
                  <div class="text-sm">Llamar a un amigo</div>
                </button>
                <button class="p-4 bg-white/10 hover:bg-white/20 rounded-lg transition-colors" onclick="selectAction('Salir a caminar')">
                  <div class="text-2xl mb-2">🚶</div>
                  <div class="text-sm">Salir a caminar</div>
                </button>
                <button class="p-4 bg-white/10 hover:bg-white/20 rounded-lg transition-colors" onclick="selectAction('Hacer ejercicio')">
                  <div class="text-2xl mb-2">🏋️</div>
                  <div class="text-sm">Hacer ejercicio</div>
                </button>
                <button class="p-4 bg-white/10 hover:bg-white/20 rounded-lg transition-colors" onclick="selectAction('Leer un libro')">
                  <div class="text-2xl mb-2">📚</div>
                  <div class="text-sm">Leer un libro</div>
                </button>
              </div>
              <div id="action-selected" class="hidden mt-6 p-4 bg-green-500/20 rounded-lg text-center">
                <h5 class="font-bold mb-2">¡Excelente elección!</h5>
                <p id="selected-action"></p>
                <button class="mt-4 px-6 py-3 bg-white/20 hover:bg-white/30 rounded-lg" onclick="resetStopThink()">
                  Reiniciar ejercicio
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Distractor Tab -->
    <div id="distractors-tab" class="tab-content hidden">
      <div class="bg-white/10 p-6 rounded-lg">
        <h3 class="text-xl font-bold mb-4">🎯 Distractores de Urgencia</h3>
        <p class="text-sky-100 mb-6">
          Lista de actividades rápidas para cuando sientes un impulso fuerte:
        </p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <h4 class="font-bold mb-4">⚡ Actividades de 2 minutos</h4>
            <div class="space-y-3">
              <div class="flex items-center p-3 bg-white/10 rounded-lg hover:bg-white/20 transition-colors cursor-pointer" onclick="startDistractor('Contar hacia atrás desde 100 de 7 en 7', 120)">
                <span class="text-2xl mr-3">🔢</span>
                <div>
                  <div class="font-semibold">Contar hacia atrás</div>
                  <div class="text-sm text-sky-200">Desde 100, de 7 en 7</div>
                </div>
              </div>
              <div class="flex items-center p-3 bg-white/10 rounded-lg hover:bg-white/20 transition-colors cursor-pointer" onclick="startDistractor('Nombrar 5 cosas que ves, 4 que escuchas, 3 que tocas', 120)">
                <span class="text-2xl mr-3">👁️</span>
                <div>
                  <div class="font-semibold">Técnica 5-4-3</div>
                  <div class="text-sm text-sky-200">Conecta con tus sentidos</div>
                </div>
              </div>
              <div class="flex items-center p-3 bg-white/10 rounded-lg hover:bg-white/20 transition-colors cursor-pointer" onclick="startDistractor('Tensar y relajar cada músculo por 5 segundos', 120)">
                <span class="text-2xl mr-3">💪</span>
                <div>
                  <div class="font-semibold">Relajación muscular</div>
                  <div class="text-sm text-sky-200">Tensa y relaja</div>
                </div>
              </div>
            </div>
          </div>
          
          <div>
            <h4 class="font-bold mb-4">🕐 Actividades de 5-10 minutos</h4>
            <div class="space-y-3">
              <div class="flex items-center p-3 bg-white/10 rounded-lg hover:bg-white/20 transition-colors cursor-pointer" onclick="startDistractor('Escribir cómo te sientes sin censura', 300)">
                <span class="text-2xl mr-3">✍️</span>
                <div>
                  <div class="font-semibold">Escribir emociones</div>
                  <div class="text-sm text-sky-200">Descarga mental</div>
                </div>
              </div>
              <div class="flex items-center p-3 bg-white/10 rounded-lg hover:bg-white/20 transition-colors cursor-pointer" onclick="startDistractor('Llamar a alguien que te importe', 600)">
                <span class="text-2xl mr-3">📞</span>
                <div>
                  <div class="font-semibold">Conectar socialmente</div>
                  <div class="text-sm text-sky-200">Busca apoyo</div>
                </div>
              </div>
              <div class="flex items-center p-3 bg-white/10 rounded-lg hover:bg-white/20 transition-colors cursor-pointer" onclick="startDistractor('Hacer algo creativo con las manos', 600)">
                <span class="text-2xl mr-3">🎨</span>
                <div>
                  <div class="font-semibold">Actividad creativa</div>
                  <div class="text-sm text-sky-200">Dibujar, construir, crear</div>
                </div>
              </div>
            </div>
          </div>
        </div>
        
        <div id="distractor-timer" class="hidden mt-6 p-6 bg-white/20 rounded-lg text-center">
          <h4 class="text-xl font-bold mb-4">Actividad en curso</h4>
          <div id="distractor-activity" class="text-lg mb-4"></div>
          <div id="distractor-countdown" class="text-4xl font-bold mb-4"></div>
          <button id="distractor-complete" class="px-6 py-3 bg-green-500 hover:bg-green-600 rounded-lg font-semibold">
            ✅ Completado
          </button>
        </div>
      </div>
    </div>

    <!-- Action Plan Tab -->
    <div id="plan-tab" class="tab-content hidden">
      <div class="bg-white/10 p-6 rounded-lg">
        <h3 class="text-xl font-bold mb-4">📝 Tu Plan Personal de Autocontrol</h3>
        <p class="text-sky-100 mb-6">
          Crea un plan personalizado que puedas usar en situaciones reales:
        </p>
        
        <div class="space-y-6">
          <div>
            <label class="block font-semibold mb-2">1. ¿Cuáles son tus principales triggers (desencadenantes)?</label>
            <textarea 
              id="triggers-input" 
              class="w-full p-3 bg-white/20 border border-white/30 rounded-lg text-white placeholder-white/70 resize-none" 
              rows="3" 
              placeholder="Ej: estrés en el trabajo, aburrimiento, problemas de dinero..."
            ></textarea>
          </div>
          
          <div>
            <label class="block font-semibold mb-2">2. ¿Qué técnica te funcionó mejor hoy?</label>
            <select id="best-technique" class="w-full p-3 bg-white/20 border border-white/30 rounded-lg text-white">
              <option value="">Selecciona...</option>
              <option value="breathing">Respiración 4-7-8</option>
              <option value="stop-think-act">Stop-Think-Act</option>
              <option value="distractors">Distractores de urgencia</option>
              <option value="combination">Combinación de técnicas</option>
            </select>
          </div>
          
          <div>
            <label class="block font-semibold mb-2">3. Lista 3 actividades alternativas que disfrutas:</label>
            <div class="space-y-2">
              <input type="text" id="activity-1" class="w-full p-3 bg-white/20 border border-white/30 rounded-lg text-white placeholder-white/70" placeholder="Actividad 1">
              <input type="text" id="activity-2" class="w-full p-3 bg-white/20 border border-white/30 rounded-lg text-white placeholder-white/70" placeholder="Actividad 2">
              <input type="text" id="activity-3" class="w-full p-3 bg-white/20 border border-white/30 rounded-lg text-white placeholder-white/70" placeholder="Actividad 3">
            </div>
          </div>
          
          <div>
            <label class="block font-semibold mb-2">4. Persona de confianza a quien puedes contactar:</label>
            <input type="text" id="support-person" class="w-full p-3 bg-white/20 border border-white/30 rounded-lg text-white placeholder-white/70" placeholder="Nombre y teléfono">
          </div>
          
          <div class="flex justify-center">
            <button id="save-plan" class="px-8 py-3 bg-green-500 hover:bg-green-600 text-white font-bold rounded-lg transition-colors">
              💾 Guardar Mi Plan
            </button>
          </div>
          
          <div id="plan-saved" class="hidden p-4 bg-green-500/20 rounded-lg text-center">
            <h4 class="font-bold mb-2">✅ Plan guardado exitosamente</h4>
            <p class="text-sky-100 mb-4">Tu plan está guardado localmente en tu dispositivo</p>
            <button id="download-plan" class="px-6 py-3 bg-white/20 hover:bg-white/30 rounded-lg transition-colors">
              📎 Descargar como PDF
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
// Self-Control Tools functionality
document.addEventListener('DOMContentLoaded', () => {
  // Tab switching
  const tabButtons = document.querySelectorAll('.tab-button');
  const tabContents = document.querySelectorAll('.tab-content');
  
  tabButtons.forEach(button => {
    button.addEventListener('click', () => {
      const tabId = button.getAttribute('data-tab');
      
      // Update button states
      tabButtons.forEach(b => b.classList.remove('active', 'border-white'));
      button.classList.add('active', 'border-white');
      
      // Update content visibility
      tabContents.forEach(content => content.classList.add('hidden'));
      document.getElementById(tabId + '-tab').classList.remove('hidden');
    });
  });
  
  // Breathing exercise
  let breathingTimer;
  let breathingCycle = 0;
  let totalCycles = 0;
  
  const startBreathing = document.getElementById('start-breathing');
  const stopBreathing = document.getElementById('stop-breathing');
  const breathingCircle = document.getElementById('breathing-circle');
  const breathingText = document.getElementById('breathing-text');
  const breathingPhase = document.getElementById('breathing-phase');
  const breathingCycles = document.getElementById('breathing-cycles');
  
  function updateBreathingUI(phase, seconds, isActive = false) {
    breathingText.textContent = seconds;
    breathingPhase.textContent = phase;
    
    if (isActive) {
      breathingCircle.classList.add('scale-110', 'border-yellow-400');
    } else {
      breathingCircle.classList.remove('scale-110', 'border-yellow-400');
    }
  }
  
  function breathingSequence() {
    let phase = 0; // 0: inhale, 1: hold, 2: exhale
    let seconds = phase === 0 ? 4 : phase === 1 ? 7 : 8;
    let currentSecond = seconds;
    
    const phases = ['Inhala profundamente', 'Mantén la respiración', 'Exhala lentamente'];
    
    updateBreathingUI(phases[phase], currentSecond, phase === 0 || phase === 2);
    
    breathingTimer = setInterval(() => {
      currentSecond--;
      
      if (currentSecond > 0) {
        updateBreathingUI(phases[phase], currentSecond, phase === 0 || phase === 2);
      } else {
        phase++;
        
        if (phase < 3) {
          seconds = phase === 0 ? 4 : phase === 1 ? 7 : 8;
          currentSecond = seconds;
          updateBreathingUI(phases[phase], currentSecond, phase === 0 || phase === 2);
        } else {
          // Cycle complete
          totalCycles++;
          breathingCycles.textContent = totalCycles;
          
          if (totalCycles < 4) {
            // Start next cycle
            setTimeout(() => {
              if (breathingTimer) breathingSequence();
            }, 1000);
          } else {
            // Exercise complete
            updateBreathingUI('¡Ejercicio completado!', '✅', false);
            stopBreathingExercise();
            alert('¡Felicitaciones! Has completado el ejercicio de respiración. ¿Cómo te sientes?');
          }
        }
      }
    }, 1000);
  }
  
  function stopBreathingExercise() {
    if (breathingTimer) {
      clearInterval(breathingTimer);
      breathingTimer = null;
    }
    startBreathing.classList.remove('hidden');
    stopBreathing.classList.add('hidden');
    updateBreathingUI('Preparado', 'Presiona para comenzar', false);
  }
  
  startBreathing.addEventListener('click', () => {
    totalCycles = 0;
    breathingCycles.textContent = '0';
    startBreathing.classList.add('hidden');
    stopBreathing.classList.remove('hidden');
    breathingSequence();
  });
  
  stopBreathing.addEventListener('click', stopBreathingExercise);
  
  // Distractor timer
  let distractorTimer;
  
  window.startDistractor = function(activity, duration) {
    document.getElementById('distractor-activity').textContent = activity;
    document.getElementById('distractor-timer').classList.remove('hidden');
    
    let remaining = duration;
    
    function updateTimer() {
      const minutes = Math.floor(remaining / 60);
      const seconds = remaining % 60;
      document.getElementById('distractor-countdown').textContent = 
        `${minutes}:${seconds.toString().padStart(2, '0')}`;
      
      if (remaining > 0) {
        remaining--;
      } else {
        clearInterval(distractorTimer);
        document.getElementById('distractor-countdown').textContent = '¡Tiempo!';
      }
    }
    
    updateTimer();
    distractorTimer = setInterval(updateTimer, 1000);
  };
  
  document.getElementById('distractor-complete').addEventListener('click', () => {
    if (distractorTimer) clearInterval(distractorTimer);
    document.getElementById('distractor-timer').classList.add('hidden');
    alert('¡Excelente! Has usado una técnica de autocontrol efectiva.');
  });
  
  // Stop-Think-Act functionality
  window.activateStopPhase = function() {
    document.getElementById('stop-think-interactive').classList.remove('hidden');
    document.getElementById('stop-phase').classList.remove('hidden');
    document.getElementById('think-phase').classList.add('hidden');
    document.getElementById('act-phase').classList.add('hidden');
  };
  
  window.activateThinkPhase = function() {
    document.getElementById('stop-phase').classList.add('hidden');
    document.getElementById('think-phase').classList.remove('hidden');
  };
  
  window.activateActPhase = function() {
    document.getElementById('think-phase').classList.add('hidden');
    document.getElementById('act-phase').classList.remove('hidden');
  };
  
  window.selectAction = function(action) {
    document.getElementById('selected-action').textContent = `Has elegido: ${action}`;
    document.getElementById('action-selected').classList.remove('hidden');
  };
  
  window.resetStopThink = function() {
    document.getElementById('stop-think-interactive').classList.add('hidden');
    document.getElementById('action-selected').classList.add('hidden');
  };
  
  // Action plan saving
  document.getElementById('save-plan').addEventListener('click', () => {
    const plan = {
      triggers: document.getElementById('triggers-input').value,
      bestTechnique: document.getElementById('best-technique').value,
      activities: [
        document.getElementById('activity-1').value,
        document.getElementById('activity-2').value,
        document.getElementById('activity-3').value
      ],
      supportPerson: document.getElementById('support-person').value,
      createdAt: new Date().toISOString()
    };
    
    // Save to localStorage
    localStorage.setItem('self-control-plan', JSON.stringify(plan));
    
    // Save to progress manager
    if (window.progressManager) {
      window.progressManager.savePersonalPlan('paso-4', plan);
    }
    
    document.getElementById('plan-saved').classList.remove('hidden');
  });
  
  // Load existing plan
  const existingPlan = localStorage.getItem('self-control-plan');
  if (existingPlan) {
    const plan = JSON.parse(existingPlan);
    document.getElementById('triggers-input').value = plan.triggers || '';
    document.getElementById('best-technique').value = plan.bestTechnique || '';
    document.getElementById('activity-1').value = plan.activities[0] || '';
    document.getElementById('activity-2').value = plan.activities[1] || '';
    document.getElementById('activity-3').value = plan.activities[2] || '';
    document.getElementById('support-person').value = plan.supportPerson || '';
  }
});
</script>

<style>
.tab-button.active {
  border-bottom-color: white;
}

#breathing-circle {
  transition: all 1s ease-in-out;
}

.tab-content {
  animation: fadeIn 0.3s ease-in-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10px); }
  to { opacity: 1; transform: translateY(0); }
}
</style>
